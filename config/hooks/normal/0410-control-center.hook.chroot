#!/bin/sh
# Jaime0 Control Center: permisos del servicio, sus clientes y la interfaz. El servicio lo
# arranca la sesion de Hyprland (hyprland.lua); no hace falta habilitarlo.
set -e

chmod 755 /usr/local/bin/jaime0-servicio /usr/local/bin/jaime0-salud /usr/local/bin/jaime0-control /usr/local/bin/jaime0-perfil /usr/local/bin/modo-noche /usr/local/bin/jaime0-privacidad /usr/local/bin/jaime0-reglas
chmod 644 /usr/lib/systemd/user/jaime0-servicio.service

# Ayudante de solo lectura que pkexec ejecuta como root (reglas de UFW): de root y sin
# escritura para nadie mas, o un usuario podria cambiar lo que se ejecuta con privilegios.
chown root:root /usr/local/libexec/jaime0-ufw-estado /usr/share/polkit-1/actions/es.jaime0.ufw-estado.policy
chmod 755 /usr/local/libexec/jaime0-ufw-estado
chmod 644 /usr/share/polkit-1/actions/es.jaime0.ufw-estado.policy
command -v pkexec >/dev/null
chmod 755 /usr/share/jaime0/control
chmod 644 /usr/share/jaime0/control/*.qml
