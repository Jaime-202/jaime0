#!/bin/sh
# Jaime0 Control Center: permisos del servicio, sus clientes y la interfaz. El servicio lo
# arranca la sesion de Hyprland (hyprland.lua); no hace falta habilitarlo.
set -e

chmod 755 /usr/local/bin/jaime0-servicio /usr/local/bin/jaime0-salud /usr/local/bin/jaime0-control
chmod 644 /usr/lib/systemd/user/jaime0-servicio.service
chmod 755 /usr/share/jaime0/control
chmod 644 /usr/share/jaime0/control/*.qml
