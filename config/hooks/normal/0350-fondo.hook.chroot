#!/bin/sh
# Fondo de ZYRON: jaime0.png, propio, generado con scripts/generar-fondo.py (Python y Pillow,
# semilla fija) y guardado en el repositorio. Llega por includes.chroot_after_packages: la
# compilacion ya no descarga ni instala nada para el fondo.
set -e

DESTINO=/usr/share/backgrounds/jaime0

test -s "${DESTINO}/jaime0.png"
test -s "${DESTINO}/CREDITOS.txt"

# Restos de versiones anteriores si se reutiliza un chroot ya construido: el fondo
# descargado (aurora) y el generador antiguo que vivia en /usr/local/share/hypr.
rm -f "${DESTINO}/aurora.jpg"
rm -rf /usr/local/share/hypr

chmod 755 "${DESTINO}"
chmod 644 "${DESTINO}/jaime0.png" "${DESTINO}/CREDITOS.txt"
