#!/bin/sh
# Arranque de ZYRON con Plymouth.
#  - zyron: la animacion de activacion del nucleo (plugin script). Sus capas PNG se generan
#    aqui desde capas/*.svg, para que el tema sea vectorial en el repositorio y nitido.
#  - jaime0: el tema sencillo de siempre (negro, basado en spinner), que se conserva por si
#    se quiere volver a el: sudo plymouth-set-default-theme -R jaime0
# El de ZYRON queda por defecto. Sin "splash" en la linea del nucleo (modo seguro de GRUB)
# o con plymouth.enable=0 no se muestra ninguno; Esc enseña los mensajes de arranque.
set -e

# -- Tema sencillo (alternativa) -------------------------------------------------------
ORIGEN="/usr/share/plymouth/themes/spinner"
TEMA="jaime0"
DESTINO="/usr/share/plymouth/themes/${TEMA}"

rm -rf "${DESTINO}"
cp -a "${ORIGEN}" "${DESTINO}"
mv "${DESTINO}/spinner.plymouth" "${DESTINO}/${TEMA}.plymouth"

sed -i \
    -e '/^Name\[/d' \
    -e 's|^Name=.*|Name=ZYRON (sencillo)|' \
    -e 's|^Description=.*|Description=Arranque negro.|' \
    -e 's|^Font=.*|Font=Noto Sans 12|' \
    -e 's|^TitleFont=.*|TitleFont=Noto Sans 30|' \
    -e "s|^ImageDir=.*|ImageDir=${DESTINO}|" \
    -e 's|^BackgroundStartColor=.*|BackgroundStartColor=0x080b0d|' \
    -e 's|^BackgroundEndColor=.*|BackgroundEndColor=0x080b0d|' \
    -e 's|^ProgressBarBackgroundColor=.*|ProgressBarBackgroundColor=0x151c21|' \
    -e 's|^ProgressBarForegroundColor=.*|ProgressBarForegroundColor=0x54e58a|' \
    "${DESTINO}/${TEMA}.plymouth"

# -- Tema de ZYRON -----------------------------------------------------------------------
# rsvg-convert se instala solo para esto; 0395-marca lo vuelve a usar y lo desinstala.
ZYRON=/usr/share/plymouth/themes/zyron
apt-get -y -qq --no-install-recommends install librsvg2-bin
for SVG in "${ZYRON}"/capas/*.svg; do
    rsvg-convert "${SVG}" -o "${ZYRON}/$(basename "${SVG}" .svg).png"
done
for CAPA in halo hexagono z nucleo onda anillo escaneo marca esquina-si esquina-sd esquina-ii esquina-id \
            caja barra-fondo barra cabeza; do
    [ -s "${ZYRON}/${CAPA}.png" ] || { echo "falta la capa ${CAPA}.png del tema de ZYRON" >&2; exit 1; }
done

plymouth-set-default-theme zyron
update-initramfs -u
