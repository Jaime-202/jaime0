#!/bin/sh
# Plymouth negro y sobrio (#080b0d), basado en el tema spinner.
set -e

ORIGEN="/usr/share/plymouth/themes/spinner"
TEMA="jaime0"
DESTINO="/usr/share/plymouth/themes/${TEMA}"

rm -rf "${DESTINO}"
cp -a "${ORIGEN}" "${DESTINO}"
mv "${DESTINO}/spinner.plymouth" "${DESTINO}/${TEMA}.plymouth"

sed -i \
    -e '/^Name\[/d' \
    -e 's|^Name=.*|Name=Jaime0|' \
    -e 's|^Description=.*|Description=Arranque negro.|' \
    -e 's|^Font=.*|Font=Noto Sans 12|' \
    -e 's|^TitleFont=.*|TitleFont=Noto Sans 30|' \
    -e "s|^ImageDir=.*|ImageDir=${DESTINO}|" \
    -e 's|^BackgroundStartColor=.*|BackgroundStartColor=0x080b0d|' \
    -e 's|^BackgroundEndColor=.*|BackgroundEndColor=0x080b0d|' \
    -e 's|^ProgressBarBackgroundColor=.*|ProgressBarBackgroundColor=0x151c21|' \
    -e 's|^ProgressBarForegroundColor=.*|ProgressBarForegroundColor=0x54e58a|' \
    "${DESTINO}/${TEMA}.plymouth"

plymouth-set-default-theme "${TEMA}"
update-initramfs -u
