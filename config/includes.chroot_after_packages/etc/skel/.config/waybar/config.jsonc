// ~/.config/waybar/config.jsonc
// Barra fina y continua: escritorios a la izquierda, aplicaciones ancladas en el centro y
// estado y hora a la derecha.
// Sin titulo de ventana ni reproductor: la barra solo muestra lo que se consulta de un vistazo.
// Los intervalos son largos a proposito; lo que cambia por eventos (escritorios, volumen,
// campana) no se sondea.
// La altura ("height") y la posicion ("position") salen de jaime0-ajustes, que las escribe
// en ~/.config/jaime0/generado/waybar.json. Lo que pongas aqui tiene prioridad sobre ellas.
{
    "include": ["~/.config/jaime0/generado/waybar.json"],
    "layer": "top",
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "margin-bottom": 0,
    "spacing": 0,
    "exclusive": true,
    "fixed-center": true,

    "modules-left": ["custom/logo", "hyprland/workspaces"],
    "modules-center": ["custom/ancla-1", "custom/ancla-2", "custom/ancla-3", "custom/ancla-4", "custom/ancla-5", "custom/ancla-6"],
    "modules-right": ["cpu", "memory", "pulseaudio", "network", "bluetooth", "custom/jaime0", "battery", "custom/actualizaciones", "custom/notificaciones", "group/bandeja", "clock", "custom/power"],

    "custom/logo": {
        "format": "",
        "tooltip": true,
        "tooltip-format": "Jaime0 · SUPER + F1: atajos",
        "on-click": "rofi -show drun",
        "on-click-right": "atajos --rofi"
    },

    // Activo en verde, ocupados en gris claro y vacios en gris (style.css).
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active": "",
            "empty": "",
            "default": ""
        },
        "persistent-workspaces": {
            "*": 5
        },
        "on-click": "activate",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
        "sort-by-number": true,
        "show-special": false
    },

    // Aplicaciones ancladas (jaime0-anclar): hasta 6. Clic: enfoca su ventana o la inicia.
    // Un hueco sin aplicacion no se muestra. No se sondea: "jaime0-anclar vigilar" escucha
    // los eventos de Hyprland, escribe cada estado y avisa con la senal 9.
    "custom/ancla-1": {
        "exec": "cat \"$XDG_RUNTIME_DIR/jaime0/anclas/1.json\" 2>/dev/null",
        "return-type": "json",
        "interval": "once",
        "signal": 9,
        "on-click": "jaime0-anclar abrir 1"
    },
    "custom/ancla-2": {
        "exec": "cat \"$XDG_RUNTIME_DIR/jaime0/anclas/2.json\" 2>/dev/null",
        "return-type": "json",
        "interval": "once",
        "signal": 9,
        "on-click": "jaime0-anclar abrir 2"
    },
    "custom/ancla-3": {
        "exec": "cat \"$XDG_RUNTIME_DIR/jaime0/anclas/3.json\" 2>/dev/null",
        "return-type": "json",
        "interval": "once",
        "signal": 9,
        "on-click": "jaime0-anclar abrir 3"
    },
    "custom/ancla-4": {
        "exec": "cat \"$XDG_RUNTIME_DIR/jaime0/anclas/4.json\" 2>/dev/null",
        "return-type": "json",
        "interval": "once",
        "signal": 9,
        "on-click": "jaime0-anclar abrir 4"
    },
    "custom/ancla-5": {
        "exec": "cat \"$XDG_RUNTIME_DIR/jaime0/anclas/5.json\" 2>/dev/null",
        "return-type": "json",
        "interval": "once",
        "signal": 9,
        "on-click": "jaime0-anclar abrir 5"
    },
    "custom/ancla-6": {
        "exec": "cat \"$XDG_RUNTIME_DIR/jaime0/anclas/6.json\" 2>/dev/null",
        "return-type": "json",
        "interval": "once",
        "signal": 9,
        "on-click": "jaime0-anclar abrir 6"
    },

    "cpu": {
        "interval": 10,
        "format": " {usage}%",
        "tooltip": false,
        "on-click": "abrir-btop"
    },

    "memory": {
        "interval": 15,
        "format": " {percentage}%",
        "tooltip-format": "RAM: {used:0.1f} / {total:0.1f} GB\nSwap: {swapUsed:0.1f} / {swapTotal:0.1f} GB",
        "on-click": "abrir-btop"
    },

    "pulseaudio": {
        "scroll-step": 5,
        "format": "{icon} {volume}%",
        "format-bluetooth": " {volume}%",
        "format-muted": " mudo",
        "format-icons": {
            "default": ["", "", ""]
        },
        "tooltip-format": "{desc}",
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    // Cable: "ETH"; Wi-Fi: nombre de la red; sin conexion: aviso en rojo (style.css).
    "network": {
        "interval": 10,
        "format-wifi": " {essid}",
        "format-ethernet": " ETH",
        "format-linked": " sin IP",
        "format-disconnected": " sin red",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}/{cidr}",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}/{cidr}",
        "tooltip-format-disconnected": "Sin conexión",
        "max-length": 24,
        "on-click": "kitty --class nmtui-flotante -e nmtui"
    },

    // Sin adaptador no se muestra nada; apagado o encendido, solo el icono en gris.
    "bluetooth": {
        "format": "",
        "format-disabled": " off",
        "format-off": " off",
        "format-connected": " {num_connections}",
        "format-no-controller": "",
        "tooltip-format": "{controller_alias}: {status}",
        "tooltip-format-connected": "{controller_alias}\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "on-click": "blueman-manager"
    },

    // Jaime0: perfil activo y estado global (SYSTEM ONLINE / WARNING / CRITICAL) que publica
    // jaime0-servicio. Sin sondeo: el servicio avisa con la senal 11 cuando algo cambia.
    // Si el servicio esta parado muestra el perfil de power-profiles-daemon. Clic: Control Center.
    "custom/jaime0": {
        "exec": "jaime0-salud barra",
        "return-type": "json",
        "interval": "once",
        "signal": 11,
        "tooltip": true,
        "on-click": "jaime0-control"
    },

    "battery": {
        "interval": 60,
        "states": {
            "aviso": 25,
            "critico": 12
        },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "{timeTo}"
    },

    // Sin segundos: se redibuja una vez por minuto.
    "clock": {
        "interval": 60,
        "format": " {:%d/%m  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#d8e2e8'><b>{}</b></span>",
                "days": "<span color='#a7b4bc'>{}</span>",
                "weekdays": "<span color='#71818c'>{}</span>",
                "today": "<span color='#080b0d' background='#54e58a'><b>{}</b></span>"
            }
        },
        "actions": {
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    // Aviso de actualizaciones de seguridad de Debian: solo aparece si las hay. No consulta
    // la red: lo actualiza el temporizador diario (actualizaciones comprobar) con la senal 10.
    "custom/actualizaciones": {
        "exec": "actualizaciones barra",
        "return-type": "json",
        "interval": "once",
        "signal": 10,
        "on-click": "kitty --class actualizaciones -e sh -c 'actualizaciones; echo; echo Pulsa Intro para cerrar.; read -r _'"
    },

    // Campana del centro de notificaciones (swaync). Clic: abre el centro; clic derecho:
    // modo no molestar. No se sondea: "notificaciones barra" escribe una linea en cada cambio.
    "custom/notificaciones": {
        "exec": "notificaciones barra",
        "return-type": "json",
        "format": "{icon}",
        "format-icons": {
            "notification": "󰂚",
            "none": "󰂜",
            "dnd-notification": "󰂛",
            "dnd-none": "󰂛",
            "inhibited-notification": "󰂚",
            "inhibited-none": "󰂜",
            "dnd-inhibited-notification": "󰂛",
            "dnd-inhibited-none": "󰂛"
        },
        "escape": true,
        "on-click": "notificaciones panel",
        "on-click-right": "notificaciones nomolestar"
    },

    // La bandeja queda recogida: se despliega al pasar el raton por la flecha.
    "group/bandeja": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 200,
            "children-class": "bandeja-hija",
            "transition-left-to-right": false
        },
        "modules": ["custom/bandeja", "tray"]
    },

    "custom/bandeja": {
        "format": "",
        "tooltip": true,
        "tooltip-format": "Bandeja del sistema"
    },

    "tray": {
        "icon-size": 14,
        "spacing": 8,
        "show-passive-items": true
    },

    "custom/power": {
        "format": "",
        "tooltip": true,
        "tooltip-format": "Apagar, reiniciar, suspender o cerrar sesión",
        "on-click": "menu-energia"
    }
}
