# Tema jaime0 para btop: fondo transparente, cajas con borde gris fino y graficos que
# pasan de gris a verde; el rojo solo aparece cuando algo va al limite (temperatura, CPU).
theme[main_bg]=""
theme[main_fg]="#d8e2e8"
theme[title]="#d8e2e8"
theme[hi_fg]="#54e58a"
theme[selected_bg]="#26343a"
theme[selected_fg]="#eef4f7"
theme[inactive_fg]="#45545c"
theme[graph_text]="#a7b4bc"
theme[meter_bg]="#151c21"
theme[proc_misc]="#54e58a"

# Bordes de cada caja
theme[cpu_box]="#26343a"
theme[mem_box]="#26343a"
theme[net_box]="#26343a"
theme[proc_box]="#26343a"
theme[div_line]="#26343a"

# Temperatura
theme[temp_start]="#54e58a"
theme[temp_mid]="#d9a54a"
theme[temp_end]="#d9625b"

# CPU
theme[cpu_start]="#71818c"
theme[cpu_mid]="#54e58a"
theme[cpu_end]="#d9625b"

# Memoria y discos
theme[free_start]="#45545c"
theme[free_mid]="#71818c"
theme[free_end]="#a7b4bc"
theme[cached_start]="#45545c"
theme[cached_mid]="#71818c"
theme[cached_end]="#a7b4bc"
theme[available_start]="#71818c"
theme[available_mid]="#a7b4bc"
theme[available_end]="#d8e2e8"
theme[used_start]="#71818c"
theme[used_mid]="#54e58a"
theme[used_end]="#54e58a"

# Red: bajada en verde y subida en cian
theme[download_start]="#26343a"
theme[download_mid]="#54e58a"
theme[download_end]="#54e58a"
theme[upload_start]="#26343a"
theme[upload_mid]="#55cde0"
theme[upload_end]="#55cde0"

# Procesos
theme[process_start]="#71818c"
theme[process_mid]="#54e58a"
theme[process_end]="#54e58a"
