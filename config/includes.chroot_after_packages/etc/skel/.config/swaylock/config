# ~/.config/swaylock/config: pantalla de bloqueo de ZYRON (paleta jaime0).
# Anillo fino en gris; se ilumina en verde al escribir y en rojo si la clave falla.
image=/usr/share/backgrounds/jaime0/jaime0.png
scaling=fill
color=080b0d
font=JetBrainsMono Nerd Font
font-size=16
indicator-radius=80
indicator-thickness=4
show-failed-attempts
indicator-idle-visible
ignore-empty-password
disable-caps-lock-text

inside-color=080b0de6
inside-clear-color=080b0de6
inside-ver-color=080b0de6
inside-wrong-color=080b0de6
ring-color=26343aff
ring-clear-color=71818cff
ring-ver-color=54e58aff
ring-wrong-color=d9625bff
line-color=00000000
line-clear-color=00000000
line-ver-color=00000000
line-wrong-color=00000000
separator-color=00000000
key-hl-color=54e58aff
bs-hl-color=71818cff
text-color=d8e2e8ff
text-clear-color=a7b4bcff
text-ver-color=54e58aff
text-wrong-color=d9625bff
text-caps-lock-color=d9a54aff
layout-bg-color=080b0de6
layout-border-color=00000000
layout-text-color=d8e2e8ff
