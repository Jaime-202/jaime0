/* ~/.config/rofi/jaime0.rasi
   Lanzador centrado: fondo negro casi opaco, borde fino gris, buscador sobrio y
   seleccion discreta con el texto en verde. El blur (minimo) lo aplica Hyprland. */

* {
    fondo:        #080b0df0;
    superficie:   #151c21;
    borde:        #26343a;
    texto:        #d8e2e8;
    tenue:        #71818c;
    verde:        #54e58a;
    rojo:         #d9625b;
    transparente: #00000000;

    background-color: @transparente;
    text-color:       @texto;
}

window {
    location:         center;
    anchor:           center;
    width:            620px;
    border:           1px;
    border-color:     @borde;
    border-radius:    8px;
    background-color: @fondo;
}

mainbox {
    spacing:  10px;
    padding:  16px;
    children: [ inputbar, message, listview ];
}

inputbar {
    spacing:          10px;
    padding:          8px 14px;
    border-radius:    6px;
    background-color: @superficie;
    children:         [ prompt, entry ];
}

prompt {
    text-color: @verde;
}

entry {
    placeholder:       "buscar…";
    placeholder-color: @tenue;
    cursor:            text;
}

message {
    padding:          8px;
    border-radius:    6px;
    background-color: @superficie;
}

textbox {
    text-color: @texto;
}

listview {
    lines:        8;
    columns:      1;
    spacing:      4px;
    fixed-height: true;
    scrollbar:    false;
    cycle:        true;
}

element {
    spacing:       12px;
    padding:       6px 12px;
    border-radius: 6px;
    border:        0 0 0 2px;
    border-color:  @transparente;
}

element-icon {
    size:             20px;
    background-color: @transparente;
}

element-text {
    background-color: @transparente;
    text-color:       inherit;
    vertical-align:   0.5;
}

element selected.normal,
element selected.active,
element selected.urgent {
    background-color: @superficie;
    border-color:     @verde;
    text-color:       @verde;
}

element normal.active,
element alternate.active {
    text-color: @verde;
}

element normal.urgent,
element alternate.urgent {
    text-color: @rojo;
}
