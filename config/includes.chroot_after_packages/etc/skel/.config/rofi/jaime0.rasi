/* ~/.config/rofi/jaime0.rasi
   Lanzador centrado: fondo oscuro translucido, borde azul, buscador en pildora y
   seleccion en azul. El blur lo aplica Hyprland. */

* {
    fondo:        #12141de6;
    superficie:   #252939;
    texto:        #e0e4f2;
    tenue:        #7a819e;
    azul:         #7ab0ff;
    oscuro:       #12141d;
    transparente: #00000000;

    background-color: @transparente;
    text-color:       @texto;
}

window {
    location:         center;
    anchor:           center;
    width:            620px;
    border:           2px;
    border-color:     @azul;
    border-radius:    12px;
    background-color: @fondo;
}

mainbox {
    spacing:  10px;
    padding:  16px;
    children: [ inputbar, message, listview ];
}

inputbar {
    spacing:          10px;
    padding:          8px 14px;
    border-radius:    10px;
    background-color: @superficie;
    children:         [ prompt, entry ];
}

prompt {
    text-color: @azul;
}

entry {
    placeholder:       "buscar…";
    placeholder-color: @tenue;
    cursor:            text;
}

message {
    padding:          8px;
    border-radius:    10px;
    background-color: @superficie;
}

textbox {
    text-color: @texto;
}

listview {
    lines:        8;
    columns:      1;
    spacing:      4px;
    fixed-height: true;
    scrollbar:    false;
    cycle:        true;
}

element {
    spacing:       12px;
    padding:       6px 12px;
    border-radius: 8px;
}

element-icon {
    size:             20px;
    background-color: @transparente;
}

element-text {
    background-color: @transparente;
    text-color:       inherit;
    vertical-align:   0.5;
}

element selected.normal,
element selected.active,
element selected.urgent {
    background-color: @azul;
    text-color:       @oscuro;
}

element normal.active,
element alternate.active {
    text-color: @azul;
}

element normal.urgent,
element alternate.urgent {
    text-color: #c96a78;
}
