// ~/.config/fastfetch/config.jsonc
// Marca Jaime0 (J0) en color a la izquierda y datos agrupados en arbol: OS, WM y PC.
// Los colores son los ANSI de la terminal, que en Kitty siguen la paleta jaime0:
// 35 rosa, 95 malva, 36 cian, 32 verde, 33 amarillo, 34 azul.
{
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/logo.txt",
        "color": {
            "1": "35",
            "2": "36"
        },
        "padding": {
            "top": 1,
            "left": 1,
            "right": 3
        }
    },
    "display": {
        "separator": " → ",
        "color": {
            "keys": "35",
            "title": "95",
            "output": "97"
        },
        "key": {
            "width": 8
        }
    },
    "modules": [
        { "type": "title", "format": " {user-name}@{host-name}" },
        "break",
        { "type": "os", "key": "OS", "keyColor": "35", "format": "{pretty-name} {arch}" },
        { "type": "kernel", "key": "│ ├", "keyColor": "35", "format": "{release}" },
        { "type": "packages", "key": "│ ├", "keyColor": "35", "format": "{all}" },
        { "type": "uptime", "key": "│ └", "keyColor": "35" },
        "break",
        { "type": "wm", "key": "WM", "keyColor": "32", "format": "{pretty-name} {version}" },
        { "type": "terminal", "key": "│ ├", "keyColor": "32", "format": "{pretty-name} {version}" },
        { "type": "shell", "key": "│ ├", "keyColor": "32", "format": "{pretty-name} {version}" },
        { "type": "terminalfont", "key": "│ └", "keyColor": "32", "format": "{name} {size}pt" },
        "break",
        { "type": "host", "key": "PC", "keyColor": "33", "format": "{name}" },
        { "type": "cpu", "key": "│ ├", "keyColor": "33", "format": "{name} ({cores-logical})" },
        { "type": "gpu", "key": "│ ├", "keyColor": "33", "format": "{name}" },
        { "type": "memory", "key": "│ ├", "keyColor": "33" },
        { "type": "disk", "key": "│ ├", "keyColor": "33", "folders": "/" },
        { "type": "display", "key": "│ └", "keyColor": "33", "format": "{width}x{height} @ {refresh-rate} Hz" },
        "break",
        { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
    ]
}
