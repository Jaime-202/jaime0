// ~/.config/fastfetch/config.jsonc
// Simbolo de ZYRON como imagen (kitty la dibuja nitida; fastfetch solo se abre en kitty, ver
// ~/.zshrc) a la izquierda y datos agrupados en arbol: OS, WM y PC.
// Los colores son los ANSI de la terminal, que en Kitty siguen la paleta del sistema:
// 32 verde (titulo y grupos), 37 gris claro, 90 gris y 36 cian.
{
    "logo": {
        "type": "kitty-direct",
        "source": "/usr/local/share/marca/zyron-simbolo.png",
        "width": 16,
        "height": 8,
        "padding": {
            "top": 1,
            "left": 2,
            "right": 2
        }
    },
    "display": {
        "separator": " → ",
        "color": {
            "keys": "90",
            "title": "32",
            "output": "37"
        },
        "key": {
            "width": 8
        }
    },
    "modules": [
        { "type": "title", "format": " {user-name}@{host-name}" },
        "break",
        { "type": "os", "key": "OS", "keyColor": "32", "format": "{name} {version-id}" },
        { "type": "kernel", "key": "│ ├", "keyColor": "90", "format": "{release}" },
        { "type": "packages", "key": "│ ├", "keyColor": "90", "format": "{all}" },
        { "type": "uptime", "key": "│ └", "keyColor": "90" },
        "break",
        { "type": "wm", "key": "WM", "keyColor": "32", "format": "{pretty-name} {version}" },
        { "type": "terminal", "key": "│ ├", "keyColor": "90", "format": "{pretty-name} {version}" },
        { "type": "shell", "key": "│ ├", "keyColor": "90", "format": "{pretty-name} {version}" },
        { "type": "terminalfont", "key": "│ └", "keyColor": "90", "format": "{name}" },
        "break",
        { "type": "host", "key": "PC", "keyColor": "32", "format": "{name}" },
        { "type": "cpu", "key": "│ ├", "keyColor": "90", "format": "{name} ({cores-logical})" },
        { "type": "gpu", "key": "│ ├", "keyColor": "90", "format": "{name}" },
        { "type": "memory", "key": "│ ├", "keyColor": "90" },
        { "type": "disk", "key": "│ ├", "keyColor": "90", "folders": "/" },
        { "type": "display", "key": "│ └", "keyColor": "90", "format": "{width}x{height} @ {refresh-rate} Hz" },
        "break",
        { "type": "custom", "format": "  {#32}● {#36}● {#90}● {#37}●" }
    ]
}
