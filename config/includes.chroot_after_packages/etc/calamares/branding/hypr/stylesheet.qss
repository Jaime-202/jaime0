/* Paleta jaime0 para el instalador: negro, grises y verde de acento */
QWidget {
    font-family: "JetBrainsMono Nerd Font";
    font-size: 13px;
    background-color: #080b0d;
    color: #d8e2e8;
}
#mainApp, #slideshow { background-color: #080b0d; }

QLabel { background: transparent; }
QLabel:disabled { color: #45545c; }

#resultsExplanation, #exec-message { color: #d8e2e8; }
#exec-message { padding: 6px 0; }

/* Botones */
QPushButton {
    background-color: #101519;
    color: #d8e2e8;
    border: 1px solid #26343a;
    border-radius: 4px;
    padding: 8px 18px;
    min-height: 18px;
}
QPushButton:hover { border-color: #54e58a; color: #eef4f7; }
QPushButton:focus { border-color: #54e58a; }
QPushButton:pressed { background-color: #151c21; }
QPushButton:disabled { background-color: #080b0d; color: #45545c; border-color: #151c21; }

QPushButton#view-button-next {
    background-color: #54e58a;
    color: #080b0d;
    border-color: #54e58a;
    font-weight: bold;
    qproperty-iconSize: 0px 0px;
    padding: 8px 26px;
}
QPushButton#view-button-next:hover { background-color: #54e58a; }
QPushButton#view-button-next:focus { border-color: #eef4f7; }
QPushButton#view-button-next:disabled { background-color: #101519; color: #45545c; border-color: #151c21; }

QPushButton#view-button-back, QPushButton#view-button-cancel {
    qproperty-iconSize: 0px 0px;
    background-color: transparent;
}
QPushButton#view-button-back:hover, QPushButton#view-button-cancel:hover { background-color: #101519; }
QPushButton#view-button-back:disabled, QPushButton#view-button-cancel:disabled { background-color: transparent; }

QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px;
}
QToolButton:hover, QToolButton:checked { background-color: #101519; border-color: #26343a; }

/* Campos */
QLineEdit, QComboBox, QTextEdit, QPlainTextEdit, QTextBrowser, QSpinBox {
    background-color: #080b0d;
    color: #d8e2e8;
    border: 1px solid #26343a;
    border-radius: 4px;
    padding: 6px 8px;
    selection-background-color: #26343a;
    selection-color: #eef4f7;
}
QLineEdit:focus, QComboBox:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus { border-color: #54e58a; }
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled { color: #45545c; border-color: #151c21; background-color: #080b0d; }

QComboBox { min-height: 18px; padding-right: 28px; }
QComboBox::drop-down { border: none; width: 26px; }
QComboBox::down-arrow { image: url(/etc/calamares/branding/hypr/img/flecha.svg); width: 12px; height: 12px; }
QComboBox QAbstractItemView {
    background-color: #080b0d;
    color: #d8e2e8;
    border: 1px solid #26343a;
    selection-background-color: #26343a;
    selection-color: #eef4f7;
    outline: 0;
}

/* Listas y tablas */
QListView, QListWidget, QTreeView, QTableView {
    background-color: #080b0d;
    alternate-background-color: #101519;
    color: #d8e2e8;
    border: 1px solid #26343a;
    border-radius: 4px;
    selection-background-color: #26343a;
    selection-color: #eef4f7;
    outline: 0;
}
QListView::item, QListWidget::item, QTreeView::item { padding: 4px 6px; }
QListView::item:selected, QListWidget::item:selected, QTreeView::item:selected { background-color: #26343a; color: #eef4f7; }
QListView::item:hover, QListWidget::item:hover, QTreeView::item:hover { background-color: #101519; }
QHeaderView { background-color: #080b0d; border: none; }
QHeaderView::section {
    background-color: #101519;
    color: #a7b4bc;
    border: none;
    border-right: 1px solid #26343a;
    border-bottom: 1px solid #26343a;
    padding: 6px 8px;
}

/* Opciones */
QRadioButton, QCheckBox { background: transparent; spacing: 10px; padding: 3px 0; color: #d8e2e8; }
QRadioButton:disabled, QCheckBox:disabled { color: #45545c; }
QRadioButton::indicator, QCheckBox::indicator {
    width: 16px;
    height: 16px;
    background-color: #080b0d;
    border: 1px solid #71818c;
}
QRadioButton::indicator { border-radius: 9px; }
QCheckBox::indicator { border-radius: 3px; }
QRadioButton::indicator:hover, QCheckBox::indicator:hover { border-color: #54e58a; }
QRadioButton::indicator:disabled, QCheckBox::indicator:disabled { border-color: #26343a; }
QRadioButton::indicator:checked { background-color: #54e58a; image: url(/etc/calamares/branding/hypr/img/radio.svg); }
QCheckBox::indicator:checked { background-color: #54e58a; image: url(/etc/calamares/branding/hypr/img/check.svg); }

QGroupBox { background: transparent; border: 1px solid #26343a; border-radius: 4px; margin-top: 12px; padding-top: 10px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; color: #54e58a; }

/* Progreso */
QProgressBar {
    background-color: #101519;
    color: #eef4f7;
    border: 1px solid #26343a;
    border-radius: 4px;
    text-align: center;
    min-height: 16px;
}
QProgressBar::chunk { background-color: #54e58a; border-radius: 3px; }

/* El programa dibuja estas etiquetas en negro y gris: necesitan un fondo intermedio. */
PartitionLabelsView { background-color: #45545c; border-radius: 3px; }

/* Barras de desplazamiento */
QScrollArea { border: none; background: transparent; }
QScrollBar:vertical { background: #080b0d; width: 10px; margin: 0; }
QScrollBar:horizontal { background: #080b0d; height: 10px; margin: 0; }
QScrollBar::handle { background: #26343a; border-radius: 4px; min-height: 24px; min-width: 24px; }
QScrollBar::handle:hover { background: #54e58a; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

QToolTip { background-color: #101519; color: #eef4f7; border: 1px solid #26343a; padding: 4px; }
QMessageBox { background-color: #080b0d; }
QMessageBox QLabel { color: #d8e2e8; }
