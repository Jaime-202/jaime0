[Unit]
Description=Aviso de nuevas versiones de Jaime0
Documentation=https://github.com/Jaime-202/jaime0/blob/main/docs/actualizaciones.md
# Solo en el sistema instalado y con la sesion grafica en marcha.
ConditionPathExists=!/run/live/medium

[Service]
Type=oneshot
# Solo consulta y avisa. Nunca instala nada.
ExecStart=/usr/local/bin/jaime0-update comprobar --notificar --silencioso
# 100 = hay una version nueva; 1 = sin red o GitHub no responde. Ninguno es un fallo.
SuccessExitStatus=1 100
Nice=10
IOSchedulingClass=idle
