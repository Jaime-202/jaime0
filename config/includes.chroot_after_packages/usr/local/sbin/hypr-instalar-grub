#!/bin/sh
# Corre dentro del sistema de destino. Instala el GRUB del firmware real desde los
# paquetes que viajan en la ISO, sin red. grub-pc y grub-efi-amd64 son incompatibles
# entre si, por eso no se instalan al compilar.
set -e
export DEBIAN_FRONTEND=noninteractive

if [ -d /sys/firmware/efi/efivars ]; then
    PAQUETE=grub-efi-amd64
else
    PAQUETE=grub-pc
fi

dpkg -i /var/cache/hypr-grub/${PAQUETE}_*.deb

# Tema del menu en /boot, que no va cifrado: con el disco cifrado GRUB no puede leer /usr
# (90-hypr.cfg lo usa desde aqui si existe).
mkdir -p /boot/grub/themes
rm -rf /boot/grub/themes/hypr
cp -r /usr/share/grub/themes/hypr /boot/grub/themes/hypr

# Oculta los textos "Loading Linux" e "initial ramdisk" antes de Plymouth.
sed -i 's/^quiet_boot="0"/quiet_boot="1"/' /etc/grub.d/10_linux

# Menu de arranque con el nombre del sistema y en espanol.
sed -i -e 's/OS="${GRUB_DISTRIBUTOR} GNU\/Linux"/OS="${GRUB_DISTRIBUTOR}"/' \
       -e 's/Advanced options for %s/Opciones avanzadas de %s/g' /etc/grub.d/10_linux
# El titulo de la entrada de recuperacion lo pone GRUB_RECOVERY_TITLE (90-hypr.cfg). Estos
# textos se traducirian con el idioma de quien ejecuta update-grub, que al instalar es C.
sed -i 's/"%s, with Linux %s/"%s, con Linux %s/g' /etc/grub.d/10_linux
sed -i 's/"(on %s)"/"(en %s)"/g' /etc/grub.d/30_os-prober 2>/dev/null || true
sed -i 's/UEFI Firmware Settings/Ajustes del firmware UEFI/' /etc/grub.d/30_uefi-firmware 2>/dev/null || true

# El instalador deja las lineas de crypttab sin opciones cuando /boot no esta cifrado, y
# Debian las trataria como cifrado "plain". Hay que declarar que son LUKS.
if [ -s /etc/crypttab ]; then
    sed -i -E '/^[[:space:]]*(#|$)/! s/^([^[:space:]]+[[:space:]]+[^[:space:]]+[[:space:]]+none)[[:space:]]*$/\1 luks,discard/' /etc/crypttab
fi

# El aviso de la clave y sus errores, en espanol y sin el identificador interno del disco
# (en la animacion de arranque, sin el prefijo "cryptsetup:").
sed -i -e 's/keyscriptarg="Please unlock disk $CRYPTTAB_NAME: "/keyscriptarg="Escribe la clave de cifrado del disco: "/' \
       -e 's/plymouth message --text="cryptsetup: \$\*"/plymouth message --text="$*"/' /usr/lib/cryptsetup/functions
sed -i -e 's/"ERROR: $CRYPTTAB_NAME: cryptsetup failed, bad password or options?"/"La clave no es correcta. Vuelve a escribirla."/' \
       -e 's/"ERROR: $CRYPTTAB_NAME: maximum number of tries exceeded"/"Demasiados intentos con una clave incorrecta."/' \
       /usr/share/initramfs-tools/scripts/local-top/cryptroot

# Con el mapa de teclado en el initramfs, la clave de cifrado se escribe con la
# distribucion elegida y no con la americana.
sed -i 's/^#\?KEYMAP=.*/KEYMAP=y/' /etc/initramfs-tools/initramfs.conf
