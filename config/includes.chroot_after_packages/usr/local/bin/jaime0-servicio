#!/usr/bin/python3 -I
# jaime0-servicio: servicio del Control Center (Fases 2 a 4: salud, historico, incidencias,
# eventos, SMART, umbrales de jaime0-ajustes y motor de perfiles).
#
#   jaime0-servicio ejecutar        demonio (bucle de GLib): mide, evalua, escribe
#                                   instante.json y estado.json y atiende control.sock
#   jaime0-servicio medir [--json]  una medicion inmediata (dos lecturas separadas 0,5 s);
#                                   imprime el JSON de instante
#
# Diseno (ver docs/control-center.md): un unico dueno del estado. Las CLIs y la interfaz
# solo leen los archivos o piden por el socket. Sin subprocesos en el muestreo (solo el
# aviso a Waybar cuando algo cambia). Secciones: medicion, estado, bus, api, servicio.
#
# Pruebas: JAIME0_RAIZ apunta a un sistema de mentira para /proc y /sys (solo sin root);
# JAIME0_RUNTIME sustituye a $XDG_RUNTIME_DIR/jaime0 y JAIME0_ESTADO a ~/.local/state/jaime0.

import argparse
import collections
import datetime
import functools
import glob
import json
import math
import os
import re
import shutil
import subprocess
import sys
import threading
import time
import traceback

PROGRAMA = "jaime0-servicio"
VERSION_DATOS = 1
SENAL_BARRA = 11            # RTMIN+11: la barra relee el indicador
INTERVALO_NORMAL = 10       # segundos entre muestras
INTERVALO_RAPIDO = 2        # segundos mientras la interfaz esta abierta
DURACION_RAPIDO = 15        # segundos que dura cada peticion "rapido"
REFRESCO_LENTO = 60         # segundos entre consultas de unidades fallidas y cortafuegos
TAMANO_ANILLO = 3600        # muestras como maximo (una hora a 1 s; sobra a 2 s y a 10 s)
DURACION_ANILLO = 3600      # segundos que se conservan las muestras del anillo
VOLCADO_CADA = 300          # segundos entre volcados del historico a disco
SMART_CADA = 600            # segundos entre consultas SMART a udisks2
FACTOR_HUECO = 3            # hueco si entre dos muestras pasa mas de 3 x el intervalo
RETENCION_MINUTOS = 2 * 86400   # los archivos diarios (agregados de minuto) duran 2 dias
MAX_PUNTOS = 720            # puntos como maximo en una serie
MAX_EVENTOS = 200           # eventos de actividad en RAM
MAX_INCIDENCIAS = 500       # lineas de incidencias.jsonl
MUESTRAS_INCIDENCIA = 3     # muestras seguidas para abrir o cerrar una incidencia
MUESTRAS_PICO_CPU = 2
UMBRAL_PICO_CPU = 85.0
UMBRAL_PICO_RAM = 90.0
SALTO_TEMPERATURA = 15.0    # grados entre muestras consecutivas
RANGOS = {"5m": 300, "1h": 3600, "24h": 86400}      # "historia" no tiene ventana fija
METRICAS = ("cpu", "ram", "swap", "presion", "temp", "gpu_temp", "bateria", "vatios",
            "lectura", "escritura", "disco")

# Umbrales unicos del estado global (ver evaluar). Por defecto; los de jaime0-ajustes los
# sustituyen (ver cargar_umbrales).
UMBRALES = {
    "temp_aviso": 85.0, "temp_critico": 95.0,          # cpu.temp, en grados
    "disco_aviso": 85.0, "disco_critico": 95.0,        # % ocupado
    "bateria_aviso": 15, "bateria_critico": 5,         # % y descargando
    "ram_libre_critico": 5.0,                          # % disponible por debajo
    "swap_aviso": 50.0,                                # % de swap usada por encima
    "presion_aviso": 20.0,                             # avg10 de /proc/pressure/memory
    "historial_dias": 90,                              # duracion del historico de 15 min
}
# Ajuste de jaime0-ajustes -> clave de UMBRALES
AJUSTES_UMBRALES = {
    "umbral_temp_aviso": "temp_aviso", "umbral_temp_critico": "temp_critico",
    "umbral_disco_aviso": "disco_aviso", "umbral_disco_critico": "disco_critico",
    "umbral_bateria_aviso": "bateria_aviso", "umbral_bateria_critico": "bateria_critico",
    "historial_dias": "historial_dias",
}


def carpeta_config():
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    return os.path.join(base, "jaime0")


def es_root():
    return hasattr(os, "geteuid") and os.geteuid() == 0


def raiz():
    """Raiz de /proc y /sys: la falsa de JAIME0_RAIZ solo sin privilegios."""
    return "/" if es_root() else os.environ.get("JAIME0_RAIZ", "/")


def modo_prueba():
    return raiz() != "/"


def ruta(*partes):
    return os.path.join(raiz(), *[p.lstrip("/\\") for p in partes])


def directorio_ejecucion():
    """JAIME0_RUNTIME o $XDG_RUNTIME_DIR/jaime0, creado con 0700."""
    d = os.environ.get("JAIME0_RUNTIME")
    if not d:
        base = os.environ.get("XDG_RUNTIME_DIR")
        if not base:
            raise RuntimeError("no hay XDG_RUNTIME_DIR ni JAIME0_RUNTIME")
        d = os.path.join(base, "jaime0")
    os.makedirs(d, mode=0o700, exist_ok=True)
    return d


def directorio_estado():
    """JAIME0_ESTADO, o $XDG_STATE_HOME/jaime0, o ~/.local/state/jaime0, creado con 0700."""
    d = os.environ.get("JAIME0_ESTADO")
    if not d:
        base = os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state")
        d = os.path.join(base, "jaime0")
    os.makedirs(d, mode=0o700, exist_ok=True)
    return d


def registrar(texto):
    print(f"{PROGRAMA}: {texto}", file=sys.stderr, flush=True)


def protegido(defecto):
    """Aisla un manejador: si falla, lo registra y devuelve `defecto` (True mantiene viva
    una fuente de GLib)."""
    def deco(f):
        @functools.wraps(f)
        def envoltorio(*a, **k):
            try:
                return f(*a, **k)
            except Exception:
                registrar("error en " + f.__name__ + ":\n" + traceback.format_exc())
                return defecto
        return envoltorio
    return deco


def escribir_json(destino, objeto):
    """Escritura atomica: temporal en el mismo directorio y os.replace."""
    tmp = destino + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(objeto, f, ensure_ascii=False, separators=(",", ":"))
    os.replace(tmp, destino)


# ---------------------------------------------------------------------------
# Medicion: solo lee /proc y /sys, sin subprocesos
# ---------------------------------------------------------------------------

def leer(*partes):
    try:
        with open(ruta(*partes), encoding="utf-8", errors="replace") as f:
            return f.read()
    except OSError:
        return None


def leer_ruta(p):
    try:
        with open(p, encoding="utf-8", errors="replace") as f:
            return f.read().strip()
    except OSError:
        return None


def leer_entero(p):
    t = leer_ruta(p)
    try:
        return int(t) if t is not None else None
    except ValueError:
        return None


def parsear_cpu_stat(texto):
    """Devuelve ((inactivo, total), {n: (inactivo, total)}) en jiffies acumulados."""
    total, nucleos = None, {}
    for linea in (texto or "").splitlines():
        if not linea.startswith("cpu"):
            continue
        c = linea.split()
        try:
            v = [int(x) for x in c[1:]]
        except ValueError:
            continue
        if len(v) < 4:
            continue
        par = (v[3] + (v[4] if len(v) > 4 else 0), sum(v[:8]))  # inactivo+iowait; sin guest
        if c[0] == "cpu":
            total = par
        elif c[0][3:].isdigit():
            nucleos[int(c[0][3:])] = par
    return total, nucleos


def porcentaje_cpu(antes, ahora):
    """% de uso entre dos lecturas (inactivo, total); None si no hay diferencia."""
    if not antes or not ahora:
        return None
    dt = ahora[1] - antes[1]
    if dt <= 0:
        return None
    uso = 100.0 * (1.0 - (ahora[0] - antes[0]) / dt)
    return round(min(100.0, max(0.0, uso)), 1)


def frecuencia_mhz(n):
    kh = leer_entero(ruta("sys", "devices", "system", "cpu", f"cpu{n}", "cpufreq", "scaling_cur_freq"))
    return None if kh is None else int(round(kh / 1000.0))


def leer_ram():
    texto = leer("proc", "meminfo")
    if texto is None:
        return None
    kb = {}
    for linea in texto.splitlines():
        partes = linea.replace(":", " ").split()
        if len(partes) >= 2 and partes[1].isdigit():
            kb[partes[0]] = int(partes[1])
    if "MemTotal" not in kb or "MemAvailable" not in kb:
        return None
    mib = lambda k: int(round(kb[k] / 1024.0))
    return {"usada": int(round((kb["MemTotal"] - kb["MemAvailable"]) / 1024.0)),
            "total": mib("MemTotal"),
            "swap": int(round((kb.get("SwapTotal", 0) - kb.get("SwapFree", 0)) / 1024.0)),
            "swap_total": mib("SwapTotal") if "SwapTotal" in kb else 0,
            "presion": presion_memoria()}


def presion_memoria():
    """avg10 de la linea 'some' de /proc/pressure/memory, o None."""
    for linea in (leer("proc", "pressure", "memory") or "").splitlines():
        c = linea.split()
        if c and c[0] == "some":
            for campo in c[1:]:
                if campo.startswith("avg10="):
                    try:
                        return float(campo[6:])
                    except ValueError:
                        return None
    return None


def leer_temperaturas():
    """Lista [{"id": "<name>/<etiqueta>", "c": grados}] de todos los hwmon."""
    salida = []
    for entrada in sorted(glob.glob(ruta("sys", "class", "hwmon", "hwmon*", "temp*_input"))):
        carpeta, archivo = os.path.split(entrada)
        n = archivo[len("temp"):-len("_input")]
        mili = leer_entero(entrada)
        if mili is None:
            continue
        nombre = leer_ruta(os.path.join(carpeta, "name")) or os.path.basename(carpeta)
        etiqueta = leer_ruta(os.path.join(carpeta, f"temp{n}_label")) or f"temp{n}"
        salida.append({"id": f"{nombre}/{etiqueta}", "c": round(mili / 1000.0, 1)})
    return salida


def temperatura_cpu(temps):
    """Package id 0 de coretemp, o Tctl de k10temp, o el maximo de coretemp; None si no hay."""
    por_id = {t["id"]: t["c"] for t in temps}
    if "coretemp/Package id 0" in por_id:
        return por_id["coretemp/Package id 0"]
    if "k10temp/Tctl" in por_id:
        return por_id["k10temp/Tctl"]
    nucleos = [t["c"] for t in temps if t["id"].startswith("coretemp/")]
    return max(nucleos) if nucleos else None


def dispositivo_nvidia():
    """Carpeta de sysfs de la primera GPU NVIDIA (clase 3D o VGA), o None."""
    for dev in sorted(glob.glob(ruta("sys", "bus", "pci", "devices", "*"))):
        if leer_ruta(os.path.join(dev, "vendor")) != "0x10de":
            continue
        clase = (leer_ruta(os.path.join(dev, "class")) or "")[:6]
        if clase in ("0x0300", "0x0302"):
            return dev
    return None


def estado_nvidia():
    """'activa' | 'suspendida' | 'sin-driver' | None (no hay GPU NVIDIA). Nunca ejecuta
    nvidia-smi: leer su temperatura despertaria la grafica."""
    dev = dispositivo_nvidia()
    if dev is None:
        return None
    if not os.path.exists(os.path.join(dev, "driver")):
        return "sin-driver"
    return "suspendida" if leer_ruta(os.path.join(dev, "power", "runtime_status")) == "suspended" else "activa"


def nvidia_activa():
    """True solo si power/runtime_status vale exactamente 'active' (y hay driver)."""
    dev = dispositivo_nvidia()
    return (dev is not None and os.path.exists(os.path.join(dev, "driver"))
            and leer_ruta(os.path.join(dev, "power", "runtime_status")) == "active")


def temperatura_nvidia(ejecutar=None):
    """Temperatura de la GPU NVIDIA con nvidia-smi, SOLO si esta activa: con la GPU
    suspendida devuelve None sin ejecutar nada (nvidia-smi la despertaria)."""
    if not nvidia_activa():
        return None
    ejecutar = ejecutar or subprocess.run
    try:
        r = ejecutar(["nvidia-smi", "--query-gpu=temperature.gpu", "--format=csv,noheader,nounits"],
                     capture_output=True, text=True, timeout=3)
        if r.returncode != 0:
            return None
        return float((r.stdout or "").strip().splitlines()[0])
    except (OSError, ValueError, IndexError, subprocess.TimeoutExpired):
        return None


def uso_disco(punto):
    """{"punto","usado","total"} en GiB con 1 decimal, o None si no se puede leer."""
    try:
        v = os.statvfs(ruta(punto))
    except (OSError, AttributeError):
        return None
    gib = 1024.0 ** 3
    total = v.f_blocks * v.f_frsize
    return {"punto": punto, "usado": round((v.f_blocks - v.f_bfree) * v.f_frsize / gib, 1),
            "total": round(total / gib, 1)}


def puntos_de_disco():
    """'/' y, si es otro sistema de archivos (por st_dev), '/home'."""
    puntos = ["/"]
    try:
        if os.stat(ruta("home")).st_dev != os.stat(ruta()).st_dev:
            puntos.append("/home")
    except OSError:
        pass
    return puntos


def parsear_diskstats(texto):
    """{dispositivo: (sectores_leidos, sectores_escritos)}."""
    d = {}
    for linea in (texto or "").splitlines():
        c = linea.split()
        if len(c) >= 10 and c[5].isdigit() and c[9].isdigit():
            d[c[2]] = (int(c[5]), int(c[9]))
    return d


def io_disco(antes, ahora, dt):
    """(lectura, escritura) en MB/s (1 MB = 10^6 B, sectores de 512 B) o (None, None)."""
    if not antes or not ahora or dt <= 0:
        return None, None
    mb = lambda s: round(max(0, s) * 512 / 1e6 / dt, 2)
    return mb(ahora[0] - antes[0]), mb(ahora[1] - antes[1])


def dispositivo_raiz():
    """Nombre del dispositivo de bloque que contiene '/', o None si no se puede saber."""
    try:
        dev = os.stat(ruta()).st_dev
        enlace = os.path.realpath(ruta("sys", "dev", "block", f"{os.major(dev)}:{os.minor(dev)}"))
        return os.path.basename(enlace) or None
    except (OSError, AttributeError):
        return None


ESTADOS_BATERIA = {"Charging": "cargando", "Discharging": "descargando", "Full": "llena",
                   "Not charging": "sin-cargar"}


def leer_bateria():
    """Primera BAT* de tipo Battery como dict, o None si no hay bateria."""
    base = ruta("sys", "class", "power_supply")
    for d in sorted(glob.glob(os.path.join(base, "BAT*"))):
        if leer_ruta(os.path.join(d, "type")) != "Battery":
            continue
        e = lambda nombre: leer_entero(os.path.join(d, nombre))
        estado = ESTADOS_BATERIA.get(leer_ruta(os.path.join(d, "status")) or "", "desconocido")
        pot, corr, volt = e("power_now"), e("current_now"), e("voltage_now")
        vatios = None
        if pot is not None and pot > 0:
            vatios = round(pot / 1e6, 1)
        elif corr and volt:
            vatios = round(abs(corr) * volt / 1e12, 1)
        minutos = None
        if estado == "descargando" and vatios:
            if pot is not None and pot > 0 and e("energy_now") is not None:
                minutos = int(round(e("energy_now") / pot * 60))
            elif corr and e("charge_now") is not None:
                minutos = int(round(e("charge_now") / abs(corr) * 60))
        salud = None
        for lleno, diseno in (("energy_full", "energy_full_design"), ("charge_full", "charge_full_design")):
            if e(lleno) is not None and e(diseno):
                salud = round(100.0 * e(lleno) / e(diseno), 1)
                break
        return {"nivel": e("capacity"), "estado": estado, "vatios": vatios,
                "minutos_estimados": minutos, "salud": salud, "estimado": True}
    return None


def leer_cargador():
    """True/False si hay alguna fuente Mains; None si no hay ninguna."""
    hay = False
    for d in sorted(glob.glob(ruta("sys", "class", "power_supply", "*"))):
        if leer_ruta(os.path.join(d, "type")) == "Mains":
            hay = True
            if leer_ruta(os.path.join(d, "online")) == "1":
                return True
    return False if hay else None


def leer_uptime():
    try:
        return int(float((leer("proc", "uptime") or "").split()[0]))
    except (IndexError, ValueError):
        return None


def tics_por_segundo():
    try:
        return os.sysconf("SC_CLK_TCK")
    except (AttributeError, ValueError, OSError):
        return 100


def leer_procesos():
    """{pid: (tics_cpu, nombre)} de /proc/[pid]/stat. Tolera procesos que desaparecen."""
    d = {}
    for p in glob.glob(ruta("proc", "[0-9]*")):
        pid = os.path.basename(p)
        if not pid.isdigit():
            continue
        try:
            with open(os.path.join(p, "stat"), encoding="utf-8", errors="replace") as f:
                t = f.read()
            nombre = t[t.index("(") + 1:t.rindex(")")]
            c = t[t.rindex(")") + 1:].split()
            d[int(pid)] = (int(c[11]) + int(c[12]), nombre)   # utime + stime
        except (OSError, ValueError, IndexError):
            continue
    return d


def ram_proceso(pid):
    """VmRSS en MiB o None."""
    for linea in (leer("proc", str(pid), "status") or "").splitlines():
        if linea.startswith("VmRSS:"):
            try:
                return int(round(int(linea.split()[1]) / 1024.0))
            except (IndexError, ValueError):
                return None
    return None


def procesos_top(antes, ahora, dt, cuantos=5):
    """Los de mas CPU entre dos muestras (100 % = un nucleo entero)."""
    if not antes or dt <= 0:
        return None
    tics = tics_por_segundo()
    lista = []
    for pid, (t, nombre) in ahora.items():
        if pid in antes:
            cpu = (t - antes[pid][0]) / tics / dt * 100.0
            if cpu > 0:
                lista.append((cpu, pid, nombre))
    lista.sort(reverse=True)
    return [{"pid": pid, "nombre": nombre, "cpu": round(cpu, 1), "ram": ram_proceso(pid)}
            for cpu, pid, nombre in lista[:cuantos]]


class Muestreador:
    """Guarda la lectura anterior para calcular los porcentajes por diferencias."""

    def __init__(self):
        self.previa = None

    def crudo(self):
        return {"mono": time.monotonic(),
                "cpu": parsear_cpu_stat(leer("proc", "stat")),
                "procs": leer_procesos(),
                "disk": parsear_diskstats(leer("proc", "diskstats"))}

    def base(self):
        self.previa = self.crudo()

    def muestrear(self):
        ahora = self.crudo()
        antes, self.previa = self.previa, ahora
        dt = ahora["mono"] - antes["mono"] if antes else 0
        total_a, nuc_a = antes["cpu"] if antes else (None, {})
        total_b, nuc_b = ahora["cpu"]
        indices = sorted(nuc_b)
        mhz = [frecuencia_mhz(n) for n in indices]
        temps = leer_temperaturas()
        cpu = {"total": porcentaje_cpu(total_a, total_b),
               "nucleos": [porcentaje_cpu(nuc_a.get(n), nuc_b[n]) for n in indices] if antes else None,
               "mhz": mhz if any(m is not None for m in mhz) else None,
               "temp": temperatura_cpu(temps)}
        dev = dispositivo_raiz()
        lectura = escritura = None
        if antes and dev:
            lectura, escritura = io_disco(antes["disk"].get(dev), ahora["disk"].get(dev), dt)
        discos = []
        for punto in puntos_de_disco():
            u = uso_disco(punto)
            if u:
                u["lectura"], u["escritura"] = (lectura, escritura) if punto == "/" else (None, None)
                discos.append(u)
        return {"cpu": cpu, "ram": leer_ram(), "temp": temps,
                "gpu": {"nvidia": estado_nvidia(), "temp": None},
                "disco": discos or None, "bateria": leer_bateria(), "cargador": leer_cargador(),
                "uptime": leer_uptime(),
                "procesos": procesos_top(antes["procs"], ahora["procs"], dt) if antes else None}


def armar_instante(med, t, intervalo, fallidas=None, smart=None):
    """Instante en el formato de docs/control-center.md. 'fallidas' (lista de unidades
    systemd fallidas o None) y 'smart' (lista de discos o None) son campos extra para que
    evaluar() siga siendo puro."""
    inst = {"v": VERSION_DATOS, "t": int(t), "intervalo": intervalo}
    inst.update(med)
    inst["fallidas"] = fallidas
    inst["smart"] = smart
    inst["estado"], inst["alertas"] = "ONLINE", 0
    return inst


# ---------------------------------------------------------------------------
# Estado global (funcion pura) y privacidad
# ---------------------------------------------------------------------------

def evaluar(inst, u=None):
    """(estado, motivos) a partir de un instante y los umbrales. Motivos: lista de
    {"gravedad","componente","texto"}; por componente solo se informa lo mas grave."""
    u = u or UMBRALES
    motivos = []

    def nuevo(gravedad, componente, texto):
        motivos.append({"gravedad": gravedad, "componente": componente, "texto": texto})

    temp = (inst.get("cpu") or {}).get("temp")
    if temp is not None:
        if temp >= u["temp_critico"]:
            nuevo("CRITICAL", "cpu", f"Temperatura de la CPU a {temp:.0f} °C")
        elif temp >= u["temp_aviso"]:
            nuevo("WARNING", "cpu", f"Temperatura de la CPU a {temp:.0f} °C")
    for d in inst.get("disco") or []:
        if d.get("total"):
            pct = 100.0 * d["usado"] / d["total"]
            if pct >= u["disco_critico"]:
                nuevo("CRITICAL", "disco", f"Disco {d['punto']} al {pct:.0f} %")
            elif pct >= u["disco_aviso"]:
                nuevo("WARNING", "disco", f"Disco {d['punto']} al {pct:.0f} %")
    bat = inst.get("bateria")
    if bat and bat.get("nivel") is not None and bat.get("estado") == "descargando":
        if bat["nivel"] <= u["bateria_critico"]:
            nuevo("CRITICAL", "bateria", f"Batería al {bat['nivel']} %")
        elif bat["nivel"] <= u["bateria_aviso"]:
            nuevo("WARNING", "bateria", f"Batería al {bat['nivel']} %")
    ram = inst.get("ram")
    if ram:
        if ram.get("total"):
            libre = 100.0 * (ram["total"] - ram["usada"]) / ram["total"]
            if libre < u["ram_libre_critico"]:
                nuevo("CRITICAL", "ram", f"Memoria disponible al {libre:.0f} %")
        if ram.get("swap_total", 0) > 0 and 100.0 * ram["swap"] / ram["swap_total"] > u["swap_aviso"]:
            nuevo("WARNING", "swap", f"Swap usada al {100.0 * ram['swap'] / ram['swap_total']:.0f} %")
        if ram.get("presion") is not None and ram["presion"] > u["presion_aviso"]:
            nuevo("WARNING", "ram", f"Presión de memoria alta ({ram['presion']:.1f})")
    fallidas = inst.get("fallidas")
    if fallidas:
        nuevo("WARNING", "systemd", f"Unidades fallidas: {', '.join(fallidas[:3])}"
              + ("…" if len(fallidas) > 3 else ""))
    if any(m["gravedad"] == "CRITICAL" for m in motivos):
        return "CRITICAL", motivos
    return ("WARNING" if motivos else "ONLINE"), motivos


def resumen_privacidad(unidad_activa=None):
    """Resumen de cortafuegos. No afirma que el sistema este protegido, solo lo que se ve.
    unidad_activa: True/False segun ActiveState de ufw.service, None si no se pudo saber."""
    conf = leer("etc", "ufw", "ufw.conf")
    if conf is None:
        return {"estado": "UNAVAILABLE", "detalles": ["El cortafuegos (UFW) no está instalado"]}
    activado = any(l.strip().replace(" ", "").upper() == "ENABLED=YES" for l in conf.splitlines())
    if activado and unidad_activa:
        politica = (leer("etc", "default", "ufw") or "").replace('"', "").replace(" ", "")
        denegado = any(l.startswith("DEFAULT_INPUT_POLICY=") and l.split("=", 1)[1] in ("DROP", "REJECT")
                       for l in politica.splitlines())
        return {"estado": "SECURE",
                "detalles": ["Cortafuegos activo: entrante denegado por defecto" if denegado
                             else "Cortafuegos activo"]}
    if not activado:
        return {"estado": "WARNING", "detalles": ["El cortafuegos (UFW) está desactivado"]}
    return {"estado": "WARNING", "detalles": ["El cortafuegos (UFW) está configurado pero su servicio no está activo"]}


def muestra_desde_instante(inst):
    """Muestra reducida para el anillo y el historico: una por metrica, None si no hay dato.
    ram, swap y disco son % usado; presion es avg10; lectura/escritura en MB/s del disco '/'."""
    cpu, ram = inst.get("cpu") or {}, inst.get("ram") or {}
    bat, gpu = inst.get("bateria") or {}, inst.get("gpu") or {}
    raiz_disco = next((d for d in inst.get("disco") or [] if d.get("punto") == "/"), None) or {}

    def pct(a, b):
        return round(100.0 * a / b, 1) if a is not None and b else None

    return {"t": int(inst["t"]), "cpu": cpu.get("total"),
            "ram": pct(ram.get("usada"), ram.get("total")),
            "swap": pct(ram.get("swap"), ram.get("swap_total")),
            "presion": ram.get("presion"), "temp": cpu.get("temp"), "gpu_temp": gpu.get("temp"),
            "bateria": bat.get("nivel"), "vatios": bat.get("vatios"),
            "lectura": raiz_disco.get("lectura"), "escritura": raiz_disco.get("escritura"),
            "disco": pct(raiz_disco.get("usado"), raiz_disco.get("total"))}


def anillo_agregar(anillo, inst):
    """Anade la muestra al anillo en RAM y descarta lo que pase de una hora."""
    m = muestra_desde_instante(inst)
    anillo.append(m)
    while anillo and anillo[0]["t"] < m["t"] - DURACION_ANILLO:
        anillo.popleft()
    return m


# ---------------------------------------------------------------------------
# Historico: agregados de minuto y de 15 minutos, huecos, JSONL
# ---------------------------------------------------------------------------

def leer_jsonl(archivo):
    """Documentos (dict) de un JSONL. Las lineas rotas o vacias se ignoran."""
    docs = []
    try:
        with open(archivo, encoding="utf-8", errors="replace") as f:
            for linea in f:
                linea = linea.strip()
                if not linea:
                    continue
                try:
                    d = json.loads(linea)
                except ValueError:
                    continue
                if isinstance(d, dict):
                    docs.append(d)
    except OSError:
        pass
    return docs


def anexar_jsonl(archivo, docs):
    """Anexa lineas completas con una sola escritura. Si el archivo no termina en salto de
    linea (escritura cortada), empieza por uno para no pegarse a la linea rota."""
    if not docs:
        return
    texto = "".join(json.dumps(d, ensure_ascii=False, separators=(",", ":")) + "\n" for d in docs)
    prefijo = ""
    try:
        with open(archivo, "rb") as f:
            f.seek(0, os.SEEK_END)
            if f.tell() > 0:
                f.seek(-1, os.SEEK_END)
                if f.read(1) != b"\n":
                    prefijo = "\n"
    except OSError:
        pass
    with open(archivo, "a", encoding="utf-8", newline="\n") as f:
        f.write(prefijo + texto)


def reescribir_jsonl(archivo, docs):
    """Reescritura atomica (temporal y os.replace)."""
    tmp = archivo + ".tmp"
    with open(tmp, "w", encoding="utf-8", newline="\n") as f:
        for d in docs:
            f.write(json.dumps(d, ensure_ascii=False, separators=(",", ":")) + "\n")
    os.replace(tmp, archivo)


def pseudo_agregado(m):
    """Una muestra como agregado de un solo punto: cada metrica [v, v, v] o None."""
    p = {"t": m["t"], "n": 1}
    for k in METRICAS:
        v = m.get(k)
        p[k] = None if v is None else [v, v, v]
    return p


def combinar(items, t0):
    """Agrega agregados (o pseudo-agregados) en uno: minimo de los minimos, media de las
    medias ponderada por n y maximo de los maximos, ignorando None (todo None -> None)."""
    out = {"v": VERSION_DATOS, "t": int(t0), "n": sum(int(i.get("n", 1)) for i in items)}
    for k in METRICAS:
        con = [i for i in items if i.get(k) is not None]
        if not con:
            out[k] = None
            continue
        pesos = [max(1, int(i.get("n", 1))) for i in con]
        media = sum(i[k][1] * p for i, p in zip(con, pesos)) / sum(pesos)
        out[k] = [round(min(i[k][0] for i in con), 2), round(media, 2), round(max(i[k][2] for i in con), 2)]
    return out


def agregado_valido(d):
    """Normaliza un agregado leido del disco; None si no sirve."""
    if not isinstance(d.get("t"), (int, float)) or isinstance(d.get("t"), bool):
        return None
    out = {"v": VERSION_DATOS, "t": int(d["t"]), "n": d["n"] if isinstance(d.get("n"), int) and d["n"] > 0 else 1}
    for k in METRICAS:
        v = d.get(k)
        ok = (isinstance(v, list) and len(v) == 3
              and all(isinstance(x, (int, float)) and not isinstance(x, bool) for x in v))
        out[k] = v if ok else None
    if isinstance(d.get("eventos"), list):
        out["eventos"] = [e for e in d["eventos"] if isinstance(e, dict) and isinstance(e.get("t"), (int, float))]
    if isinstance(d.get("u"), (int, float)) and not isinstance(d.get("u"), bool):
        out["u"] = int(d["u"])
    return out


def hueco_valido(d):
    h = d.get("hueco")
    if (isinstance(h, list) and len(h) == 2 and all(isinstance(x, (int, float)) and not isinstance(x, bool) for x in h)
            and h[0] < h[1]):
        return [int(h[0]), int(h[1])]
    return None


def fusionar_duplicados(agregados):
    """Ordena por t y une los que comparten t (un minuto cortado por una suspension)."""
    salida = []
    for a in sorted(agregados, key=lambda x: x["t"]):
        if salida and salida[-1]["t"] == a["t"]:
            previo = salida[-1]
            union = combinar([previo, a], a["t"])
            ultimas = [x["u"] for x in (previo, a) if "u" in x]
            if ultimas:
                union["u"] = max(ultimas)
            evs = previo.get("eventos", []) + a.get("eventos", [])
            if evs:
                union["eventos"] = evs
            salida[-1] = union
        else:
            salida.append(a)
    return salida


def reducir(puntos, resolucion, maximo=MAX_PUNTOS):
    """Si hay mas de `maximo` puntos, los agrupa por tiempo (min de los min, media de las
    medias, max de los max). Devuelve (puntos, resolucion)."""
    if len(puntos) <= maximo:
        return puntos, resolucion
    t0 = puntos[0]["t"]
    span = puntos[-1]["t"] - t0 + resolucion
    k = max(2, int(math.ceil(span / float(resolucion * maximo))))
    tam = resolucion * k
    grupos = collections.OrderedDict()
    for p in puntos:
        grupos.setdefault(int((p["t"] - t0) // tam), []).append(p)
    return [combinar(g, t0 + i * tam) for i, g in grupos.items()], tam


class Historico:
    """Minutos y cuartos de hora en RAM y en disco, y la lista de huecos.

    Disco (carpeta salud/): AAAA-MM-DD.jsonl con los minutos y huecos de cada dia (48 h) e
    historico.jsonl con los cuartos de hora (historial_dias). Siempre por anexado de lineas
    completas; solo historico.jsonl se reescribe (una vez al dia, para recortarlo)."""

    def __init__(self, carpeta, reloj=time.time, eventos=None, dias=90):
        self._carpeta = carpeta         # callable -> carpeta (creada si falta)
        self.reloj = reloj
        self.eventos = eventos if eventos is not None else collections.deque(maxlen=MAX_EVENTOS)
        self.dias = dias
        self.minutos, self.cuartos, self.huecos = [], [], []
        self.actual_t, self.actual = None, []
        self.cuarto_t, self.cuarto_items = None, []
        self.pend, self.pend_hist = [], []
        self.ultimo_t, self.ultimo_intervalo = None, INTERVALO_NORMAL
        self.ultimo_recorte = 0

    # -- entrada -------------------------------------------------------------
    def anadir(self, m, intervalo):
        t = m["t"]
        if self.ultimo_t is not None and t - self.ultimo_t > FACTOR_HUECO * max(intervalo, self.ultimo_intervalo):
            self._hueco(self.ultimo_t, t)
        b = t - t % 60
        if self.actual_t is not None and b != self.actual_t:
            self._cerrar_minuto()
        self.actual_t = b
        self.actual.append(m)
        self.ultimo_t, self.ultimo_intervalo = t, intervalo

    def cerrar_hueco(self, ahora):
        """Al reanudar tras suspender: cierra el hueco desde la ultima muestra hasta ahora."""
        if self.ultimo_t is not None and ahora - self.ultimo_t > FACTOR_HUECO * self.ultimo_intervalo:
            self._hueco(self.ultimo_t, ahora)
            self.ultimo_t = ahora

    def _hueco(self, ini, fin):
        h = [int(ini), int(fin)]
        if h[0] >= h[1] or (self.huecos and self.huecos[-1] == h):
            return
        self.huecos.append(h)
        linea = {"v": VERSION_DATOS, "hueco": h}
        self.pend.append(linea)
        self.pend_hist.append(linea)

    def _cerrar_minuto(self):
        if not self.actual:
            self.actual_t = None
            return
        t0 = self.actual_t
        agg = combinar([pseudo_agregado(m) for m in self.actual], t0)
        # Hora de la ultima muestra real del minuto: un minuto cerrado a medias (parada,
        # suspension) no debe contar como si llegara hasta su final al buscar huecos.
        agg["u"] = int(max(m["t"] for m in self.actual))
        evs = [e for e in list(self.eventos) if t0 <= e["t"] < t0 + 60]
        if evs:
            agg["eventos"] = evs
        self.actual, self.actual_t = [], None
        self.minutos.append(agg)
        self.pend.append(agg)
        qt = t0 - t0 % 900
        if self.cuarto_t is not None and qt != self.cuarto_t:
            self._cerrar_cuarto()
        self.cuarto_t = qt
        self.cuarto_items.append(agg)

    def _cerrar_cuarto(self):
        if self.cuarto_items:
            agg = combinar(self.cuarto_items, self.cuarto_t)
            self.cuartos.append(agg)
            self.pend_hist.append(agg)
        self.cuarto_items, self.cuarto_t = [], None

    # -- disco ---------------------------------------------------------------
    @staticmethod
    def _nombre_dia(t):
        return time.strftime("%Y-%m-%d", time.localtime(t))

    def volcar(self, cerrar_parcial=False):
        """Escribe lo pendiente. cerrar_parcial (suspension, parada): cierra tambien el minuto
        y el cuarto de hora en curso. Lo que no se pueda escribir se reintenta luego."""
        if cerrar_parcial:
            self._cerrar_minuto()
            self._cerrar_cuarto()
        carpeta = self._carpeta()
        por_dia, pendiente = {}, []
        for d in self.pend:
            fin = d["hueco"][1] if "hueco" in d else d["t"]
            por_dia.setdefault(self._nombre_dia(fin), []).append(d)
        for dia, docs in por_dia.items():
            try:
                anexar_jsonl(os.path.join(carpeta, dia + ".jsonl"), docs)
            except OSError:
                pendiente += docs
                registrar("no se pudo escribir el historico de " + dia)
        self.pend = pendiente
        try:
            anexar_jsonl(os.path.join(carpeta, "historico.jsonl"), self.pend_hist)
            self.pend_hist = []
        except OSError:
            registrar("no se pudo escribir historico.jsonl")
        self._retencion(carpeta)
        return not self.pend and not self.pend_hist

    def _retencion(self, carpeta):
        ahora = self.reloj()
        limite_dia = (datetime.date.fromtimestamp(ahora) - datetime.timedelta(days=2)).isoformat()
        for nombre in os.listdir(carpeta):
            m = re.fullmatch(r"(\d{4}-\d{2}-\d{2})\.jsonl", nombre)
            if m and m.group(1) < limite_dia:
                try:
                    os.remove(os.path.join(carpeta, nombre))
                except OSError:
                    pass
        self.minutos = [a for a in self.minutos if a["t"] >= ahora - RETENCION_MINUTOS]
        if ahora - self.ultimo_recorte >= 86400:
            self.recortar_historico(carpeta, ahora)

    def recortar_historico(self, carpeta, ahora):
        """Quita de historico.jsonl lo anterior a historial_dias (y las lineas rotas):
        reescritura atomica, solo si hay algo que quitar."""
        limite = ahora - int(self.dias) * 86400
        archivo = os.path.join(carpeta, "historico.jsonl")
        docs = leer_jsonl(archivo)

        def vigente(d):
            h = hueco_valido(d)
            if h:
                return h[1] >= limite
            a = agregado_valido(d)
            return a is not None and a["t"] >= limite

        quedan = [d for d in docs if vigente(d)]
        if len(quedan) != len(docs) or self._lineas(archivo) != len(docs):
            reescribir_jsonl(archivo, quedan)
        self.cuartos = [a for a in self.cuartos if a["t"] >= limite]
        self.huecos = [h for h in self.huecos if h[1] >= limite]
        self.ultimo_recorte = ahora

    @staticmethod
    def _lineas(archivo):
        try:
            with open(archivo, "rb") as f:
                return sum(1 for l in f if l.strip())
        except OSError:
            return 0

    def cargar(self):
        """Lee lo que hay en disco y, si el ultimo dato es antiguo, anota el hueco hasta ahora."""
        ahora = self.reloj()
        carpeta = self._carpeta()
        minutos, cuartos, huecos = [], [], set()
        limite_h = ahora - int(self.dias) * 86400
        for nombre in sorted(os.listdir(carpeta)):
            if not re.fullmatch(r"\d{4}-\d{2}-\d{2}\.jsonl", nombre):
                continue
            for d in leer_jsonl(os.path.join(carpeta, nombre)):
                h = hueco_valido(d)
                if h:
                    if h[1] >= limite_h:
                        huecos.add(tuple(h))
                    continue
                a = agregado_valido(d)
                if a and a["t"] >= ahora - RETENCION_MINUTOS:
                    minutos.append(a)
        for d in leer_jsonl(os.path.join(carpeta, "historico.jsonl")):
            h = hueco_valido(d)
            if h:
                if h[1] >= limite_h:
                    huecos.add(tuple(h))
                continue
            a = agregado_valido(d)
            if a and a["t"] >= limite_h:
                a.pop("eventos", None)
                cuartos.append(a)
        self.minutos = fusionar_duplicados(minutos)
        self.cuartos = fusionar_duplicados(cuartos)
        self.huecos = [list(h) for h in sorted(huecos)]
        ultimo = None
        if self.minutos:
            # La ultima muestra real si se conoce; si no (datos antiguos), el final del minuto.
            ultimo = max(m.get("u", m["t"] + 60) for m in self.minutos[-2:])
        elif self.cuartos:
            ultimo = self.cuartos[-1]["t"] + 900
        if ultimo is not None and ahora - ultimo > FACTOR_HUECO * INTERVALO_NORMAL:
            self._hueco(ultimo, ahora)

    # -- consulta ------------------------------------------------------------
    def _minuto_en_curso(self):
        return combinar([pseudo_agregado(m) for m in self.actual], self.actual_t) if self.actual else None

    def disponibilidad(self, anillo, ahora):
        def cubre(ventana, minimo):
            ts = [m["t"] for m in anillo if m["t"] >= ahora - ventana]
            return bool(ts) and max(ts) - min(ts) >= minimo

        return {"5m": cubre(300, 60), "1h": cubre(3600, 300),
                "24h": sum(1 for a in self.minutos if a["t"] >= ahora - 86400) >= 60,
                "historia": len(self.cuartos) >= 2 and self.cuartos[-1]["t"] - self.cuartos[0]["t"] >= 86400}

    def serie(self, rango, anillo, ahora):
        """Respuesta de la orden 'serie' (ver docs/control-center.md)."""
        disp = self.disponibilidad(anillo, ahora)
        if rango not in disp:
            return {"ok": False, "error": "rango no válido", "disponible": disp}
        if not disp[rango]:
            return {"ok": False, "error": "sin datos suficientes", "disponible": disp}
        solo_med = rango in ("5m", "1h")
        if solo_med:
            desde = ahora - RANGOS[rango]
            puntos = [pseudo_agregado(m) for m in anillo if m["t"] >= desde]
            difs = sorted(b["t"] - a["t"] for a, b in zip(puntos, puntos[1:]) if b["t"] > a["t"])
            resolucion = max(1, int(round(difs[len(difs) // 2]))) if difs else INTERVALO_NORMAL
        elif rango == "24h":
            desde, resolucion = ahora - 86400, 60
            puntos = [a for a in self.minutos if a["t"] >= desde]
            actual = self._minuto_en_curso()
            if actual:
                if puntos and puntos[-1]["t"] == actual["t"]:
                    puntos[-1] = combinar([puntos[-1], actual], actual["t"])
                else:
                    puntos.append(actual)
        else:
            puntos, resolucion = list(self.cuartos), 900
            desde = puntos[0]["t"]
        puntos, resolucion = reducir(puntos, resolucion)
        metricas = {}
        for k in METRICAS:
            col = [p.get(k) for p in puntos]
            if solo_med:
                metricas[k] = {"med": [c[1] if c else None for c in col]}
            else:
                metricas[k] = {"min": [c[0] if c else None for c in col],
                               "med": [c[1] if c else None for c in col],
                               "max": [c[2] if c else None for c in col]}
        huecos = [[max(a, int(desde)), min(b, int(ahora))] for a, b in self.huecos
                  if b > desde and a < ahora]
        vistos = {}
        fuentes = list(self.eventos) + [e for a in (self.minutos if rango != "historia" else [])
                                        for e in a.get("eventos", [])]
        for e in fuentes:
            if desde <= e["t"] <= ahora:
                vistos[(e["t"], e.get("tipo"), e.get("texto"))] = e
        eventos = [vistos[k] for k in sorted(vistos, key=lambda k: (k[0], str(k[1]), str(k[2])))]
        return {"ok": True, "v": VERSION_DATOS, "rango": rango, "resolucion": resolucion,
                "desde": int(desde), "hasta": int(ahora), "metricas": metricas,
                "t": [p["t"] for p in puntos], "huecos": huecos, "eventos": eventos, "disponible": disp}


# ---------------------------------------------------------------------------
# Eventos de actividad (marcadores de las graficas)
# ---------------------------------------------------------------------------

def nuevo_evento(t, tipo, gravedad, texto, proceso=None, origen=None):
    """Evento de las graficas. 'origen' (usuario|regla|inicio) solo lo llevan los cambios de perfil."""
    ev = {"t": int(t), "tipo": tipo, "gravedad": gravedad, "texto": texto, "proceso": proceso}
    if origen:
        ev["origen"] = origen
    return ev


class Detector:
    """Detecta picos de CPU y RAM y saltos de temperatura entre muestras consecutivas."""

    def __init__(self):
        self.cpu_altas, self.pico_cpu, self.pico_ram = 0, False, False
        self.temp_previa, self.t_previa = None, None

    def procesar(self, inst):
        eventos = []
        t = int(inst["t"])
        cpu = (inst.get("cpu") or {}).get("total")
        if cpu is not None:
            if cpu >= UMBRAL_PICO_CPU:
                self.cpu_altas += 1
                if self.cpu_altas >= MUESTRAS_PICO_CPU and not self.pico_cpu:
                    self.pico_cpu = True
                    top = next(iter(inst.get("procesos") or []), None)
                    proceso = {"nombre": top["nombre"], "cpu": top["cpu"]} if top else None
                    texto = f"Pico de CPU al {cpu:.0f} %" + (f" ({top['nombre']}, {top['cpu']:.0f} %)" if top else "")
                    eventos.append(nuevo_evento(t, "pico_cpu", "WARNING", texto, proceso))
            else:
                self.cpu_altas, self.pico_cpu = 0, False
        ram = inst.get("ram") or {}
        if ram.get("total"):
            pct = 100.0 * ram["usada"] / ram["total"]
            if pct >= UMBRAL_PICO_RAM:
                if not self.pico_ram:
                    self.pico_ram = True
                    eventos.append(nuevo_evento(t, "pico_ram", "WARNING", f"Pico de RAM al {pct:.0f} %"))
            elif pct < UMBRAL_PICO_RAM - 5:
                self.pico_ram = False
        temp = (inst.get("cpu") or {}).get("temp")
        if temp is not None:
            if (self.temp_previa is not None and temp - self.temp_previa >= SALTO_TEMPERATURA
                    and t - self.t_previa <= 10):
                eventos.append(nuevo_evento(
                    t, "salto_temp", "WARNING",
                    f"Salto de temperatura: {self.temp_previa:.0f} → {temp:.0f} °C"))
            self.temp_previa, self.t_previa = temp, t
        return eventos


# ---------------------------------------------------------------------------
# Incidencias: condicion sostenida durante varias muestras
# ---------------------------------------------------------------------------

LENTOS = ("systemd", "smart")       # vienen del refresco lento: una muestra basta
NOMBRES_COMPONENTE = {
    "cpu-temp": "temperatura de la CPU", "gpu": "temperatura de la GPU", "disco": "espacio en disco",
    "bateria": "nivel de batería", "ram": "memoria disponible", "swap": "uso de swap",
    "presion": "presión de memoria", "systemd": "unidades de systemd", "smart": "salud del disco (SMART)",
}


def condiciones(inst, u):
    """{componente: (gravedad, valor, detalle)} de un instante; solo lo que tiene dato. La
    gravedad es NORMAL, WARNING o CRITICAL. Distinta de evaluar(): separa cpu-temp, gpu y
    presion, que son componentes de incidencia propios."""
    def grav(v, aviso, critico):
        return "CRITICAL" if v >= critico else ("WARNING" if v >= aviso else "NORMAL")

    c = {}
    temp = (inst.get("cpu") or {}).get("temp")
    if temp is not None:
        c["cpu-temp"] = (grav(temp, u["temp_aviso"], u["temp_critico"]), temp, None)
    gtemp = (inst.get("gpu") or {}).get("temp")
    if gtemp is not None:
        c["gpu"] = (grav(gtemp, u["temp_aviso"], u["temp_critico"]), gtemp, None)
    discos = [d for d in inst.get("disco") or [] if d.get("total")]
    if discos:
        peor = max(discos, key=lambda d: d["usado"] / d["total"])
        pct = 100.0 * peor["usado"] / peor["total"]
        c["disco"] = (grav(pct, u["disco_aviso"], u["disco_critico"]), round(pct, 1), peor["punto"])
    bat = inst.get("bateria")
    if bat and bat.get("nivel") is not None:
        if bat.get("estado") == "descargando":
            g = ("CRITICAL" if bat["nivel"] <= u["bateria_critico"]
                 else "WARNING" if bat["nivel"] <= u["bateria_aviso"] else "NORMAL")
        else:
            g = "NORMAL"
        c["bateria"] = (g, bat["nivel"], None)
    ram = inst.get("ram")
    if ram:
        if ram.get("total"):
            libre = 100.0 * (ram["total"] - ram["usada"]) / ram["total"]
            c["ram"] = ("CRITICAL" if libre < u["ram_libre_critico"] else "NORMAL", round(libre, 1), None)
        if ram.get("swap_total", 0) > 0:
            pct = 100.0 * ram["swap"] / ram["swap_total"]
            c["swap"] = ("WARNING" if pct > u["swap_aviso"] else "NORMAL", round(pct, 1), None)
        if ram.get("presion") is not None:
            c["presion"] = ("WARNING" if ram["presion"] > u["presion_aviso"] else "NORMAL", ram["presion"], None)
    if inst.get("fallidas") is not None:
        c["systemd"] = ("WARNING" if inst["fallidas"] else "NORMAL", list(inst["fallidas"]), None)
    if inst.get("smart") is not None:
        malos = [s["disco"] for s in inst["smart"] if s.get("estado") == "FALLO"]
        c["smart"] = ("CRITICAL" if malos else "NORMAL", malos, None)
    return c


def texto_incidencia(componente, gravedad, valor, detalle, u):
    """(descripcion, diagnostico, recomendacion) en espanol; prudentes y sin acciones automaticas."""
    critico = gravedad == "CRITICAL"
    if componente in ("cpu-temp", "gpu"):
        que = "la CPU" if componente == "cpu-temp" else "la GPU"
        umbral = u["temp_critico"] if critico else u["temp_aviso"]
        return (f"Temperatura de {que} a {valor:.0f} °C (umbral {umbral:.0f} °C)",
                "Temperatura sostenida por encima del umbral" + (
                    ": cerca del límite térmico, el equipo puede reducir su rendimiento" if critico else ""),
                "Comprueba qué proceso consume CPU (TOP PROCESSES) y que las rejillas de ventilación no estén tapadas"
                + ("; si sigue subiendo, guarda tu trabajo y apaga el equipo" if critico else ""))
    if componente == "disco":
        return (f"Disco {detalle} al {valor:.0f} %",
                "El espacio libre es muy escaso: algunas aplicaciones pueden fallar al guardar" if critico
                else "El espacio libre es escaso",
                "Libera espacio: revisa descargas, papelera y cachés, o mueve archivos grandes a otro disco")
    if componente == "bateria":
        return (f"Batería al {valor} %",
                "La batería se está agotando y el cargador no está conectado" + (
                    ": el equipo puede apagarse en breve" if critico else ""),
                "Conecta el cargador o activa el perfil de ahorro de energía" + (
                    "; guarda tu trabajo" if critico else ""))
    if componente == "ram":
        return (f"Memoria disponible al {valor:.0f} %",
                "Queda muy poca memoria libre: el sistema puede ir lento o cerrar procesos",
                "Cierra las aplicaciones que más memoria usan (TOP PROCESSES) o reinicia las que acumulan memoria")
    if componente == "swap":
        return (f"Swap usada al {valor:.0f} %",
                "El sistema está usando mucho el espacio de intercambio: suele indicar poca RAM para la carga actual",
                "Cierra aplicaciones pesadas (TOP PROCESSES); si es habitual, considera ampliar la RAM")
    if componente == "presion":
        return (f"Presión de memoria alta ({valor:.1f})",
                "Los procesos están esperando por memoria: el sistema puede notarse lento",
                "Cierra aplicaciones pesadas (TOP PROCESSES)")
    if componente == "systemd":
        lista = list(valor)
        return ("Unidades de systemd fallidas: " + ", ".join(lista[:3]) + ("…" if len(lista) > 3 else ""),
                "Hay servicios que han terminado con error",
                "Revisa el motivo con: systemctl --failed y journalctl -u UNIDAD")
    if componente == "smart":
        return ("El disco informa de un fallo SMART: " + ", ".join(valor),
                "El propio disco avisa de que podría fallar",
                "Haz una copia de seguridad de tus datos cuanto antes y valora sustituir el disco")
    return (f"{componente}: {gravedad}", "", "")


class Incidencias:
    """Abre, escala y cierra incidencias con histeresis: una condicion debe mantenerse
    MUESTRAS_INCIDENCIA muestras seguidas para abrirse y otras tantas en NORMAL para cerrarse
    (una sola para systemd y smart). Una muestra suelta no dispara nada."""

    def __init__(self):
        self.comp = {}

    def observar(self, inst, u, t):
        """Devuelve las lineas de incidencia nuevas (abrir, escalar, cerrar)."""
        lineas = []
        for nombre, (grav, valor, detalle) in condiciones(inst, u).items():
            c = self.comp.setdefault(nombre, {"abierta": "NORMAL", "ventana": []})
            n = 1 if nombre in LENTOS else MUESTRAS_INCIDENCIA
            c["ventana"].append(grav)
            del c["ventana"][:-n]
            v = c["ventana"]
            if len(v) < n:
                continue
            nueva = None
            if c["abierta"] == "NORMAL":
                if all(g != "NORMAL" for g in v):
                    nueva = "CRITICAL" if all(g == "CRITICAL" for g in v) else "WARNING"
            elif all(g == "NORMAL" for g in v):
                nueva = "NORMAL"
            elif c["abierta"] == "WARNING" and all(g == "CRITICAL" for g in v):
                nueva = "CRITICAL"
            elif c["abierta"] == "CRITICAL" and all(g != "CRITICAL" for g in v):
                c["abierta"], c["ventana"] = "WARNING", []      # baja de gravedad sin linea nueva
            if nueva is None:
                continue
            if nueva == "NORMAL":
                desc = "Recuperado: " + NOMBRES_COMPONENTE.get(nombre, nombre) + (f" ({detalle})" if detalle else "")
                diag = recom = ""
            else:
                desc, diag, recom = texto_incidencia(nombre, nueva, valor, detalle, u)
            lineas.append({"v": VERSION_DATOS, "t": int(t), "gravedad": nueva, "componente": nombre,
                           "descripcion": desc, "diagnostico": diag, "recomendacion": recom, "valor": valor})
            c["abierta"], c["ventana"] = nueva, []
        return lineas

    def abiertas(self):
        return [{"componente": k, "gravedad": c["abierta"]} for k, c in sorted(self.comp.items())
                if c["abierta"] != "NORMAL"]

    def restaurar(self, docs):
        """Al arrancar, recupera de incidencias.jsonl las que siguen abiertas (la ultima
        linea de cada componente). Asi un reinicio del servicio no vuelve a abrir, duplicada,
        una incidencia que ya estaba registrada."""
        for d in docs or []:
            nombre, grav = d.get("componente"), d.get("gravedad")
            if nombre and grav in ("NORMAL", "WARNING", "CRITICAL"):
                self.comp[nombre] = {"abierta": grav, "ventana": []}


# ---------------------------------------------------------------------------
# SMART (udisks2) y umbrales (jaime0-ajustes)
# ---------------------------------------------------------------------------

UDISKS = ("org.freedesktop.UDisks2", "/org/freedesktop/UDisks2")
IFACE_DRIVE = "org.freedesktop.UDisks2.Drive"
IFACE_ATA = "org.freedesktop.UDisks2.Drive.Ata"
IFACE_NVME = "org.freedesktop.UDisks2.NVMe.Controller"
AVISOS_NVME = {"spare": "Espacio de reserva por debajo del umbral",
               "temperature": "Temperatura fuera del rango seguro",
               "degraded": "Fiabilidad del disco degradada",
               "readonly": "El disco ha pasado a solo lectura",
               "volatile_memory": "Fallo de la memoria volátil del disco"}


def kelvin_a_celsius(k):
    try:
        k = float(k)
    except (TypeError, ValueError):
        return None
    return round(k - 273.15, 1) if k > 0 else None


def parsear_smart(objetos):
    """Lista de {"disco","tipo","estado","temperatura","horas","avisos"} a partir del
    resultado de GetManagedObjects ({ruta: {interfaz: {propiedad: valor}}}). Solo propiedades
    ya publicadas por udisks2: no se llama a SmartUpdate (necesitaria permisos)."""
    discos = []
    for ifaces in (objetos or {}).values():
        drive = ifaces.get(IFACE_DRIVE)
        nvme, ata = ifaces.get(IFACE_NVME), ifaces.get(IFACE_ATA)
        if drive is None or (nvme is None and ata is None):
            continue
        # Lectores de CD/DVD: udisks2 los publica como Drive.Ata, pero no son discos.
        compat = [str(c) for c in (drive.get("MediaCompatibility") or [])]
        if drive.get("Optical") or any(c.startswith("optical") for c in compat):
            continue
        modelo = str(drive.get("Model") or "").strip() or str(drive.get("Id") or "disco")
        if nvme is not None:
            avisos = [AVISOS_NVME.get(a, str(a)) for a in (nvme.get("SmartCriticalWarning") or [])]
            leido = bool(nvme.get("SmartUpdated"))
            estado = "FALLO" if avisos else ("OK" if leido else "N/D")
            horas = nvme.get("SmartPowerOnHours")
            discos.append({"disco": modelo, "tipo": "nvme", "estado": estado,
                           "temperatura": kelvin_a_celsius(nvme.get("SmartTemperature")) if leido else None,
                           "horas": int(horas) if leido and horas is not None else None, "avisos": avisos})
        else:
            leido = bool(ata.get("SmartUpdated"))
            avisos = []
            if ata.get("SmartFailing"):
                estado = "FALLO"
                avisos.append("El disco informa de un fallo inminente (SMART)")
            elif not ata.get("SmartSupported") or not ata.get("SmartEnabled"):
                estado = "N/D"
            else:
                estado = "OK" if leido else "N/D"
            segundos = ata.get("SmartPowerOnSeconds")
            discos.append({"disco": modelo, "tipo": "ata", "estado": estado,
                           "temperatura": kelvin_a_celsius(ata.get("SmartTemperature")) if leido else None,
                           "horas": int(segundos // 3600) if leido and segundos else None, "avisos": avisos})
    return sorted(discos, key=lambda d: d["disco"])


def programa_hermano(nombre):
    """Otro programa de Jaime0: junto a este archivo o en PATH."""
    junto = os.path.join(os.path.dirname(os.path.realpath(__file__)), nombre)
    return junto if os.path.exists(junto) else shutil.which(nombre)


def umbrales_desde_ajustes(doc):
    """UMBRALES con los valores de 'jaime0-ajustes ver --json'. Si algun par es incoherente
    (editado a mano) se queda con los de fabrica de ese par."""
    u = dict(UMBRALES)
    if not isinstance(doc, dict):
        return u
    leidos = {}
    for a in doc.get("ajustes") or []:
        if isinstance(a, dict) and a.get("clave") in AJUSTES_UMBRALES:
            try:
                leidos[AJUSTES_UMBRALES[a["clave"]]] = int(a["valor"])
            except (KeyError, TypeError, ValueError):
                pass
    for menor, mayor in (("temp_aviso", "temp_critico"), ("disco_aviso", "disco_critico"),
                         ("bateria_critico", "bateria_aviso")):
        if menor in leidos and mayor in leidos and not leidos[menor] < leidos[mayor]:
            del leidos[menor], leidos[mayor]
    for k, v in leidos.items():
        u[k] = float(v) if k.startswith(("temp", "disco")) else v
    return u


def cargar_umbrales(ejecutar=None):
    """Umbrales de jaime0-ajustes (subproceso con timeout de 5 s) o los de fabrica si falla."""
    ejecutar = ejecutar or subprocess.run
    try:
        programa = programa_hermano("jaime0-ajustes")
        if not programa:
            return dict(UMBRALES)
        r = ejecutar([sys.executable, "-I", programa, "ver", "--json"],
                     capture_output=True, text=True, timeout=5)
        return umbrales_desde_ajustes(json.loads(r.stdout) if r.returncode == 0 else None)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return dict(UMBRALES)


# ---------------------------------------------------------------------------
# Bus: D-Bus con Gio (python3-gi). Importacion perezosa: sin gi el resto sigue valiendo.
# ---------------------------------------------------------------------------

def _gi():
    import gi
    gi.require_version("GLib", "2.0")
    gi.require_version("Gio", "2.0")
    from gi.repository import GLib, Gio
    return GLib, Gio


SYSTEMD = ("org.freedesktop.systemd1", "/org/freedesktop/systemd1", "org.freedesktop.systemd1.Manager")
PPD = ("net.hadess.PowerProfiles", "/net/hadess/PowerProfiles")


def _llamar(con, destino, objeto, interfaz, metodo, params, cb):
    """Llamada asincrona; cb(resultado_desempaquetado | None)."""
    GLib, Gio = _gi()

    def listo(fuente, res, _datos):
        try:
            valor = fuente.call_finish(res).unpack()
        except Exception:
            valor = None
        try:
            cb(valor)
        except Exception:
            registrar("error en una respuesta de D-Bus:\n" + traceback.format_exc())

    con.call(destino, objeto, interfaz, metodo, params, None, Gio.DBusCallFlags.NONE, 3000, None, listo, None)


def consultar_fallidas(cb):
    """Unidades en estado failed del bus de sistema y del de sesion: cb(lista | None)."""
    GLib, Gio = _gi()
    resultados = {}

    def fin(tipo, valor):
        resultados[tipo] = None if valor is None else [u[0] for u in valor[0]]
        if len(resultados) == 2:
            listas = [r for r in resultados.values() if r is not None]
            cb(sorted(set(sum(listas, []))) if listas else None)

    for tipo in (Gio.BusType.SYSTEM, Gio.BusType.SESSION):
        try:
            con = Gio.bus_get_sync(tipo, None)
        except Exception:
            fin(tipo, None)
            continue
        _llamar(con, SYSTEMD[0], SYSTEMD[1], SYSTEMD[2], "ListUnitsFiltered",
                GLib.Variant("(as)", (["failed"],)), functools.partial(fin, tipo))


def consultar_unidad_activa(unidad, cb):
    """ActiveState == 'active' de una unidad del bus de sistema: cb(True|False|None)."""
    GLib, Gio = _gi()
    try:
        con = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
    except Exception:
        cb(None)
        return

    def tiene_objeto(valor):
        if not valor:
            cb(None)
            return
        _llamar(con, SYSTEMD[0], valor[0], "org.freedesktop.DBus.Properties", "Get",
                GLib.Variant("(ss)", ("org.freedesktop.systemd1.Unit", "ActiveState")),
                lambda v: cb(None if not v else v[0] == "active"))

    _llamar(con, SYSTEMD[0], SYSTEMD[1], SYSTEMD[2], "LoadUnit", GLib.Variant("(s)", (unidad,)), tiene_objeto)


def vigilar_perfil(cb):
    """Perfil activo de power-profiles-daemon: cb(valor | None) ahora y en cada cambio."""
    GLib, Gio = _gi()
    try:
        con = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
    except Exception:
        cb(None)
        return None

    def cambio(_con, _emisor, _objeto, _iface, _senal, params, _datos):
        try:
            _interfaz, cambiadas, _inval = params.unpack()
            if "ActiveProfile" in cambiadas:
                cb(cambiadas["ActiveProfile"])
        except Exception:
            registrar("error en PropertiesChanged:\n" + traceback.format_exc())

    suscripcion = con.signal_subscribe(PPD[0], "org.freedesktop.DBus.Properties", "PropertiesChanged",
                                       PPD[1], None, Gio.DBusSignalFlags.NONE, cambio, None)
    _llamar(con, PPD[0], PPD[1], "org.freedesktop.DBus.Properties", "Get",
            GLib.Variant("(ss)", (PPD[0], "ActiveProfile")), lambda v: cb(v[0] if v else None))
    return con, suscripcion


def consultar_smart(cb):
    """SMART de todos los discos por udisks2 (asincrono, solo lectura): cb(lista | None).
    None si udisks2 no responde."""
    GLib, Gio = _gi()
    try:
        con = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
    except Exception:
        cb(None)
        return

    def respuesta(valor):
        try:
            cb(None if valor is None else parsear_smart(valor[0]))
        except Exception:
            registrar("error al leer SMART:\n" + traceback.format_exc())
            cb(None)

    _llamar(con, UDISKS[0], UDISKS[1], "org.freedesktop.DBus.ObjectManager", "GetManagedObjects",
            None, respuesta)


def vigilar_suspension(cb):
    """PrepareForSleep de logind: cb(True) antes de suspender, cb(False) al reanudar."""
    GLib, Gio = _gi()
    try:
        con = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
    except Exception:
        return None

    def senal(_con, _emisor, _objeto, _iface, _senal, params, _datos):
        try:
            cb(bool(params.unpack()[0]))
        except Exception:
            registrar("error en PrepareForSleep:\n" + traceback.format_exc())

    return con, con.signal_subscribe("org.freedesktop.login1", "org.freedesktop.login1.Manager",
                                     "PrepareForSleep", "/org/freedesktop/login1", None,
                                     Gio.DBusSignalFlags.NONE, senal, None)


def vigilar_archivos(rutas, cb):
    """Llama a cb() cuando cambia alguno de los archivos (Gio.FileMonitor). Devuelve los
    monitores, que hay que conservar vivos."""
    GLib, Gio = _gi()
    monitores = []
    for r in rutas:
        try:
            m = Gio.File.new_for_path(r).monitor_file(Gio.FileMonitorFlags.WATCH_MOVES, None)
            m.connect("changed", lambda *_a: cb())
            monitores.append(m)
        except Exception:
            registrar(f"no se pudo vigilar {r}:\n" + traceback.format_exc())
    return monitores


def avisar_barra():
    """Pide a Waybar que relea el indicador (RTMIN+11). Solo si lleva unos segundos en
    marcha: al arrancar aun no atiende la senal y una senal RTMIN sin atender la cerraria."""
    if modo_prueba() or not shutil.which("pgrep"):
        return
    r = subprocess.run(["pgrep", "-x", "-u", str(os.getuid()), "waybar"],
                       capture_output=True, text=True, timeout=3)
    try:
        with open("/proc/uptime", encoding="ascii") as f:
            uptime = float(f.read().split()[0])
        for pid in r.stdout.split():
            with open(f"/proc/{pid}/stat", encoding="ascii") as f:
                inicio = int(f.read().rsplit(")", 1)[1].split()[19]) / os.sysconf("SC_CLK_TCK")
            if uptime - inicio < 3:
                return
    except (OSError, ValueError, IndexError):
        return
    if r.stdout.split():
        subprocess.run(["pkill", f"-RTMIN+{SENAL_BARRA}", "-x", "-u", str(os.getuid()), "waybar"], timeout=3)


# ---------------------------------------------------------------------------
# Perfiles (Fase 4): capa de sesion sobre los ajustes. Un perfil declara el estado completo
# de lo que gestiona; lo que no menciona es "base" (como estaba antes de que un perfil lo
# tocara). Modulo propio: no depende de la salud ni de la API; todo lo que toca el sistema
# pasa por un objeto "sistema" (SistemaReal, o uno falso en las pruebas).
# ---------------------------------------------------------------------------

AJUSTES_PERFIL = ("energia", "animaciones", "desenfoque", "no_molestar", "inhibir_inactividad", "modo_noche")
TRI = ("si", "no", "base")
VALORES_AJUSTE = {"energia": ("balanced", "performance", "power-saver"),
                  "animaciones": TRI, "desenfoque": TRI, "no_molestar": TRI, "modo_noche": TRI,
                  "inhibir_inactividad": ("si", "no")}
CAPA_CLAVES = ("animaciones", "desenfoque")     # unicas claves que Hyprland lee de la capa
PERFILES = (
    {"id": "balanced", "nombre": "BALANCED", "ajustes": {},
     "descripcion": "Equilibrio entre rendimiento y consumo. Deja todo como lo tienes configurado."},
    {"id": "performance", "nombre": "PERFORMANCE", "ajustes": {"energia": "performance"},
     "descripcion": "Prioriza el rendimiento con el perfil de energía de alto rendimiento. "
                    "No toca servicios ni el núcleo."},
    {"id": "power-saver", "nombre": "POWER SAVER",
     "ajustes": {"energia": "power-saver", "animaciones": "no", "desenfoque": "no"},
     "descripcion": "Reduce el consumo: perfil de ahorro, sin animaciones ni desenfoque."},
    {"id": "focus", "nombre": "FOCUS", "ajustes": {"no_molestar": "si"},
     "descripcion": "Menos distracciones: no molestar activado (las notificaciones se guardan "
                    "en el centro sin aparecer)."},
    {"id": "multimedia", "nombre": "MULTIMEDIA", "ajustes": {"inhibir_inactividad": "si", "no_molestar": "si"},
     "descripcion": "Para ver vídeo o escuchar música: la pantalla no se bloquea ni se apaga y no "
                    "hay interrupciones."},
)
PERFIL_CUSTOM = {"id": "custom", "nombre": "CUSTOM",
                 "descripcion": "Tu propia combinación: eliges qué cambia (EDITAR CUSTOM en PROFILES "
                                "o jaime0-perfil personalizado)."}
PERFIL_BASE = "balanced"
ORIGENES = ("usuario", "regla", "inicio")


def normalizar_perfil(texto):
    """'POWER SAVER', 'Power_Saver' y 'power-saver' son el mismo id."""
    return re.sub(r"[\s_]+", "-", str(texto).strip().lower())


def validar_ajustes(doc):
    """(ajustes, error): estricta. Solo claves y valores conocidos; error en espanol o None."""
    if not isinstance(doc, dict):
        return {}, "los ajustes deben ser un objeto"
    limpio = {}
    for clave, valor in doc.items():
        if clave not in VALORES_AJUSTE:
            return {}, f"ajuste desconocido: {clave}"
        if not isinstance(valor, str) or valor not in VALORES_AJUSTE[clave]:
            return {}, f"valor no válido para {clave}: {valor!r} (admitidos: {', '.join(VALORES_AJUSTE[clave])})"
        limpio[clave] = valor
    return limpio, None


def textos_cambios(aj):
    """Lo que aplica un perfil, legible; lo que esta en base no aparece."""
    t = []
    if "energia" in aj:
        t.append("Energía: " + {"balanced": "equilibrado", "performance": "rendimiento",
                                "power-saver": "ahorro"}[aj["energia"]])
    for clave, etiqueta, si, no in (("animaciones", "Animaciones", "activadas", "desactivadas"),
                                    ("desenfoque", "Desenfoque", "activado", "desactivado")):
        if aj.get(clave) in ("si", "no"):
            t.append(f"{etiqueta}: {si if aj[clave] == 'si' else no}")
    if aj.get("no_molestar") in ("si", "no"):
        t.append("No molestar: " + ("activado" if aj["no_molestar"] == "si" else "desactivado"))
    if "inhibir_inactividad" in aj:
        t.append("Inactividad: se evita el bloqueo y el apagado de pantalla" if aj["inhibir_inactividad"] == "si"
                 else "Inactividad: sin inhibir")
    if aj.get("modo_noche") in ("si", "no"):
        t.append("Modo noche: " + ("activado" if aj["modo_noche"] == "si" else "desactivado"))
    return t


class SistemaReal:
    """Lo que el motor de perfiles toca de verdad: ppd y logind por D-Bus (bus de sistema,
    llamadas sincronas con timeout de 3 s), swaync-client, hyprctl y modo-noche como
    subprocesos. `ejecutar` sustituye a subprocess.run en las pruebas."""

    def __init__(self, ejecutar=None):
        self.ejecutar = ejecutar or subprocess.run

    # -- subprocesos ---------------------------------------------------------
    def _correr(self, orden, timeout):
        try:
            return self.ejecutar(orden, capture_output=True, text=True, timeout=timeout)
        except subprocess.TimeoutExpired:
            raise OSError(f"{os.path.basename(orden[0])} no responde")

    # -- D-Bus ---------------------------------------------------------------
    def _llamada(self, destino, objeto, interfaz, metodo, params):
        GLib, Gio = _gi()
        con = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        return con.call_sync(destino, objeto, interfaz, metodo, params, None, Gio.DBusCallFlags.NONE, 3000, None)

    def _propiedad(self, destino, objeto, interfaz, nombre):
        GLib, _Gio = _gi()
        r = self._llamada(destino, objeto, "org.freedesktop.DBus.Properties", "Get",
                          GLib.Variant("(ss)", (interfaz, nombre)))
        return r.unpack()[0]

    # -- power-profiles-daemon -----------------------------------------------
    def ppd_perfiles(self):
        """Nombres de perfil que ofrece ppd, o None si no responde."""
        try:
            return [str(d["Profile"]) for d in self._propiedad(PPD[0], PPD[1], PPD[0], "Profiles") if "Profile" in d]
        except Exception:
            return None

    def ppd_degradado(self):
        try:
            return str(self._propiedad(PPD[0], PPD[1], PPD[0], "PerformanceDegraded") or "") or None
        except Exception:
            return None

    def ppd_retener(self, perfil):
        GLib, _Gio = _gi()
        return self._llamada(PPD[0], PPD[1], PPD[0], "HoldProfile",
                             GLib.Variant("(sss)", (perfil, "Perfil de Jaime0", "jaime0"))).unpack()[0]

    def ppd_liberar(self, cookie):
        GLib, _Gio = _gi()
        self._llamada(PPD[0], PPD[1], PPD[0], "ReleaseProfile", GLib.Variant("(u)", (int(cookie),)))

    # -- logind --------------------------------------------------------------
    def inhibir_disponible(self):
        try:
            self._propiedad("org.freedesktop.login1", "/org/freedesktop/login1",
                            "org.freedesktop.login1.Manager", "BlockInhibited")
            return True
        except Exception:
            return False

    def inhibir_abrir(self, motivo):
        """Descriptor del inhibidor 'idle'; hay que mantenerlo abierto."""
        GLib, Gio = _gi()
        con = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        r, fds = con.call_with_unix_fd_list_sync(
            "org.freedesktop.login1", "/org/freedesktop/login1", "org.freedesktop.login1.Manager", "Inhibit",
            GLib.Variant("(ssss)", ("idle", "Jaime0", motivo, "block")), GLib.VariantType("(h)"),
            Gio.DBusCallFlags.NONE, 3000, None, None)
        return fds.get(r.unpack()[0])

    def inhibir_cerrar(self, fd):
        os.close(fd)

    # -- swaync --------------------------------------------------------------
    def dnd_disponible(self):
        return shutil.which("swaync-client") is not None

    def dnd_leer(self):
        r = self._correr(["swaync-client", "--get-dnd", "--skip-wait"], 3)
        valor = (r.stdout or "").strip().lower()
        if r.returncode != 0 or valor not in ("true", "false"):
            raise OSError("swaync no responde")
        return valor == "true"

    def dnd_poner(self, activo):
        r = self._correr(["swaync-client", "--dnd-on" if activo else "--dnd-off", "--skip-wait"], 3)
        if r.returncode != 0:
            raise OSError("swaync no ha aceptado el cambio")

    # -- Hyprland ------------------------------------------------------------
    def hypr_disponible(self):
        return bool(os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")) and shutil.which("hyprctl") is not None

    def hypr_recargar(self):
        r = self._correr(["hyprctl", "reload"], 5)
        if r.returncode != 0:
            raise OSError("hyprctl reload ha fallado")

    # -- modo noche ----------------------------------------------------------
    def noche_disponible(self):
        return programa_hermano("modo-noche") is not None and shutil.which("hyprsunset") is not None

    def noche_leer(self):
        programa = programa_hermano("modo-noche")
        if not programa:
            raise OSError("modo-noche no está instalado")
        valor = (self._correr([programa, "estado"], 3).stdout or "").strip()
        if valor not in ("encendido", "apagado"):
            raise OSError("modo-noche no informa de su estado")
        return valor == "encendido"

    def noche_poner(self, activo):
        programa = programa_hermano("modo-noche")
        if not programa:
            raise OSError("modo-noche no está instalado")
        if self._correr([programa, "encender" if activo else "apagar"], 5).returncode != 0:
            raise OSError("modo-noche no ha aceptado el cambio")

    # -- capacidades ---------------------------------------------------------
    def capacidades(self):
        ppd = self.ppd_perfiles()
        return {"energia": [p for p in (ppd or []) if p in VALORES_AJUSTE["energia"]],
                "ppd": ppd is not None,
                "no_molestar": self.dnd_disponible(),
                "animaciones": self.hypr_disponible(),
                "inhibir_inactividad": self.inhibir_disponible(),
                "modo_noche": self.noche_disponible()}


class MotorPerfiles:
    """Perfil activo, instantaneas por ajuste y aplicadores. Un solo hilo (el bucle de GLib)."""

    def __init__(self, sistema, dir_ejecucion, dir_estado, archivo_custom, evento=None, notificar=None):
        self.sistema = sistema
        self.dir_ejecucion = dir_ejecucion      # donde vive perfil.ajustes (tmpfs)
        self.dir_estado = dir_estado            # callable -> ~/.local/state/jaime0
        self.archivo_custom = archivo_custom    # callable -> ~/.config/jaime0/perfil-personalizado.json
        self.evento = evento or (lambda *a, **k: None)
        self.notificar = notificar or (lambda: None)
        self.activo = self.anterior = self.origen = None
        self.fallos = []
        self.cookie = self.retencion = None
        self.inhibidor = self.inhibidor_nombre = None
        self.degradado = None
        self.capa_sin_recargar = False
        self.instantaneas = {}                  # {"no_molestar": bool, "modo_noche": bool}
        self._cargar_instantaneas()

    # -- definiciones --------------------------------------------------------
    def personalizado(self):
        """(ajustes, error) de perfil-personalizado.json; sin archivo = todo base, sin error."""
        try:
            with open(self.archivo_custom(), encoding="utf-8") as f:
                doc = json.load(f)
        except FileNotFoundError:
            return {}, None
        except (OSError, ValueError) as e:
            return {}, f"no se pudo leer el perfil personalizado: {e}"
        if not isinstance(doc, dict) or doc.get("v") != 1 or not isinstance(doc.get("ajustes"), dict):
            return {}, "el perfil personalizado no tiene el formato esperado"
        aj, error = validar_ajustes(doc["ajustes"])
        return aj, (f"el perfil personalizado no es válido: {error}" if error else None)

    def definiciones(self):
        aj, error = self.personalizado()
        d = [dict(p, error=None) for p in PERFILES]
        d.append(dict(PERFIL_CUSTOM, ajustes=aj, error=error))
        return d

    def buscar(self, texto):
        return next((d for d in self.definiciones() if d["id"] == normalizar_perfil(texto)), None)

    # -- disponibilidad ------------------------------------------------------
    @staticmethod
    def motivo_no_disponible(aj, caps):
        motivos = []
        e = aj.get("energia", "balanced")
        if e != "balanced":
            if not caps.get("ppd"):
                motivos.append("power-profiles-daemon no está disponible")
            elif e not in caps["energia"]:
                motivos.append("este equipo no ofrece el perfil de energía "
                               + ("de alto rendimiento" if e == "performance" else "de ahorro"))
        if any(aj.get(k) in ("si", "no") for k in CAPA_CLAVES) and not caps.get("animaciones"):
            motivos.append("Hyprland no está disponible (animaciones y desenfoque)")
        if aj.get("no_molestar") in ("si", "no") and not caps.get("no_molestar"):
            motivos.append("swaync no está instalado (no molestar)")
        if aj.get("inhibir_inactividad") == "si" and not caps.get("inhibir_inactividad"):
            motivos.append("logind no responde (inhibir inactividad)")
        if aj.get("modo_noche") in ("si", "no") and not caps.get("modo_noche"):
            motivos.append("no hay modo noche (falta hyprsunset)")
        return "; ".join(motivos) or None

    def perfiles_doc(self):
        caps = self.sistema.capacidades()
        perfiles = []
        for d in self.definiciones():
            motivo = self.motivo_no_disponible(d["ajustes"], caps)
            perfiles.append({"id": d["id"], "nombre": d["nombre"], "descripcion": d["descripcion"],
                             "cambios": textos_cambios(d["ajustes"]), "ajustes": dict(d["ajustes"]),
                             "disponible": motivo is None, "motivo": motivo})
        aj, error = self.personalizado()
        return {"ok": True, "v": VERSION_DATOS, "activo": self.activo, "anterior": self.anterior,
                "perfiles": perfiles,
                "capacidades": {k: caps[k] for k in ("energia", "no_molestar", "animaciones",
                                                     "inhibir_inactividad", "modo_noche")},
                "personalizado": {"ajustes": aj, "error": error}}

    # -- instantaneas (de sesion, en el directorio de ejecucion) ---------------
    def _archivo_instantaneas(self):
        return os.path.join(self.dir_ejecucion, "perfil-instantaneas.json")

    def _cargar_instantaneas(self):
        try:
            with open(self._archivo_instantaneas(), encoding="utf-8") as f:
                doc = json.load(f)
            ajustes = doc.get("ajustes") if isinstance(doc, dict) else None
            if isinstance(ajustes, dict):
                self.instantaneas = {k: v for k, v in ajustes.items()
                                     if k in ("no_molestar", "modo_noche") and isinstance(v, bool)}
        except (OSError, ValueError):
            pass

    def _guardar_instantaneas(self):
        try:
            if self.instantaneas:
                escribir_json(self._archivo_instantaneas(), {"v": VERSION_DATOS, "ajustes": self.instantaneas})
            elif os.path.exists(self._archivo_instantaneas()):
                os.remove(self._archivo_instantaneas())
        except OSError:
            registrar("no se pudieron guardar las instantáneas del perfil:\n" + traceback.format_exc())

    # -- aplicadores ---------------------------------------------------------
    def _liberar_energia(self):
        cookie, self.cookie, self.retencion = self.cookie, None, None
        if cookie is not None:
            try:
                self.sistema.ppd_liberar(cookie)
            except Exception:
                registrar("no se pudo liberar la retención de energía:\n" + traceback.format_exc())

    def _ap_energia(self, valor):
        if valor == "balanced":
            self._liberar_energia()
        elif self.cookie is None or self.retencion != valor:
            self._liberar_energia()         # una sola retencion a la vez
            self.cookie = self.sistema.ppd_retener(valor)
            self.retencion = valor

    def _ap_capa(self, aj):
        deseado = [(k, aj[k]) for k in CAPA_CLAVES if aj.get(k) in ("si", "no")]
        if deseado and not self.sistema.hypr_disponible():
            raise OSError("Hyprland no está disponible")
        archivo = os.path.join(self.dir_ejecucion, "perfil.ajustes")
        nuevo = "".join(f"{k} = {v}\n" for k, v in deseado) or None
        try:
            with open(archivo, encoding="utf-8") as f:
                actual = f.read()
        except OSError:
            actual = None
        if nuevo == actual and not self.capa_sin_recargar:
            return
        if nuevo is None:
            try:
                os.remove(archivo)
            except OSError:
                pass
        else:
            tmp = archivo + ".tmp"
            with open(tmp, "w", encoding="utf-8", newline="\n") as f:
                f.write(nuevo)
            os.replace(tmp, archivo)
        self.capa_sin_recargar = True
        if self.sistema.hypr_disponible():
            self.sistema.hypr_recargar()
        elif deseado:
            raise OSError("no se pudo recargar Hyprland")
        self.capa_sin_recargar = False

    def _ap_tri(self, clave, valor, leer, poner):
        """Ajuste si/no/base con instantanea del valor real previo."""
        if valor == "base":
            if clave in self.instantaneas:
                previo = self.instantaneas[clave]
                if leer() != previo:
                    poner(previo)
                del self.instantaneas[clave]        # solo si se restauro (si falla, se conserva)
                self._guardar_instantaneas()
            return
        quiero = valor == "si"
        creada = clave not in self.instantaneas
        actual = leer()
        if creada:
            self.instantaneas[clave] = actual
        try:
            if actual != quiero:
                poner(quiero)
        except Exception:
            if creada:
                del self.instantaneas[clave]        # no cambio nada: sin instantanea incoherente
            raise
        if creada:
            self._guardar_instantaneas()

    def _ap_inhibir(self, valor, nombre):
        if valor == "si":
            if self.inhibidor is not None and self.inhibidor_nombre == nombre:
                return
            nuevo = self.sistema.inhibir_abrir(f"Perfil {nombre}: sin bloqueo ni apagado de pantalla")
            self._cerrar_inhibidor()
            self.inhibidor, self.inhibidor_nombre = nuevo, nombre
        else:
            self._cerrar_inhibidor()

    def _cerrar_inhibidor(self):
        fd, self.inhibidor, self.inhibidor_nombre = self.inhibidor, None, None
        if fd is not None:
            try:
                self.sistema.inhibir_cerrar(fd)
            except Exception:
                registrar("no se pudo cerrar el inhibidor:\n" + traceback.format_exc())

    # -- aplicar -------------------------------------------------------------
    def aplicar(self, pid, origen="usuario", persistir=True):
        d = self.buscar(pid)
        if d is None:
            return {"ok": False, "error": f"perfil desconocido: {pid}"}
        aj = d["ajustes"]
        motivo = self.motivo_no_disponible(aj, self.sistema.capacidades())
        if motivo:
            return {"ok": False, "error": f"El perfil {d['nombre']} no está disponible: {motivo}"}
        fallos = [d["error"]] if d["error"] else []
        s = self.sistema
        pasos = (("Energía", lambda: self._ap_energia(aj.get("energia", "balanced"))),
                 ("Animaciones y desenfoque", lambda: self._ap_capa(aj)),
                 ("No molestar", lambda: self._ap_tri("no_molestar", aj.get("no_molestar", "base"),
                                                      s.dnd_leer, s.dnd_poner)),
                 ("Inactividad", lambda: self._ap_inhibir(aj.get("inhibir_inactividad", "no"), d["nombre"])),
                 ("Modo noche", lambda: self._ap_tri("modo_noche", aj.get("modo_noche", "base"),
                                                     s.noche_leer, s.noche_poner)))
        for etiqueta, paso in pasos:
            try:
                paso()
            except Exception as e:
                registrar(f"error al aplicar {etiqueta}:\n" + traceback.format_exc())
                fallos.append(f"{etiqueta}: {e or type(e).__name__}")
        cambia = d["id"] != self.activo
        if origen != "inicio" and cambia:
            self.anterior = self.activo
        self.activo, self.origen, self.fallos = d["id"], origen, fallos
        if persistir:
            self.guardar()
        if cambia or origen == "inicio":
            self.evento(f"Perfil: {d['nombre']}", "perfil", "INFO", None, origen)
        self.notificar()
        return {"ok": True, "activo": d["id"], "nombre": d["nombre"], "fallos": list(fallos)}

    def aplicar_anterior(self, origen="usuario"):
        if not self.anterior:
            return {"ok": False, "error": "no hay un perfil anterior"}
        return self.aplicar(self.anterior, origen)

    def guardar_personalizado(self, ajustes):
        """Valida y guarda CUSTOM; si esta activo, lo vuelve a aplicar."""
        aj, error = validar_ajustes(ajustes)
        if error:
            return {"ok": False, "error": error}
        try:
            archivo = self.archivo_custom()
            os.makedirs(os.path.dirname(archivo), exist_ok=True)
            escribir_json(archivo, {"v": VERSION_DATOS, "ajustes": aj})
        except OSError as e:
            return {"ok": False, "error": f"no se pudo guardar el perfil personalizado: {e}"}
        r = {"ok": True, "ajustes": aj, "fallos": []}
        if self.activo == "custom":
            ap = self.aplicar("custom", self.origen if self.origen in ("usuario", "regla") else "usuario")
            if not ap["ok"]:
                return {"ok": False, "error": "guardado, pero no se puede aplicar: " + ap["error"]}
            r["fallos"] = ap["fallos"]
        return r

    # -- persistencia y arranque ---------------------------------------------
    def _archivo_perfil(self):
        return os.path.join(self.dir_estado(), "perfil.json")

    def guardar(self):
        try:
            escribir_json(self._archivo_perfil(), {"v": VERSION_DATOS, "activo": self.activo,
                                                   "anterior": self.anterior})
        except OSError:
            registrar("no se pudo guardar perfil.json:\n" + traceback.format_exc())

    def iniciar(self):
        """Reaplica el perfil guardado; si no se puede, balanced y se anota el motivo."""
        ids = [p["id"] for p in PERFILES] + ["custom"]
        guardado, nota = None, None
        try:
            with open(self._archivo_perfil(), encoding="utf-8") as f:
                doc = json.load(f)
            if (isinstance(doc, dict) and doc.get("v") == 1 and doc.get("activo") in ids
                    and doc.get("anterior") in ids + [None]):
                guardado = doc["activo"]
                self.anterior = doc["anterior"]
            else:
                nota = "el perfil guardado no es válido"
        except FileNotFoundError:
            pass
        except (OSError, ValueError):
            nota = "no se pudo leer el perfil guardado"
        if guardado is not None:
            r = self.aplicar(guardado, "inicio")
            if r["ok"]:
                self.refrescar_degradado()
                return r
            nota = r["error"]
        r = self.aplicar(PERFIL_BASE, "inicio", persistir=nota is None)    # con motivo: no pisa lo guardado
        if nota:
            self.fallos.insert(0, nota)
            self.evento(f"Perfil guardado no aplicado: {nota}", "perfil", "WARNING", None, "inicio")
            self.notificar()
        self.refrescar_degradado()
        return r

    def refrescar_degradado(self):
        try:
            self.degradado = self.sistema.ppd_degradado()
        except Exception:
            self.degradado = None

    def doc_estado(self, energia):
        nombre = next((d["nombre"] for d in self.definiciones() if d["id"] == self.activo), None)
        return {"activo": self.activo, "nombre": nombre, "anterior": self.anterior, "origen": self.origen,
                "energia": energia, "retencion": self.retencion, "degradado": self.degradado,
                "fallos": list(self.fallos)}


# ---------------------------------------------------------------------------
# API: una linea JSON por peticion, una linea JSON por respuesta
# ---------------------------------------------------------------------------

def procesar_linea(linea, ctx):
    """Procesa una peticion y devuelve la respuesta como texto JSON (sin salto de linea).
    ctx ofrece rapido() -> (intervalo, hasta), estado_doc(), instante_doc(), serie(rango),
    incidencias(limite), eventos_lista() y perfiles (un MotorPerfiles)."""
    try:
        peticion = json.loads(linea)
    except ValueError:
        return json.dumps({"ok": False, "error": "JSON mal formado"})
    if not isinstance(peticion, dict):
        return json.dumps({"ok": False, "error": "petición no válida"})
    try:
        orden = peticion.get("orden")
        if orden == "rapido":
            intervalo, hasta = ctx.rapido()
            return json.dumps({"ok": True, "intervalo": intervalo, "hasta": hasta})
        if orden in ("estado", "instante"):
            doc = ctx.estado_doc() if orden == "estado" else ctx.instante_doc()
            if doc is None:
                return json.dumps({"ok": False, "error": "sin datos todavía"})
            return json.dumps(doc, ensure_ascii=False)
        if orden == "serie":
            return json.dumps(ctx.serie(peticion.get("rango")), ensure_ascii=False)
        if orden == "incidencias":
            limite = peticion.get("limite", 50)
            if not isinstance(limite, int) or isinstance(limite, bool) or limite < 1:
                limite = 50
            return json.dumps({"ok": True, "v": VERSION_DATOS,
                               "incidencias": ctx.incidencias(min(limite, MAX_INCIDENCIAS))},
                              ensure_ascii=False)
        if orden == "eventos":
            return json.dumps({"ok": True, "v": VERSION_DATOS, "eventos": ctx.eventos_lista()},
                              ensure_ascii=False)
        if orden == "perfiles":
            return json.dumps(ctx.perfiles.perfiles_doc(), ensure_ascii=False)
        if orden in ("perfil", "perfil_anterior"):
            origen = peticion.get("origen", "usuario")
            if origen not in ("usuario", "regla"):
                return json.dumps({"ok": False, "error": "origen no válido"})
            if orden == "perfil_anterior":
                return json.dumps(ctx.perfiles.aplicar_anterior(origen), ensure_ascii=False)
            if not isinstance(peticion.get("valor"), str):
                return json.dumps({"ok": False, "error": "falta el perfil"})
            return json.dumps(ctx.perfiles.aplicar(peticion["valor"], origen), ensure_ascii=False)
        if orden == "personalizado":
            return json.dumps(ctx.perfiles.guardar_personalizado(peticion.get("ajustes")), ensure_ascii=False)
        return json.dumps({"ok": False, "error": "orden desconocida"})
    except Exception:
        registrar("error al atender una orden:\n" + traceback.format_exc())
        return json.dumps({"ok": False, "error": "error interno"})


# ---------------------------------------------------------------------------
# Servicio: reune medicion, estado, bus y api
# ---------------------------------------------------------------------------

class Servicio:
    def __init__(self, directorio=None, estado=None, leer_umbrales=None, reloj=time.time, sistema=None):
        """directorio: de ejecucion (tmpfs); estado: de ~/.local/state/jaime0 (se crea al
        usarlo); leer_umbrales: funcion que devuelve los umbrales (por defecto
        cargar_umbrales, que llama a jaime0-ajustes); sistema: lo que tocan los perfiles
        (por defecto SistemaReal)."""
        self.dir = directorio or directorio_ejecucion()
        self._estado = estado
        self._leer_umbrales = leer_umbrales or cargar_umbrales
        self.reloj = reloj
        self.umbrales = dict(UMBRALES)
        self.muestreador = Muestreador()
        self.anillo = collections.deque(maxlen=TAMANO_ANILLO)
        self.actividad = collections.deque(maxlen=20)
        self.eventos = collections.deque(maxlen=MAX_EVENTOS)
        self.historico = Historico(self.carpeta_salud, reloj=reloj, eventos=self.eventos)
        self.detector = Detector()
        self.incidencias_estado = Incidencias()
        try:
            self.incidencias_estado.restaurar(leer_jsonl(self.archivo_incidencias()))
        except Exception:
            registrar("no se pudieron recuperar las incidencias abiertas:\n" + traceback.format_exc())
        self.n_incidencias = None
        self.smart = None
        self.gpu_temp = None
        self.instante = None
        self.estado = None
        self.motivos = []
        self.energia = None                 # ActiveProfile de power-profiles-daemon (solo lectura)
        self.perfiles = MotorPerfiles(sistema or SistemaReal(), self.dir, self.dir_estado,
                                      lambda: os.path.join(carpeta_config(), "perfil-personalizado.json"),
                                      evento=self.evento, notificar=self._perfil_cambiado)
        self.fallidas = None
        self.privacidad = resumen_privacidad(None)
        self.desde = int(time.time())
        self.rapido_hasta = 0.0
        self.clave_aviso = None
        self.previo_cargador = None
        self.evento("Servicio iniciado")
        # Lo siguiente solo se usa dentro del bucle de GLib
        self._fuente = None
        self._intervalo_programado = None
        self._servidor = None
        self._bucle = None
        self._monitores = []
        self._recarga_pendiente = False

    # -- estado y registro ---------------------------------------------------
    def dir_estado(self):
        if self._estado is None:
            self._estado = directorio_estado()
        os.makedirs(self._estado, mode=0o700, exist_ok=True)
        return self._estado

    def carpeta_salud(self):
        d = os.path.join(self.dir_estado(), "salud")
        os.makedirs(d, mode=0o700, exist_ok=True)
        return d

    def evento(self, texto, tipo=None, gravedad="INFO", proceso=None, origen=None):
        """Anota en la actividad y, si lleva tipo, tambien como evento para las graficas."""
        t = int(time.time())
        act = {"t": t, "texto": texto}
        if origen:
            act["origen"] = origen
        self.actividad.append(act)
        if tipo:
            self.eventos.append(nuevo_evento(t, tipo, gravedad, texto, proceso, origen))

    def recargar_umbrales(self):
        u = dict(UMBRALES)
        u.update(self._leer_umbrales() or {})
        self.umbrales = u
        self.historico.dias = int(u["historial_dias"])

    # -- incidencias (archivo) -------------------------------------------------
    def archivo_incidencias(self):
        return os.path.join(self.dir_estado(), "incidencias.jsonl")

    def anotar_incidencias(self, lineas):
        """Anexa las lineas a incidencias.jsonl y lo recorta a MAX_INCIDENCIAS."""
        if not lineas:
            return
        archivo = self.archivo_incidencias()
        anexar_jsonl(archivo, lineas)
        if self.n_incidencias is None:
            self.n_incidencias = len(leer_jsonl(archivo))
        else:
            self.n_incidencias += len(lineas)
        if self.n_incidencias > MAX_INCIDENCIAS:
            docs = leer_jsonl(archivo)[-MAX_INCIDENCIAS:]
            reescribir_jsonl(archivo, docs)
            self.n_incidencias = len(docs)

    # -- consultas de la API ---------------------------------------------------
    def serie(self, rango):
        return self.historico.serie(rango, self.anillo, self.reloj())

    def incidencias(self, limite):
        docs = [d for d in leer_jsonl(self.archivo_incidencias()) if "componente" in d]
        return docs[-limite:][::-1]

    def eventos_lista(self):
        return list(self.eventos)[::-1]

    def intervalo_actual(self):
        return INTERVALO_RAPIDO if time.time() < self.rapido_hasta else INTERVALO_NORMAL

    def rapido(self):
        self.rapido_hasta = time.time() + DURACION_RAPIDO
        if self._fuente is not None and self._intervalo_programado != INTERVALO_RAPIDO:
            self._programar()
        return INTERVALO_RAPIDO, int(self.rapido_hasta)

    def instante_doc(self):
        return self.instante

    def estado_doc(self):
        if self.estado is None:
            return None
        return {"v": VERSION_DATOS, "t": int(time.time()), "estado": self.estado, "motivos": self.motivos,
                "perfil": self.perfiles.doc_estado(self.energia),
                "privacidad": self.privacidad, "actividad": list(self.actividad),
                "incidencias_abiertas": self.incidencias_estado.abiertas(),
                "disponible": self.historico.disponibilidad(self.anillo, self.reloj()),
                "servicio": {"pid": os.getpid(), "desde": self.desde, "intervalo": self.intervalo_actual()}}

    # -- ciclo de medicion ---------------------------------------------------
    def muestrear(self):
        med = self.muestreador.muestrear()
        if med["gpu"]["nvidia"] != "activa":
            self.gpu_temp = None            # suspendida o sin GPU: sin temperatura, jamas se despierta
        med["gpu"]["temp"] = self.gpu_temp
        inst = armar_instante(med, time.time(), self.intervalo_actual(), self.fallidas, self.smart)
        estado, motivos = evaluar(inst, self.umbrales)
        inst["estado"], inst["alertas"] = estado, len(motivos)
        self.instante = inst
        muestra = anillo_agregar(self.anillo, inst)
        escribir_json(os.path.join(self.dir, "instante.json"), inst)
        self.publicar(estado, motivos)
        for ev in self.detector.procesar(inst):
            self.eventos.append(ev)
        self.historico.anadir(muestra, inst["intervalo"])
        try:
            self.anotar_incidencias(self.incidencias_estado.observar(inst, self.umbrales, inst["t"]))
        except OSError:
            registrar("no se pudo escribir incidencias.jsonl:\n" + traceback.format_exc())

    def publicar(self, estado, motivos):
        """Anota los cambios, reescribe estado.json y avisa a Waybar si algo visible cambio."""
        if self.estado is not None and estado != self.estado:
            self.evento(f"Estado: {self.estado} → {estado}", "estado",
                        "INFO" if estado == "ONLINE" else estado)
        self.estado, self.motivos = estado, motivos
        cargador = (self.instante or {}).get("cargador")
        if self.previo_cargador is not None and cargador is not None and cargador != self.previo_cargador:
            self.evento("Cargador conectado" if cargador else "Cargador desconectado", "cargador")
        if cargador is not None:
            self.previo_cargador = cargador
        escribir_json(os.path.join(self.dir, "estado.json"), self.estado_doc())
        clave = (estado, self.perfiles.activo, self.energia, self.perfiles.retencion, len(motivos),
                 self.privacidad["estado"])
        if clave != self.clave_aviso:
            self.clave_aviso = clave
            try:
                avisar_barra()
            except Exception:
                registrar("no se pudo avisar a Waybar:\n" + traceback.format_exc())

    # -- bus -----------------------------------------------------------------
    def poner_energia(self, valor):
        """Cambio del perfil de ppd (el que sea: el del usuario o una retencion nuestra)."""
        if valor == self.energia:
            return
        if self.energia is not None or valor is not None:
            self.evento(f"Perfil de energía: {valor or 'N/D'}", "perfil")
        self.energia = valor
        self._perfil_cambiado()

    def _perfil_cambiado(self):
        """Perfil de Jaime0 o de energia distintos: reescribe estado.json y avisa a Waybar."""
        if self.instante is not None:
            self.publicar(self.estado, self.motivos)

    @protegido(None)
    def iniciar_perfiles(self):
        self.perfiles.iniciar()

    def refrescar_lento(self):
        """Unidades fallidas y cortafuegos: cada 60 s, no en cada muestra."""
        def con_fallidas(lista):
            self.fallidas = lista

        def con_ufw(activa):
            self.privacidad = resumen_privacidad(activa)

        self.perfiles.refrescar_degradado()
        consultar_fallidas(con_fallidas)
        if leer("etc", "ufw", "ufw.conf") is not None:
            consultar_unidad_activa("ufw.service", con_ufw)
        else:
            self.privacidad = resumen_privacidad(None)
        # Temperatura de la NVIDIA: solo con la GPU activa, en un hilo (nvidia-smi tarda).
        if nvidia_activa():
            threading.Thread(target=self._leer_gpu, daemon=True).start()
        else:
            self.gpu_temp = None

    def _leer_gpu(self):
        try:
            self.gpu_temp = temperatura_nvidia()
        except Exception:
            registrar("error al leer la temperatura de la GPU:\n" + traceback.format_exc())

    def refrescar_smart(self):
        def con_smart(lista):
            self.smart = lista

        consultar_smart(con_smart)

    # -- historico, suspension y ajustes -----------------------------------------
    @protegido(None)
    def al_suspender(self, suspendiendo):
        """PrepareForSleep: al suspender se vuelca todo; al reanudar se cierra el hueco."""
        if suspendiendo:
            self.historico.volcar(cerrar_parcial=True)
        else:
            self.historico.cerrar_hueco(int(self.reloj()))

    @protegido(True)
    def _volcado_periodico(self):
        self.historico.volcar()
        return True

    @protegido(True)
    def _smart_periodico(self):
        self.refrescar_smart()
        return True

    @protegido(False)
    def _recarga_diferida(self):
        self._recarga_pendiente = False
        self.recargar_umbrales()
        return False

    def pedir_recarga(self):
        """Cambio en los ajustes: recarga los umbrales medio segundo despues (agrupa los
        varios eventos que produce una escritura)."""
        if self._recarga_pendiente:
            return
        GLib, _Gio = _gi()
        self._recarga_pendiente = True
        GLib.timeout_add(500, self._recarga_diferida)

    # -- bucle ---------------------------------------------------------------
    def _programar(self):
        GLib, _Gio = _gi()
        if self._fuente is not None:
            GLib.source_remove(self._fuente)
        self._intervalo_programado = self.intervalo_actual()
        self._fuente = GLib.timeout_add(self._intervalo_programado * 1000, self._tick)

    def _tick(self):
        self._fuente = None
        try:
            self.muestrear()
        except Exception:
            registrar("error al medir:\n" + traceback.format_exc())
        finally:
            self._programar()
        return False

    @protegido(True)
    def _lento(self):
        self.refrescar_lento()
        return True

    def _iniciar_api(self, GLib):
        import socket
        destino = os.path.join(self.dir, "control.sock")
        try:
            os.unlink(destino)
        except OSError:
            pass
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        anterior = os.umask(0o177)
        try:
            s.bind(destino)
        finally:
            os.umask(anterior)
        os.chmod(destino, 0o600)
        s.listen(8)
        s.setblocking(False)
        self._servidor = s
        GLib.io_add_watch(s.fileno(), GLib.PRIORITY_DEFAULT, GLib.IO_IN, self._aceptar)

    @protegido(True)
    def _aceptar(self, _fd, _cond):
        GLib, _Gio = _gi()
        try:
            con, _ = self._servidor.accept()
        except (BlockingIOError, InterruptedError):
            return True
        con.setblocking(False)
        buf = bytearray()

        @protegido(False)
        def leer_cliente(_fd2, _cond2):
            try:
                datos = con.recv(65536)
            except (BlockingIOError, InterruptedError):
                return True
            except OSError:
                datos = b""
            if datos:
                buf.extend(datos)
            if len(buf) > 262144:
                con.close()
                return False
            final = not datos
            while True:
                if b"\n" in buf:
                    linea, _, resto = bytes(buf).partition(b"\n")
                    buf[:] = resto
                elif final and buf.strip():
                    linea = bytes(buf)
                    buf.clear()
                else:
                    break
                respuesta = procesar_linea(linea.decode("utf-8", "replace"), self)
                try:
                    con.settimeout(5.0)     # respuestas grandes (series): sendall espera al cliente
                    con.sendall(respuesta.encode("utf-8") + b"\n")
                    con.setblocking(False)
                except OSError:
                    con.close()
                    return False
            if final:
                con.close()
                return False
            return True

        GLib.io_add_watch(con.fileno(), GLib.PRIORITY_DEFAULT, GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR,
                          leer_cliente)
        return True

    def ejecutar(self):
        import signal
        GLib, _Gio = _gi()
        self._bucle = GLib.MainLoop()
        try:
            self._iniciar_api(GLib)
            self.muestreador.base()
            self._perfil_bus = vigilar_perfil(self.poner_energia)
            self.recargar_umbrales()
            self.iniciar_perfiles()
            try:
                self.historico.cargar()
            except Exception:
                registrar("no se pudo leer el historico:\n" + traceback.format_exc())
            self._monitores = vigilar_archivos(
                [os.path.join(carpeta_config(), "ajustes"), ruta("usr", "share", "jaime0", "ajustes.predeterminados")],
                self.pedir_recarga)
            self._suspension = vigilar_suspension(self.al_suspender)
            self.refrescar_lento()
            self.refrescar_smart()
            GLib.timeout_add_seconds(REFRESCO_LENTO, self._lento)
            GLib.timeout_add_seconds(SMART_CADA, self._smart_periodico)
            GLib.timeout_add_seconds(VOLCADO_CADA, self._volcado_periodico)
            self._fuente = GLib.timeout_add(1000, self._tick)   # primera muestra con 1 s de deltas
            self._intervalo_programado = 1
            salir = lambda *_: (self._bucle.quit(), GLib.SOURCE_REMOVE)[1]
            # GLibUnix en PyGObject reciente; GLib.unix_signal_add en versiones anteriores.
            try:
                from gi.repository import GLibUnix
                anadir_senal = lambda s: GLibUnix.signal_add(GLib.PRIORITY_HIGH, s, salir)
            except ImportError:
                anadir_senal = lambda s: GLib.unix_signal_add(GLib.PRIORITY_HIGH, s, salir)
            anadir_senal(signal.SIGTERM)
            anadir_senal(signal.SIGINT)
            self._bucle.run()
        finally:
            self.limpiar()

    def limpiar(self):
        try:
            self.historico.volcar(cerrar_parcial=True)      # al parar (SIGTERM): no se pierde nada
        except Exception:
            registrar("no se pudo volcar el historico al parar:\n" + traceback.format_exc())
        try:
            if self._servidor is not None:
                self._servidor.close()
        except OSError:
            pass
        try:
            os.unlink(os.path.join(self.dir, "control.sock"))
        except OSError:
            pass


# ---------------------------------------------------------------------------
# Programa
# ---------------------------------------------------------------------------

def medir():
    """Una medicion inmediata: dos lecturas separadas 0,5 s."""
    m = Muestreador()
    m.base()
    time.sleep(0.5)
    inst = armar_instante(m.muestrear(), time.time(), INTERVALO_NORMAL, None)
    inst["estado"], motivos = evaluar(inst, UMBRALES)
    inst["alertas"] = len(motivos)
    return inst


def main(argv=None):
    ap = argparse.ArgumentParser(prog=PROGRAMA, description="Servicio de salud del sistema de Jaime0.")
    sub = ap.add_subparsers(dest="orden", required=True)
    sub.add_parser("ejecutar", help="ejecuta el servicio (bucle de GLib)")
    pm = sub.add_parser("medir", help="una medicion inmediata en JSON")
    pm.add_argument("--json", action="store_true", help="imprime JSON (es lo unico que hace)")
    args = ap.parse_args(argv)
    if args.orden == "medir":
        print(json.dumps(medir(), ensure_ascii=False))
        return 0
    try:
        Servicio().ejecutar()
    except KeyboardInterrupt:
        pass
    except Exception:
        registrar("error fatal:\n" + traceback.format_exc())
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
