#!/bin/sh
# Una linea con la cancion que suena ahora (MPRIS: Spotify, mpv, navegadores...), o nada.
# La usan la pantalla de bloqueo y otros paneles.
command -v playerctl >/dev/null 2>&1 || exit 0
[ "$(playerctl status 2>/dev/null)" = "Playing" ] || exit 0
playerctl metadata --format '󰎈  {{ trunc(artist, 30) }}{{ (artist && title) ? " · " : "" }}{{ trunc(title, 40) }}' 2>/dev/null
