# Ciudad: letras de cualquier idioma, espacios y signos de nombres de lugar.
CIUDAD = re.compile(r"^[^\W\d_](?:[^\W_]|[ .,'’()-])*$")

LINEA = re.compile(r"^\s*([A-Za-z0-9_.]+)\s*=\s*(.*?)\s*$")
COLOR = re.compile(r"^#[0-9a-fA-F]{6}$")
ID_APLICACION = re.compile(r"^[A-Za-z0-9._+-]+$")
SI = ("si", "sí", "s", "yes", "true", "1", "on")
NO = ("no", "n", "false", "0", "off")
MODIFICADORES = ("SUPER", "SHIFT", "CTRL", "ALT")
TECLAS_NOMBRE = ("Escape", "Return", "space", "Tab", "BackSpace", "Delete", "Insert", "Home", "End",
                 "Prior", "Next", "Print", "Pause")
TECLAS_FUNCION = tuple(f"F{n}" for n in range(1, 13))


class Error(Exception):
    pass


def leer(ruta):
    """clave -> valor de un archivo clave = valor. Ignora comentarios y lineas rotas."""
    valores = {}
    try:
        with open(ruta, encoding="utf-8") as f:
            for linea in f:
                if linea.lstrip().startswith("#"):
                    continue
                m = LINEA.match(linea)
                if m:
                    valores[m.group(1)] = m.group(2)
    except FileNotFoundError:
        pass
    return valores


def predeterminados():
    crudos = leer(PREDETERMINADOS)
    temas = {k[len("tema."):]: v.lower() for k, v in crudos.items()
             if k.startswith("tema.") and COLOR.match(v)}
    valores = dict(RESERVA)
    for clave in ESQUEMA:
        if clave in crudos:
            try:
                valores[clave] = validar(clave, crudos[clave], temas)
            except Error:
                pass
    return valores, temas


def validar_atajo(clave, t):
    """SUPER+I, CTRL+ALT+F5...: al menos un modificador y una tecla final. Devuelve el
    atajo normalizado (modificadores y letras en mayusculas, nombres de tecla de Hyprland)."""
    uso = (f"{clave}: escribe modificadores y una tecla separados por +, por ejemplo SUPER+I o "
           f"CTRL+ALT+F5 (modificadores: {', '.join(MODIFICADORES)}; teclas: una letra, un dígito, "
           f"F1-F12 o {', '.join(TECLAS_NOMBRE)})")
    partes = [p.strip() for p in t.split("+")]
    if len(partes) < 2 or any(not p for p in partes):
        raise Error(uso)
    *mods, tecla = partes
    mods = [m.upper() for m in mods]
    if any(m not in MODIFICADORES for m in mods):
        raise Error(uso)
    if len(set(mods)) != len(mods):
        raise Error(f"{clave}: modificador repetido")
    if len(tecla) == 1 and tecla.isascii() and tecla.isalnum():
        tecla = tecla.upper()
    elif tecla.upper() in TECLAS_FUNCION:
        tecla = tecla.upper()
    else:
        por_nombre = {n.lower(): n for n in TECLAS_NOMBRE}
        if tecla.lower() not in por_nombre:
            raise Error(uso)
        tecla = por_nombre[tecla.lower()]
    return "+".join(mods + [tecla])


def validar(clave, texto, temas):
    """Devuelve el valor normalizado o lanza Error con el motivo."""
    if clave not in ESQUEMA:
        raise Error(f"No existe el ajuste '{clave}'. Lista: {PROGRAMA} ver")
    e = ESQUEMA[clave]
    t = texto.strip()
    if e["tipo"] == "entero":
        try:
            n = int(t)
        except ValueError:
            raise Error(f"{clave}: '{t}' no es un número entero")
        if not e["min"] <= n <= e["max"]:
            raise Error(f"{clave}: debe estar entre {e['min']} y {e['max']}")
        return str(n)
    if e["tipo"] == "decimal":
        try:
            x = float(t.replace(",", "."))
        except ValueError:
            raise Error(f"{clave}: '{t}' no es un número")
        if not e["min"] <= x <= e["max"]:
            raise Error(f"{clave}: debe estar entre {e['min']} y {e['max']}")
        return f"{round(x, 2):g}"
    if e["tipo"] == "sino":
        if t.lower() in SI:
            return "si"
        if t.lower() in NO:
            return "no"
        raise Error(f"{clave}: usa si o no")
    if e["tipo"] == "opcion":
        if clave == "animaciones":
            # Antes era si/no: "si" equivale a sutil y "no" sigue siendo no.
            if t.lower() in SI:
                return "sutil"
            if t.lower() in NO:
                return "no"
        if t.lower() in e["opciones"]:
            return t.lower()
        raise Error(f"{clave}: opciones válidas: {', '.join(e['opciones'])}")
    if e["tipo"] == "atajo":
        return validar_atajo(clave, t)
    if e["tipo"] == "acento":
        if t.lower() in temas:
            return t.lower()
        if COLOR.match(t):
            return t.lower()
        raise Error(f"acento: usa un tema ({', '.join(temas)}) o un color #rrggbb")
    if e["tipo"] == "texto":
        t = " ".join(t.split())
        if len(t) > e["max"]:
            raise Error(f"{clave}: como máximo {e['max']} caracteres")
        if t and not CIUDAD.match(t):
            raise Error(f"{clave}: escribe solo el nombre del lugar (por ejemplo: Madrid, o Valencia, España)")
        return t
    if e["tipo"] == "anclas":
        # Identificadores de aplicacion (nombre del .desktop sin extension), en orden.
        # Que esten instaladas lo comprueba jaime0-anclar al anclar; si luego se
        # desinstala una, simplemente no se muestra.
        ids = []
        for i in re.split(r"[\s,]+", t):
            if not i:
                continue
            if not ID_APLICACION.match(i):
                raise Error(f"anclas: '{i}' no es un identificador de aplicación válido")
            if i not in ids:
                ids.append(i)
        if len(ids) > e["max"]:
            raise Error(f"anclas: como máximo {e['max']} aplicaciones")
        return " ".join(ids)
    if e["tipo"] == "fondo":
        ruta = os.path.abspath(os.path.expanduser(t))
        if not ruta.lower().endswith(EXTENSIONES_FONDO):
            raise Error("fondo: debe ser una imagen PNG o JPEG")
        if not os.path.isfile(ruta):
            raise Error(f"fondo: no existe {ruta}")
        return ruta
    raise Error(f"{clave}: tipo desconocido")


def efectivos():
    """(valores, propios, temas, avisos): predeterminados + ajustes validos del usuario."""
    valores, temas = predeterminados()
    propios = set()
    avisos = []
    for clave, texto in leer(archivo_usuario()).items():
        if clave not in ESQUEMA:
            avisos.append(f"Se ignora '{clave}': no es un ajuste de Jaime0")
            continue
        try:
            valores[clave] = validar(clave, texto, temas)
            propios.add(clave)
        except Error as e:
            avisos.append(f"Se ignora {e} (se usa el valor predeterminado)")
    return valores, propios, temas, avisos


def comprobar_parejas(valores):
    """valores: clave -> texto. Lanza Error si alguna pareja de umbrales no se cumple."""
    for menor, mayor, motivo in PAREJAS:
        try:
            a, b = int(valores[menor]), int(valores[mayor])
        except (KeyError, ValueError):
            continue
        if not a < b:
            raise Error(f"{menor} = {a} y {mayor} = {b}: {motivo}")


def color_acento(valor, temas):
    return temas.get(valor, valor if COLOR.match(valor) else RESERVA["acento"])


# ------------------------------------------------------------------------------------
# Escritura
# ------------------------------------------------------------------------------------
CABECERA = """# ~/.config/jaime0/ajustes: tus ajustes de Jaime0.
# Solo guarda lo que cambias; el resto sale de /usr/share/jaime0/ajustes.predeterminados.
# Ninguna actualizacion toca este archivo. Cambialo con jaime0-ajustes o a mano
# (clave = valor) y luego ejecuta: jaime0-ajustes aplicar
"""


def escribir_atomico(ruta, texto):
    """Escribe solo si cambia. Devuelve True si ha cambiado."""
    try:
        with open(ruta, encoding="utf-8") as f:
            if f.read() == texto:
                return False
    except FileNotFoundError:
        pass
    os.makedirs(os.path.dirname(ruta), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(ruta), prefix=".tmp-")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(texto)
        os.replace(tmp, ruta)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise
    return True


def guardar(cambios):
    """cambios: clave -> valor normalizado, o None para volver al predeterminado.
    Conserva comentarios y el resto de lineas del archivo del usuario."""
    ruta = archivo_usuario()
    try:
        with open(ruta, encoding="utf-8") as f:
            lineas = f.read().splitlines()
    except FileNotFoundError:
        lineas = CABECERA.rstrip("\n").splitlines()
    pendientes = dict(cambios)
    resultado = []
    vistos = set()
    for linea in lineas:
        m = None if linea.lstrip().startswith("#") else LINEA.match(linea)
        if m and m.group(1) in cambios:
            clave = m.group(1)
            if clave in vistos or cambios[clave] is None:
                continue  # duplicada o vuelve al predeterminado: fuera
            vistos.add(clave)
            resultado.append(f"{clave} = {cambios[clave]}")
            pendientes.pop(clave, None)
            continue
        resultado.append(linea)
    for clave, valor in pendientes.items():
        if valor is not None:
            resultado.append(f"{clave} = {valor}")
    escribir_atomico(ruta, "\n".join(resultado) + "\n")


def css_animaciones(nivel):
    """Reglas de swaync.css segun el nivel de animaciones."""
    if nivel == "no":
        return ("/* Animaciones: no. Se desactivan las transiciones y animaciones. */\n"
                "* { transition: none; animation: none; }\n")
    if nivel == "suave":
        return ("/* Animaciones: suave. Transiciones algo mas largas y visibles. */\n"
                ".notification-row, .notification, .control-center { transition-duration: 280ms; }\n")
    return "/* Animaciones: sutil. Se queda con las transiciones discretas del tema. */\n"


def hypridle_conf(valores):
    """hypridle.conf con los tiempos de inactividad. 0 minutos = esa accion no se hace. El
    aviso al motor de reglas (evento "inactivo" a los 5 min) va siempre."""
    def bloque(segundos, al_vencer, al_volver=None):
        lineas = ["listener {", f"    timeout = {segundos}", f"    on-timeout = {al_vencer}"]
        if al_volver:
            lineas.append(f"    on-resume = {al_volver}")
        return "\n".join(lineas + ["}", ""])
    encender = "hyprctl dispatch 'hl.dsp.dpms({ action = \"enable\" })'"
    apagar = "hyprctl dispatch 'hl.dsp.dpms({ action = \"disable\" })'"
    texto = "\n".join([
        f"# Generado por {PROGRAMA}: no lo edites (inactividad_* y suspender_con_cargador).",
        "general {",
        "    lock_cmd = bloquear",
        "    before_sleep_cmd = loginctl lock-session || bloquear",
        f"    after_sleep_cmd = {encender}",
        "    ignore_dbus_inhibit = false",
        "}", ""]) + bloque(300, "jaime0-reglas evento inactivo", "jaime0-reglas evento activo")
    if int(valores["inactividad_bloqueo"]):
        texto += bloque(60 * int(valores["inactividad_bloqueo"]), "loginctl lock-session || bloquear")
    if int(valores["inactividad_pantalla"]):
        texto += bloque(60 * int(valores["inactividad_pantalla"]), apagar, encender)
    if int(valores["inactividad_suspender"]):
        # "inactividad suspender" no suspende si hay un cargador conectado y no se quiere.
        suspender = "systemctl suspend" if valores["suspender_con_cargador"] == "si" else "inactividad suspender"
        texto += bloque(60 * int(valores["inactividad_suspender"]), suspender)
    return texto


def animaciones_del_sistema(ejecutar=None):
    """Preferencia de accesibilidad del escritorio (org.gnome.desktop.interface
    enable-animations, la que cambian nwg-look y las herramientas de GNOME): True, False o
    None si no se puede saber (sin gsettings o sin el esquema)."""
    ejecutar = ejecutar or subprocess.run
    try:
        r = ejecutar(["gsettings", "get", "org.gnome.desktop.interface", "enable-animations"],
                     capture_output=True, text=True, timeout=3)
    except (OSError, subprocess.TimeoutExpired):
        return None
    valor = (r.stdout or "").strip() if r.returncode == 0 else ""
    return {"true": True, "false": False}.get(valor)


def nivel_animaciones(nivel, sistema=None):
    """El nivel de Jaime0, salvo que el escritorio pida no animar: entonces "no". En modo de
    prueba (raiz falsa) no se consulta el sistema."""
    if nivel == "no":
        return nivel
    if sistema is None and not MODO_PRUEBA:
        sistema = animaciones_del_sistema()
    return "no" if sistema is False else nivel


def generar():
    """Rehace ~/.config/jaime0/generado. Devuelve los nombres de lo que ha cambiado."""
    valores, _, temas, avisos = efectivos()
    animaciones = nivel_animaciones(valores["animaciones"])
    acento = color_acento(valores["acento"], temas)
    g = carpeta_generado()
    archivos = {
        "waybar.json": json.dumps({
            "height": int(valores["barra_altura"]),
            "position": "top" if valores["barra_posicion"] == "arriba" else "bottom",
        }, indent=4) + "\n",
        "waybar.css": f"/* Generado por {PROGRAMA}: no lo edites. */\n@define-color acento {acento};\n",
        "rofi.rasi": f"/* Generado por {PROGRAMA}: no lo edites. */\n* {{\n    acento: {acento};\n}}\n",
        "fondo": valores["fondo"] + "\n",
        "anclas": valores["anclas"] + "\n",
        "swaync.css": (f"/* Generado por {PROGRAMA}: no lo edites. */\n@define-color acento {acento};\n"
                       + css_animaciones(animaciones)),
        # Widgets de escritorio (jaime0-widgets): solo los activados, con su posicion.
        "widgets.json": json.dumps({
            "acento": acento,
            "tarjetas": valores["widgets_tarjetas"] == "si",
            "reloj_formato": valores["reloj_formato"],
            "animaciones": animaciones,
            "ciudad": valores["tiempo_ciudad"],
            "widgets": {w: valores[f"widget_{w}"] for w in WIDGETS if valores[f"widget_{w}"] != "no"},
        }, ensure_ascii=False, indent=4) + "\n",
        # Control Center: atajo (hyprland.lua) y ajustes de la ventana.
        "control.json": json.dumps({
            "atajo": valores["control_atajo"],
            "animaciones": animaciones,
            "intervalo": int(valores["cc_intervalo"]),
            "intervalo_rapido": int(valores["cc_intervalo_rapido"]),
            "notificar": valores["cc_notificar"],
            "escala": int(valores["cc_escala"]),
        }, ensure_ascii=False, indent=4) + "\n",
        # Indicador de volumen y brillo (wob, via jaime0-osd).
        "wob.ini": (f"# Generado por {PROGRAMA}: no lo edites.\n"
                    "timeout = 1200\nmax = 100\nwidth = 260\nheight = 26\nborder_offset = 0\n"
                    "border_size = 1\nbar_padding = 5\nanchor = bottom center\nmargin = 96\n"
                    "border_color = 26343aff\nbackground_color = 101519ff\n"
                    f"bar_color = {acento.lstrip('#')}ff\noverflow_mode = nowrap\n"),
        # Inactividad y suspension (hypridle, lanzado por "inactividad").
        "hypridle.conf": hypridle_conf(valores),
        # Pantalla de bloqueo (hyprlock), que lo lee cada vez que se abre.
        "hyprlock.conf": f"# Generado por {PROGRAMA}: no lo edites.\n"
                         f"$acento = rgb({acento.lstrip('#')})\n$imagen = {valores['fondo']}\n",
    }
    cambiados = {n for n, texto in archivos.items() if escribir_atomico(os.path.join(g, n), texto)}
    return cambiados, avisos


# ------------------------------------------------------------------------------------
# Aplicar en la sesion
# ------------------------------------------------------------------------------------
def en_marcha(proceso):
    return shutil.which("pgrep") is not None and subprocess.run(
        ["pgrep", "-x", "-u", str(os.getuid()), proceso],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0


def lanzar(orden):
    subprocess.Popen(orden, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


def aplicar():
    cambiados, avisos = generar()
    if MODO_PRUEBA:
        return cambiados, avisos
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE") and shutil.which("hyprctl"):
        subprocess.run(["hyprctl", "reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if cambiados & {"waybar.json", "waybar.css"} and en_marcha("waybar"):
        subprocess.run(["pkill", "-USR2", "-x", "-u", str(os.getuid()), "waybar"])
    if "wob.ini" in cambiados and shutil.which("systemctl"):
        # Solo si ya esta en marcha; si no, lo leera al arrancar con la primera tecla.
        subprocess.run(["systemctl", "--user", "try-restart", "wob.service"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
    if "swaync.css" in cambiados and en_marcha("swaync"):
        subprocess.run(["swaync-client", "--reload-css", "--skip-wait"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
    if "widgets.json" in cambiados and shutil.which("jaime0-widgets"):
        # Los widgets releen el archivo solos; esto solo arranca o para el proceso.
        subprocess.run(["jaime0-widgets", "sincronizar"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if "anclas" in cambiados and shutil.which("jaime0-anclar"):
        subprocess.run(["jaime0-anclar", "refrescar"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if "hypridle.conf" in cambiados and en_marcha("hypridle"):
        # hypridle no relee su archivo: se reinicia (inactividad elige que archivo usa).
        subprocess.run(["pkill", "-x", "-u", str(os.getuid()), "hypridle"])
        lanzar(["inactividad"])
    if "fondo" in cambiados and en_marcha("swaybg"):
        with open(os.path.join(carpeta_generado(), "fondo"), encoding="utf-8") as f:
            fondo = f.read().strip()
        if not os.path.isfile(fondo):
            # Ni el elegido ni el predeterminado existen: mejor el fondo que ya hay que negro.
            avisos.append(f"No existe el fondo {fondo}: se mantiene el actual")
            return cambiados, avisos
        subprocess.run(["pkill", "-x", "-u", str(os.getuid()), "swaybg"])
        lanzar(["swaybg", "--image", fondo, "--mode", "fill"])
    return cambiados, avisos


# ------------------------------------------------------------------------------------
# Ordenes
# ------------------------------------------------------------------------------------
def lista_fondos():
    fondos = []
    for carpeta in carpetas_fondos():
        try:
            nombres = sorted(os.listdir(carpeta))
        except OSError:
            continue
        fondos += [os.path.join(carpeta, n) for n in nombres if n.lower().endswith(EXTENSIONES_FONDO)]
    return fondos


def mostrar_avisos(avisos):
    for a in avisos:
        print(f"AVISO: {a}", file=sys.stderr)


def orden_ver(args):
    valores, propios, temas, avisos = efectivos()
    predet, _ = predeterminados()
    if args[:1] == ["--json"]:
        ajustes = []
        for clave, e in ESQUEMA.items():
            d = dict(e, clave=clave, valor=valores[clave], predeterminado=predet[clave],
                     propio=clave in propios)
            if e["tipo"] == "acento":
                d["color"] = color_acento(valores[clave], temas)
            ajustes.append(d)
        print(json.dumps({"ajustes": ajustes, "temas": temas, "fondos": lista_fondos(),
                          "avisos": avisos, "archivo": archivo_usuario()},
                         ensure_ascii=False, indent=2))
        return 0
    if args:
        raise Error(f"Uso: {PROGRAMA} ver [--json]")
    grupo = None
    for clave, e in ESQUEMA.items():
        if e["grupo"] != grupo:
            grupo = e["grupo"]
            print(f"\n{grupo}")
        marca = "*" if clave in propios else " "
        print(f" {marca} {clave:<24} {valores[clave]:<12} {e['etiqueta']}")
    print(f"\n * = cambiado por ti en {archivo_usuario()}")
    print(f" Temas de acento: {', '.join(temas)}")
    mostrar_avisos(avisos)
    return 0


def orden_poner(args):
    if not args or len(args) % 2:
        raise Error(f"Uso: {PROGRAMA} poner CLAVE VALOR [CLAVE VALOR ...]")
    predet, temas = predeterminados()
    cambios = {}
    for clave, texto in zip(args[::2], args[1::2]):
        cambios[clave] = validar(clave, texto, temas)  # todo o nada
    valores, _, _, _ = efectivos()
    valores.update(cambios)
    comprobar_parejas(valores)       # validacion cruzada de umbrales, tambien todo o nada
    # Igual que el predeterminado: no se guarda, asi sigue al predeterminado si cambia.
    guardar({c: (None if v == predet[c] else v) for c, v in cambios.items()})
    _, avisos = aplicar()
    for clave, valor in cambios.items():
        print(f"{clave} = {valor}")
    mostrar_avisos(avisos)
    return 0


def orden_restablecer(args):
    if args == ["--todo"]:
        claves = list(ESQUEMA)
    elif args and all(c in ESQUEMA for c in args):
        claves = args
    else:
        desconocidas = [c for c in args if c not in ESQUEMA]
        raise Error(f"No existe el ajuste '{desconocidas[0]}'" if desconocidas
                    else f"Uso: {PROGRAMA} restablecer CLAVE [CLAVE ...] | --todo")
    # Volver al predeterminado tampoco puede dejar los umbrales incoherentes.
    predet, _ = predeterminados()
    valores, _, _, _ = efectivos()
    valores.update({c: predet[c] for c in claves})
    comprobar_parejas(valores)
    guardar({c: None for c in claves})
    _, avisos = aplicar()
    print("Valores predeterminados en: " + ", ".join(claves))
    mostrar_avisos(avisos)
    return 0


def orden_aplicar(args):
    _, avisos = aplicar()
    mostrar_avisos(avisos)
    return 0


def orden_generar(args):
    # Al iniciar la sesion, antes de Waybar: sin recargar nada.
    _, avisos = generar()
    mostrar_avisos(avisos)
    return 0


def orden_interfaz(args):
    qs = shutil.which("quickshell") or shutil.which("qs")
    if qs and os.path.isfile(INTERFAZ) and os.environ.get("WAYLAND_DISPLAY"):
        os.execv(qs, [qs, "-p", INTERFAZ])
    print("La aplicación gráfica de ajustes no está disponible (necesita Quickshell y una sesión gráfica).")
    print(f"Puedes cambiar los ajustes desde la terminal: {PROGRAMA} poner CLAVE VALOR\n")
    return orden_ver([])


AYUDA = f"""Uso: {PROGRAMA} [ORDEN]

  (sin orden)                 abre la aplicación de ajustes (o muestra la lista)
  ver [--json]                ajustes actuales; * marca los que has cambiado
  poner CLAVE VALOR [...]     cambia uno o varios ajustes y los aplica
  restablecer CLAVE [...]     vuelve al valor predeterminado (--todo: todos)
  aplicar                     aplica lo que hayas editado a mano en el archivo

Ejemplos:
  {PROGRAMA} poner acento cian
  {PROGRAMA} poner esquinas 6 borde 1
  {PROGRAMA} poner fondo ~/Imágenes/mi-fondo.png
  {PROGRAMA} restablecer acento

Tus ajustes: ~/.config/jaime0/ajustes (ninguna actualización los toca)."""

ORDENES = {"ver": orden_ver, "poner": orden_poner, "restablecer": orden_restablecer,
           "aplicar": orden_aplicar, "generar": orden_generar}


def main(argv):
    if es_root():
        print(f"{PROGRAMA}: los ajustes son de cada usuario; ejecútalo sin sudo.", file=sys.stderr)
        return 1
    if not argv:
        return orden_interfaz([])
    if argv[0] in ("-h", "--help", "ayuda"):
        print(AYUDA)
        return 0
    if argv[0] not in ORDENES:
        print(AYUDA, file=sys.stderr)
        return 2
    try:
        return ORDENES[argv[0]](argv[1:])
    except Error as e:
        print(f"{PROGRAMA}: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
