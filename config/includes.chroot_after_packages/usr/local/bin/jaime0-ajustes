# Parejas (menor, mayor) que deben cumplir menor < mayor. En la bateria el aviso es el
# nivel mas alto: el critico debe ser menor que el aviso.
PAREJAS = (
    ("umbral_temp_aviso", "umbral_temp_critico", "la temperatura de aviso debe ser menor que la crítica"),
    ("umbral_disco_aviso", "umbral_disco_critico", "el umbral de disco de aviso debe ser menor que el crítico"),
    ("umbral_bateria_critico", "umbral_bateria_aviso", "el nivel crítico de batería debe ser menor que el de aviso"),
)
POSICIONES_WIDGET = ["no", "arriba-izquierda", "arriba-centro", "arriba-derecha", "centro",
                     "abajo-izquierda", "abajo-centro", "abajo-derecha"]
for _clave, _e in ESQUEMA.items():
    if _clave.startswith("widget_"):
        _e["opciones"] = POSICIONES_WIDGET
WIDGETS = [c[len("widget_"):] for c in ESQUEMA if c.startswith("widget_")]

# Solo para un sistema sin el archivo de predeterminados (no deberia pasar).
RESERVA = {
    "acento": "#54e58a", "fondo": "/usr/share/backgrounds/jaime0/jaime0.png",
