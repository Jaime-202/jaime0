#!/usr/bin/python3 -I
# jaime0-ajustes: ajustes centralizados de Jaime0.
#
#   /usr/share/jaime0/ajustes.predeterminados  valores de fabrica y temas (del sistema)
#   ~/.config/jaime0/ajustes                   solo lo que cambia el usuario (suyo; ninguna
#                                              actualizacion lo toca)
#   ~/.config/jaime0/generado/                 archivos que leen Waybar y rofi; se rehacen
#                                              siempre a partir de los dos anteriores
#
# Hyprland lee los dos primeros directamente (hyprland.lua). Este programa valida, guarda
# y aplica los cambios en la sesion: recarga Hyprland, Waybar y el fondo.

import json
import os
import re
import shutil
import subprocess
import sys
import tempfile

PROGRAMA = "jaime0-ajustes"


def es_root():
    return hasattr(os, "geteuid") and os.geteuid() == 0


# Modo de prueba: JAIME0_RAIZ apunta a un sistema de mentira (solo sin privilegios).
RAIZ = os.environ.get("JAIME0_RAIZ", "/") if not es_root() else "/"
MODO_PRUEBA = RAIZ != "/"
PREDETERMINADOS = os.path.join(RAIZ, "usr", "share", "jaime0", "ajustes.predeterminados")
INTERFAZ = os.path.join(RAIZ, "usr", "share", "jaime0", "ajustes-gui", "shell.qml")
CARPETAS_FONDOS = (os.path.join(RAIZ, "usr", "share", "backgrounds", "jaime0"),)
EXTENSIONES_FONDO = (".png", ".jpg", ".jpeg")


def carpeta_config():
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    return os.path.join(base, "jaime0")


def archivo_usuario():
    return os.path.join(carpeta_config(), "ajustes")


def carpeta_generado():
    return os.path.join(carpeta_config(), "generado")


def carpetas_fondos():
    datos = os.environ.get("XDG_DATA_HOME") or os.path.join(os.path.expanduser("~"), ".local", "share")
    return CARPETAS_FONDOS + (os.path.join(datos, "backgrounds"),)


