#!/bin/sh
# Notificaciones de Jaime0: Sway Notification Center (swaync), con su centro de
# notificaciones, modo no molestar, controles de musica y volumen.
# Si swaync no esta instalado (sistema actualizado a medias), se usa dunst. Nunca los dos.
#
#   notificaciones iniciar      arranca el servicio (lo llama Hyprland al entrar)
#   notificaciones panel        abre o cierra el centro de notificaciones
#   notificaciones nomolestar   activa o desactiva el modo no molestar
#   notificaciones cerrar       borra todas
#   notificaciones barra        estado para la campana de Waybar (JSON)

if command -v swaync >/dev/null 2>&1; then
    case "$1" in
        iniciar)    exec swaync ;;
        panel)      exec swaync-client --toggle-panel --skip-wait ;;
        nomolestar) exec swaync-client --toggle-dnd --skip-wait ;;
        cerrar)     exec swaync-client --close-all --skip-wait ;;
        # Una linea JSON en cada cambio: Waybar no sondea. Si swaync aun no ha arrancado,
        # se reintenta cada pocos segundos.
        barra)      while :; do swaync-client --subscribe-waybar 2>/dev/null; sleep 3; done ;;
        *)          echo "Uso: notificaciones iniciar|panel|nomolestar|cerrar|barra" >&2; exit 2 ;;
    esac
fi

# Respaldo: dunst.
case "$1" in
    iniciar)    exec dunst ;;
    panel)      exec dunstctl history-pop ;;
    nomolestar) exec dunstctl set-paused toggle ;;
    cerrar)     exec dunstctl close-all ;;
    barra)
        while :; do
            if [ "$(dunstctl is-paused 2>/dev/null)" = true ]; then
                printf '{"text":"","alt":"dnd-none","class":"dnd-none","tooltip":"No molestar"}\n'
            else
                printf '{"text":"","alt":"none","class":"none","tooltip":"Notificaciones"}\n'
            fi
            sleep 60
        done ;;
    *)          echo "Uso: notificaciones iniciar|panel|nomolestar|cerrar|barra" >&2; exit 2 ;;
esac
