    ("hardware.smart", "Salud de los discos (SMART)", c_smart),
    ("hardware.bateria", "Salud de la batería", c_bateria),
    ("sistema.unidades_sistema", "Unidades del sistema fallidas", c_unidades_sistema),
    ("sistema.unidades_usuario", "Unidades de usuario fallidas", c_unidades_usuario),
    ("sistema.errores_arranque", "Errores del arranque actual", c_errores_arranque),
    ("sistema.paquetes", "Paquetes (dpkg --audit)", c_paquetes),
    ("sistema.config_hyprland", "Configuración de Hyprland", c_config_hyprland),
    ("sistema.config_waybar", "Configuración de Waybar", c_config_waybar),
