    ("energia.perfiles", "Perfiles de energía (power-profiles-daemon)", c_perfiles),
    ("energia.cargador", "Batería y cargador", c_cargador),
    ("energia.suspension", "Suspensión y reanudación", c_suspension),
)


def ejecutar_comprobaciones(ctx, areas=None):
    for cid, nombre, funcion in COMPROBACIONES:
        if areas and cid.split(".")[0] not in areas:
            continue
        try:
            estado, detalle, problemas = funcion(ctx)
        except Exception as e:  # una comprobacion rota nunca tumba el diagnostico
            estado, detalle, problemas = "NO_DISPONIBLE", f"Error interno en esta comprobación ({type(e).__name__})", []
        ctx.anotar(cid, nombre, estado, detalle, problemas)


def limpiar_obj(x, datos):
    if isinstance(x, str):
        return limpiar(x, *datos)
    if isinstance(x, list):
        return [limpiar_obj(y, datos) for y in x]
    if isinstance(x, dict):
        return {k: (v if k.startswith("_") else limpiar_obj(v, datos)) for k, v in x.items()}
    return x


def clave_problema(p):
    return (ORDEN_GRAVEDAD.get(p["gravedad"], 9), ORDEN_AREA.get(p["area"], 9), p["id"])


def resultado_limpio(ctx, datos=None):
    """(comprobaciones por area, problemas ordenados, ids de comprobaciones concluyentes), sin datos personales."""
    datos = datos or datos_locales()
    areas = {a: limpiar_obj(ctx.comprobaciones[a], datos) for a, _ in AREAS}
    problemas = sorted((limpiar_obj(p, datos) for p in ctx.problemas), key=clave_problema)
    # Solo una comprobacion que ha llegado a mirar puede dar un problema por resuelto: si ahora
    # no se pudo comprobar (sin --sudo, sin sesion grafica...), lo anterior sigue como estaba.
    concluyentes = {c["id"] for l in areas.values() for c in l if c["estado"] != "NO_DISPONIBLE"}
    return areas, problemas, concluyentes


def resumen(areas, problemas):
    r = {g: 0 for g in GRAVEDADES}
    r.update(NO_DISPONIBLE=0, NO_APLICA=0)
    for p in problemas:
        r[p["gravedad"]] += 1
    for lista in areas.values():
        for c in lista:
            if c["estado"] in ("NO_DISPONIBLE", "NO_APLICA"):
                r[c["estado"]] += 1
    return r


CAMPOS_PROBLEMA = ("id", "titulo", "gravedad", "componente", "area", "detectado", "causas_probables",
                   "consecuencias", "recomendacion", "reparacion")


def documento_comprobar(areas, problemas, t, duracion, historial):
    lista = []
    for p in problemas:
        q = {k: p[k] for k in CAMPOS_PROBLEMA}
        h = historial.get(p["id"]) or {}
        q.update(veces=h.get("veces", 1), primera_vez=h.get("primera_vez", t), ultima_vez=h.get("ultima_vez", t))
        lista.append(q)
    return {"ok": True, "v": VERSION_DIAGNOSTICO, "t": t, "duracion": round(duracion, 1),
            "resumen": resumen(areas, problemas),
            "areas": [{"id": a, "nombre": n, "comprobaciones": areas[a]} for a, n in AREAS if areas[a]],
            "problemas": lista}


class Cerrojo:
    """Un solo escritor del historial a la vez (el servicio y una terminal pueden coincidir)."""

    def __init__(self, carpeta):
        self.carpeta = carpeta

    def __enter__(self):
        os.makedirs(self.carpeta, mode=0o700, exist_ok=True)
        self.f = open(os.path.join(self.carpeta, ".diagnosticos.cerrojo"), "a")
        if fcntl is not None:
            fcntl.flock(self.f, fcntl.LOCK_EX)
        return self

    def __exit__(self, *exc):
        self.f.close()


def escribir_atomico(destino, texto):
    carpeta = os.path.dirname(destino)
    fd, temporal = tempfile.mkstemp(dir=carpeta, prefix=".diagnosticos-")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(texto)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(temporal, 0o600)
        os.replace(temporal, destino)
    except BaseException:
        try:
            os.unlink(temporal)
        except OSError:
            pass
        raise


def archivos_historial():
    d = dir_estado()
    return d, os.path.join(d, "diagnosticos.jsonl"), os.path.join(d, "diagnosticos.json")


def leer_problemas_historial(archivo):
    datos = leer_json(archivo)
    problemas = datos.get("problemas") if isinstance(datos, dict) else None
    return {k: v for k, v in problemas.items() if isinstance(v, dict)} if isinstance(problemas, dict) else {}


def leer_ejecuciones(archivo):
    l = []
    try:
        with open(archivo, encoding="utf-8") as f:
            for linea in f:
                try:
                    d = json.loads(linea)
                except ValueError:
                    continue
                if isinstance(d, dict):
                    l.append(d)
    except OSError:
        pass
    return l


def actualizar_historial(t, problemas, concluyentes, ejecucion=None, reparado=None):
    """Anota lo detectado (primera y ultima vez, veces), da por resuelto lo que una comprobacion
    concluyente ya no ve y, si se pide, guarda la ejecucion o una reparacion. Devuelve los
    problemas recordados. Nunca falla por el historial: si no se puede escribir, sigue."""
    carpeta, f_ejecuciones, f_problemas = archivos_historial()
    try:
        with Cerrojo(carpeta):
            memoria = leer_problemas_historial(f_problemas)
            vistos = {p["id"] for p in problemas}
            for p in problemas:
                e = memoria.get(p["id"])
                if e is None:
                    e = memoria[p["id"]] = {"primera_vez": t, "veces": 0, "reparaciones": []}
                e.update(titulo=p["titulo"], gravedad=p["gravedad"], comprobacion=p.get("_comprobacion"),
                         ultima_vez=t, estado="activo", resuelto_en=None)
                if ejecucion is not None or not e["veces"]:
                    e["veces"] = int(e.get("veces") or 0) + 1
            for pid, e in memoria.items():
                if e.get("estado") == "activo" and pid not in vistos and e.get("comprobacion") in concluyentes:
                    e["estado"], e["resuelto_en"] = "resuelto", t
            if reparado is not None:
                pid, entrada = reparado
                e = memoria.setdefault(pid, {"primera_vez": t, "ultima_vez": t, "veces": 1, "estado": "activo",
                                             "resuelto_en": None, "titulo": pid, "gravedad": "INFO"})
                e["reparaciones"] = (list(e.get("reparaciones") or []) + [entrada])[-LIMITE_REPARACIONES:]
            # Se olvida lo resuelto hace mucho y, si aun asi son demasiados, lo mas antiguo.
            memoria = {k: v for k, v in memoria.items()
                       if not (v.get("estado") == "resuelto" and (v.get("resuelto_en") or t) < t - OLVIDAR_RESUELTOS)}
            if len(memoria) > LIMITE_PROBLEMAS:
                memoria = dict(sorted(memoria.items(), key=lambda kv: kv[1].get("ultima_vez") or 0)[-LIMITE_PROBLEMAS:])
            escribir_atomico(f_problemas, json.dumps({"v": VERSION_DIAGNOSTICO, "problemas": memoria},
                                                     ensure_ascii=False, sort_keys=True) + "\n")
            if ejecucion is not None:
                lineas = leer_ejecuciones(f_ejecuciones)[-(LIMITE_EJECUCIONES - 1):] + [ejecucion]
                escribir_atomico(f_ejecuciones, "".join(json.dumps(x, ensure_ascii=False, separators=(",", ":")) + "\n"
                                                       for x in lineas))
            return memoria
    except OSError as e:
        print(f"{PROGRAMA}: no se pudo guardar el historial en {carpeta}: {e.strerror or e}", file=sys.stderr)
        return {}


def diagnosticar(sudo=False, areas=None):
    """Comprueba y devuelve (areas, problemas, concluyentes, t, duracion, contexto); todo menos el
    contexto (con las ordenes reales de las reparaciones) ya sin datos personales."""
    inicio, t = time.monotonic(), int(time.time())
    ctx = Contexto(sudo)
    ejecutar_comprobaciones(ctx, areas)
    areas_l, problemas, concluyentes = resultado_limpio(ctx)
    return areas_l, problemas, concluyentes, t, time.monotonic() - inicio, ctx


# ---------------------------------------------------------------------------
# Salida en texto
# ---------------------------------------------------------------------------

ETIQUETAS = {"OK": "OK", "INFO": "INFO", "WARNING": "AVISO", "ERROR": "ERROR", "CRITICAL": "CRÍTICO",
             "NO_DISPONIBLE": "NO DISPONIBLE", "NO_APLICA": "NO APLICA"}


def fecha(t):
    return datetime.datetime.fromtimestamp(t).strftime("%Y-%m-%d %H:%M") if t else "-"


def texto_problema(p, con_reparacion=True):
    l = [f"[{ETIQUETAS.get(p['gravedad'], p['gravedad'])}] {p['titulo']}   ({p['id']})"]
    l.append("  Detectado:")
    l += [f"    - {x}" for x in p["detectado"]]
    l.append("  Causas probables (sin confirmar):")
    l += [f"    - {x}" for x in p["causas_probables"]]
    l.append(f"  Consecuencias: {p['consecuencias']}")
    l.append("  Qué hacer:")
    l += [f"    {n}. {x}" for n, x in enumerate(p["recomendacion"], 1)]
    rep = p.get("reparacion")
    if con_reparacion and rep:
        l.append(f"  Reparación disponible: jaime0-diagnostico reparar {p['id']}")
        l.append(f"    {rep['descripcion']}")
        l += [f"    $ {o}" for o in rep["ordenes"]]
    if p.get("veces", 1) > 1:
        l.append(f"  Visto {p['veces']} veces desde {fecha(p.get('primera_vez'))}")
    return l


def texto_comprobar(doc):
    r = doc["resumen"]
    l = [f"Diagnóstico de {PRODUCTO} · {fecha(doc['t'])} · {doc['duracion']} s",
         "Resumen: " + ", ".join(f"{r[g]} {g}" for g in GRAVEDADES)
         + f"; {r['NO_DISPONIBLE']} no disponibles, {r['NO_APLICA']} no aplican", ""]
    ancho = max(len(e) for e in ETIQUETAS.values()) + 2
    for area in doc["areas"]:
        l.append(area["nombre"])
        for c in area["comprobaciones"]:
            l.append(f"  {('[' + ETIQUETAS.get(c['estado'], c['estado']) + ']').ljust(ancho)} {c['nombre']}: {c['detalle']}")
        l.append("")
    if doc["problemas"]:
        l.append("PROBLEMAS")
        for p in doc["problemas"]:
            l += texto_problema(p) + [""]
    else:
        l += ["Ningún problema detectado.", ""]
    if any(c["estado"] == "NO_DISPONIBLE" and "--sudo" in c["detalle"] for a in doc["areas"] for c in a["comprobaciones"]):
        l += ["Algunas comprobaciones necesitan permisos: jaime0-diagnostico comprobar --sudo", ""]
    return "\n".join(l)


# ---------------------------------------------------------------------------
# Ordenes: comprobar, historial y reparar
# ---------------------------------------------------------------------------

def imprimir_json(doc):
    print(json.dumps(doc, ensure_ascii=False, separators=(",", ":")))


def cmd_comprobar(args):
    como_json, sudo = "--json" in args, "--sudo" in args
    otras = [a for a in args if a not in ("--json", "--sudo")]
    if otras:
        mensaje = f"opción desconocida para comprobar: {otras[0]}"
        if como_json:
            imprimir_json({"ok": False, "error": mensaje})
        else:
            print(f"{PROGRAMA}: {mensaje}", file=sys.stderr)
        return 2
    try:
        areas, problemas, concluyentes, t, duracion, _ = diagnosticar(sudo)
    except Exception as e:  # el consumidor (Control Center) siempre recibe una linea JSON
        mensaje = f"error interno al diagnosticar ({type(e).__name__})"
        if como_json:
            imprimir_json({"ok": False, "error": mensaje})
        else:
            print(f"{PROGRAMA}: {mensaje}", file=sys.stderr)
        return 1
    doc_previo = documento_comprobar(areas, problemas, t, duracion, {})
    ejecucion = {"t": t, "duracion": doc_previo["duracion"], "resumen": doc_previo["resumen"],
                 "problemas": [{"id": p["id"], "gravedad": p["gravedad"]} for p in problemas]}
    memoria = actualizar_historial(t, problemas, concluyentes, ejecucion=ejecucion)
    doc = documento_comprobar(areas, problemas, t, duracion, memoria)
    if como_json:
        imprimir_json(doc)
    else:
        print(texto_comprobar(doc))
    return 0


def cmd_historial(args):
    como_json, n = False, 20
    i = 0
    while i < len(args):
        if args[i] == "--json":
            como_json = True
        elif args[i] == "-n" and i + 1 < len(args) and args[i + 1].isdigit():
            n = max(1, int(args[i + 1]))
            i += 1
        else:
            mensaje = f"opción desconocida para historial: {args[i]}"
            if como_json or "--json" in args:
                imprimir_json({"ok": False, "error": mensaje})
            else:
                print(f"{PROGRAMA}: {mensaje}", file=sys.stderr)
            return 2
        i += 1
    _, f_ejecuciones, f_problemas = archivos_historial()
    memoria = leer_problemas_historial(f_problemas)
    orden = sorted(memoria.items(), key=lambda kv: (kv[1].get("estado") != "activo",
                                                    ORDEN_GRAVEDAD.get(kv[1].get("gravedad"), 9),
                                                    -(kv[1].get("ultima_vez") or 0)))
    problemas = [{"id": pid, "titulo": e.get("titulo"), "gravedad": e.get("gravedad"),
                  "primera_vez": e.get("primera_vez"), "ultima_vez": e.get("ultima_vez"), "veces": e.get("veces", 0),
                  "estado": e.get("estado"), "resuelto_en": e.get("resuelto_en"),
                  "reparaciones": [{"t": r.get("t"), "resultado": r.get("resultado")}
                                   for r in e.get("reparaciones") or [] if isinstance(r, dict)]}
                 for pid, e in orden]
    ejecuciones = [{"t": e.get("t"), "resumen": e.get("resumen")} for e in reversed(leer_ejecuciones(f_ejecuciones)[-n:])]
    if como_json:
        imprimir_json({"ok": True, "problemas": problemas, "ejecuciones": ejecuciones})
        return 0
    if not problemas and not ejecuciones:
        print("Aún no hay diagnósticos guardados. Ejecuta: jaime0-diagnostico comprobar")
        return 0
    print("PROBLEMAS")
    for p in problemas:
        estado = "activo" if p["estado"] == "activo" else f"resuelto el {fecha(p['resuelto_en'])}"
        print(f"  [{ETIQUETAS.get(p['gravedad'], p['gravedad'])}] {p['titulo']} ({p['id']}): {estado}; "
              f"{p['veces']} veces, de {fecha(p['primera_vez'])} a {fecha(p['ultima_vez'])}")
        for r in p["reparaciones"]:
            print(f"      reparación {fecha(r['t'])}: {r['resultado']}")
    print("\nEJECUCIONES")
    for e in ejecuciones:
        r = e.get("resumen") or {}
        print(f"  {fecha(e['t'])}: " + ", ".join(f"{r.get(g, 0)} {g}" for g in GRAVEDADES))
    return 0


def terminal_interactiva():
    return sys.stdin.isatty() and sys.stdout.isatty()


def ejecutar_orden(argv):
    """Una orden de una reparacion, a la vista (sudo puede pedir la contrasena). Codigo de salida."""
    try:
        return subprocess.run(argv, timeout=TIEMPO_REPARACION).returncode
    except FileNotFoundError:
        print(f"No existe {argv[0]}", file=sys.stderr)
        return 127
    except subprocess.TimeoutExpired:
        print(f"No terminó en {TIEMPO_REPARACION} s", file=sys.stderr)
        return 124


def buscar_problema(problemas, pid):
    return next((p for p in problemas if p["id"] == pid), None)


def cmd_reparar(args):
    sudo = "--sudo" in args
    resto = [a for a in args if a != "--sudo"]
    if len(resto) != 1 or resto[0].startswith("-"):
        print(f"Uso: {PROGRAMA} reparar ID [--sudo]   (los ID salen en: {PROGRAMA} comprobar)", file=sys.stderr)
        return 2
    pid = resto[0]
    area = pid.split(".")[0]
    if area not in ORDEN_AREA:
        print(f"{PROGRAMA}: «{pid}» no es un ID de problema (los ID salen en: {PROGRAMA} comprobar)", file=sys.stderr)
        return 2
    print(f"Comprobando {dict(AREAS)[area]} de nuevo...")
    _, problemas, concluyentes, t, _, ctx = diagnosticar(sudo, {area})
    actual = buscar_problema(problemas, pid)
    if actual is None:
        origen = leer_problemas_historial(archivos_historial()[2]).get(pid, {}).get("comprobacion")
        actualizar_historial(t, problemas, concluyentes)
        sin_hacer = [c for c in ctx.comprobaciones[area] if c["estado"] == "NO_DISPONIBLE"]
        if origen and origen not in concluyentes:
            print(f"El problema {pid} no se ha podido comprobar ahora (prueba con --sudo o desde la sesión "
                  "gráfica). No se hace nada.")
        elif not origen and sin_hacer:
            print(f"{pid}: No se detecta ahora, pero algunas comprobaciones de {dict(AREAS)[area]} no se pudieron "
                  "hacer (prueba con --sudo o desde la sesión gráfica). No se hace nada.")
        else:
            print(f"El problema {pid} ya no se detecta: no se hace nada.")
        return 0
    print()
    print("\n".join(texto_problema(actual, con_reparacion=False)))
    print()
    if not actual.get("reparacion"):
        print("Este problema no tiene reparación automática: sigue los pasos de «Qué hacer».")
        return 1
    # Las ordenes y la copia se muestran y se ejecutan tal cual, sin limpiar (es tu terminal).
    datos = datos_locales()
    rep_real = next(p for p in ctx.problemas if limpiar(p["id"], *datos) == pid)["reparacion"]
    print(f"Reparación: {rep_real['descripcion']}")
    if rep_real["copia"]:
        print(f"Se modifica: {rep_real['copia']} (antes se guarda una copia)")
    print("Órdenes que se van a ejecutar" + (" (con sudo: puede pedir tu contraseña)" if rep_real["root"] else "") + ":")
    for o in rep_real["ordenes"]:
        print(f"  $ {o}")
    if not terminal_interactiva():
        print("Sin terminal interactiva: no se hace nada. Ejecútalo en una terminal: "
              f"{PROGRAMA} reparar {pid}")
        return 1
    try:
        respuesta = input("¿Aplicar la reparación? [s/N] ").strip().lower()
    except EOFError:
        respuesta = ""
    if respuesta not in ("s", "si", "sí", "y", "yes"):
        print("Cancelado: no se ha cambiado nada.")
        return 1
    if rep_real["copia"] and os.path.exists(rep_real["copia"]):
        destino = f"{rep_real['copia']}.antes-de-reparar-{datetime.datetime.now().strftime('%Y%m%d-%H%M%S')}"
        try:
            shutil.copy2(rep_real["copia"], destino)
        except OSError as e:
            print(f"No se pudo hacer la copia ({e.strerror or e}): no se cambia nada.")
            return 1
        print(f"Copia guardada en {destino}")
    fallo = None
    for o in rep_real["ordenes"]:
        print(f"$ {o}")
        codigo = ejecutar_orden(shlex.split(o))
        if codigo != 0:
            fallo = f"«{o}» terminó con código {codigo}"
            break
    print(f"\nComprobando {dict(AREAS)[area]} de nuevo...")
    _, problemas2, concluyentes2, t2, _, _ = diagnosticar(sudo, {area})
    sigue = buscar_problema(problemas2, pid) is not None
    resultado = "fallo" if fallo and sigue else ("sigue" if sigue else "resuelto")
    actualizar_historial(t2, problemas2, concluyentes2,
                         reparado=(pid, {"t": t2, "resultado": resultado, "reparacion": rep_real["id"],
                                         **({"detalle": limpiar(fallo)} if fallo else {})}))
    if resultado == "resuelto":
        print(f"Resuelto: {pid} ya no se detecta." + (f" (Aviso: {fallo}.)" if fallo else ""))
        return 0
    print(f"No resuelto: {pid} se sigue detectando." + (f" {fallo}." if fallo else "")
          + " Revisa los pasos de «Qué hacer».")
    return 1


AYUDA = f"""Uso: jaime0-diagnostico [--pantalla] [--sudo]
       jaime0-diagnostico comprobar [--json] [--sudo]
       jaime0-diagnostico historial [--json] [-n N]
       jaime0-diagnostico reparar ID [--sudo]

Genera un informe de hardware y compatibilidad para adjuntarlo a una incidencia de
{PRODUCTO} en GitHub. No recoge direcciones MAC ni IP, redes Wi-Fi, nombre de usuario ni
de equipo, números de serie ni el contenido de tus archivos.

  (sin opciones)  guarda el informe en ~/jaime0-diagnostico-AAAAMMDD-HHMM.txt
  --pantalla      lo muestra en la terminal en vez de guardarlo
  --sudo          usa "sudo -n" para leer el registro del kernel (no pide contraseña;
                  si sudo la necesita, ejecuta antes "sudo -v")
  -h, --help      muestra esta ayuda

  comprobar       diagnóstico interpretado: hardware, sistema, gráficos, conectividad
                  y energía; cada problema con causas probables y qué hacer
  historial       problemas vistos (primera y última vez, resueltos, reparaciones) y
                  últimas ejecuciones (-n N, 20 por defecto)
  reparar ID      vuelve a comprobar ese problema, enseña las órdenes exactas y, si
                  confirmas en la terminal, aplica su reparación
"""

SUBORDENES = {"comprobar": cmd_comprobar, "historial": cmd_historial, "reparar": cmd_reparar}


def main(argv):
    if argv and argv[0] in SUBORDENES:
        if any(a in ("-h", "--help", "--ayuda") for a in argv[1:]):
            print(AYUDA, end="")
            return 0
        return SUBORDENES[argv[0]](argv[1:])
    opciones = {"pantalla": False, "sudo": False}
    for a in argv:
        if a in ("-h", "--help", "--ayuda"):
            print(AYUDA, end="")
            return 0
        if a == "--pantalla":
            opciones["pantalla"] = True
        elif a == "--sudo":
            opciones["sudo"] = True
        else:
            print(f"{PROGRAMA}: opción desconocida: {a}\n\n{AYUDA}", end="", file=sys.stderr)
            return 2
    if not opciones["pantalla"]:
        print("Recogiendo información del equipo (unos segundos)...", file=sys.stderr)
    informe = generar(opciones)
    if opciones["pantalla"]:
        tty = hasattr(sys.stdout, "isatty") and sys.stdout.isatty() and not os.environ.get("NO_COLOR")
        sys.stdout.write(colorear(informe) if tty else informe)
        return 0
    nombre = f"jaime0-diagnostico-{datetime.datetime.now().strftime('%Y%m%d-%H%M')}.txt"
    destino = os.path.join(os.path.expanduser("~"), nombre)
    try:
        with open(destino, "w", encoding="utf-8") as f:
            f.write(informe)
    except OSError as e:
        print(f"{PROGRAMA}: no se pudo guardar {destino}: {e.strerror}. Usa --pantalla.", file=sys.stderr)
        return 1
    print(f"Informe guardado en {destino}")
    print("Revísalo y adjúntalo a tu incidencia en GitHub (arrastra el archivo al cuadro de texto).")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
