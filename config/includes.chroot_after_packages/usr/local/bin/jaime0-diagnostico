# ---------------------------------------------------------------------------

COMPROBACIONES = (
    ("hardware.sensores", "Sensores de temperatura", c_sensores),
    ("hardware.graficas", "Tarjetas gráficas", c_gpus),
    ("hardware.memoria", "Memoria (cierres por falta de memoria)", c_memoria),
