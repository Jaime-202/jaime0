#!/bin/sh
# Menu de energia con Rofi. Hyprland 0.56 con Lua sale con: hyprctl dispatch 'hl.dsp.exit()'
set -u

OPCION=$(
    {
        printf 'Apagar\0icon\037system-shutdown\n'
        printf 'Reiniciar\0icon\037system-reboot\n'
        printf 'Suspender\0icon\037system-suspend\n'
        printf 'Cerrar sesión\0icon\037system-log-out\n'
    } | rofi -dmenu -i -no-custom -p "Energía" -l 4 -theme-str 'window { width: 360px; }'
)

case "$OPCION" in
    "Apagar")        systemctl poweroff ;;
    "Reiniciar")     systemctl reboot ;;
    "Suspender")     systemctl suspend ;;
    "Cerrar sesión") hyprctl dispatch 'hl.dsp.exit()' ;;
    *)               exit 0 ;;
esac
