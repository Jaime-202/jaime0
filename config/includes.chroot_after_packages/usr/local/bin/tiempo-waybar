#!/bin/sh
# Modulo de tiempo para Waybar: consulta wttr.in, que deduce la ciudad por la IP.
# Nunca se cuelga (limite de 8 s) y, sin red ni datos recientes, devuelve texto vacio
# para que Waybar oculte el modulo.
DIR="${XDG_CACHE_HOME:-$HOME/.cache}"
CACHE="$DIR/tiempo-waybar.json"
FRESCO=1800
UTIL=21600
URL="${TIEMPO_URL:-https://wttr.in/?format=%25x|%25t|%25C&lang=es&m}"

edad() {
    [ -f "$CACHE" ] || { echo 999999; return; }
    echo $(( $(date +%s) - $(date -r "$CACHE" +%s) ))
}

if [ "$(edad)" -lt "$FRESCO" ]; then
    cat "$CACHE"
    exit 0
fi

DATOS=$(curl -fsS --connect-timeout 4 --max-time 8 "$URL" 2>/dev/null | head -c 300)
TEMP=$(printf '%s' "$DATOS" | cut -d'|' -f2 | tr -d '+ C\r\n')
ESTADO=$(printf '%s' "$DATOS" | cut -d'|' -f3 | tr -d '"\\\r\n')

case "$TEMP" in
    -[0-9]*°|[0-9]*°) VALIDO=1 ;;
    *) VALIDO=0 ;;
esac

if [ "$VALIDO" = 0 ]; then
    if [ "$(edad)" -lt "$UTIL" ]; then
        cat "$CACHE"
    else
        printf '{"text":""}\n'
    fi
    exit 0
fi

mkdir -p "$DIR"
printf '{"text":"EXT %s","tooltip":"%s, %s"}\n' "$TEMP" "$ESTADO" "$TEMP" > "$CACHE.tmp"
mv "$CACHE.tmp" "$CACHE"
cat "$CACHE"
