#!/usr/bin/python3 -I
# jaime0-salud: cliente de solo lectura del servicio de salud (jaime0-servicio).
#
#   jaime0-salud [ahora]   resumen legible en espanol
#   jaime0-salud --json    {"instante": ..., "estado": ... o null}
#   jaime0-salud barra     una linea JSON para Waybar (sin red, sin esperar)
#   jaime0-salud incidencias [--json] [-n N]   ultimas incidencias (del servicio o, si esta
#                          parado, de ~/.local/state/jaime0/incidencias.jsonl)
#   jaime0-salud serie RANGO [--json]          serie historica (5m, 1h, 24h o historia):
#                          la pide al servicio por su socket; sin servicio, error claro
#
# No mide nada por su cuenta: lee instante.json y estado.json del directorio de ejecucion
# ($XDG_RUNTIME_DIR/jaime0, o JAIME0_RUNTIME). Si el servicio esta parado, "ahora" y
# "--json" piden una medicion puntual a "jaime0-servicio medir --json".

import argparse
import json
import os
import shutil
import subprocess
import sys
import time

PROGRAMA = "jaime0-salud"
EDAD_MAXIMA = 30        # segundos: datos frescos para el resumen
EDAD_MAXIMA_BARRA = 60  # segundos: estado.json aun vale para la barra

ICONOS_PERFIL = {"balanced": "\U000f0f85", "performance": "\U000f04c5", "power-saver": "\U000f0f86",
                 "focus": "\U000f0ef0", "multimedia": "\U000f075a", "custom": "\U000f0493"}
ICONO_DESCONOCIDO = "\U000f0f85"
ICONO_ALERTA = "\U000f0026"


def directorio_ejecucion():
    d = os.environ.get("JAIME0_RUNTIME")
    if d:
        return d
    base = os.environ.get("XDG_RUNTIME_DIR")
    return os.path.join(base, "jaime0") if base else None


def directorio_estado():
    """JAIME0_ESTADO, o $XDG_STATE_HOME/jaime0, o ~/.local/state/jaime0 (solo lectura)."""
    d = os.environ.get("JAIME0_ESTADO")
    if d:
        return d
    base = os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state")
    return os.path.join(base, "jaime0")


def leer_json(nombre):
    """Documento JSON del directorio de ejecucion, o None si no existe o esta roto."""
    d = directorio_ejecucion()
    if not d:
        return None
    try:
        with open(os.path.join(d, nombre), encoding="utf-8") as f:
            doc = json.load(f)
    except (OSError, ValueError):
        return None
    return doc if isinstance(doc, dict) else None


def edad(doc):
    """Segundos desde el campo "t" del documento (infinito si no lo tiene)."""
    try:
        return time.time() - float(doc["t"])
    except (KeyError, TypeError, ValueError):
        return float("inf")


def fresco(doc, maximo):
    return doc is not None and edad(doc) <= maximo


def medicion_puntual():
    """Ejecuta jaime0-servicio medir --json (junto a este programa o en PATH)."""
    junto = os.path.join(os.path.dirname(os.path.realpath(__file__)), "jaime0-servicio")
    programa = junto if os.path.exists(junto) else shutil.which("jaime0-servicio")
    if not programa:
        return None
    try:
        r = subprocess.run([sys.executable, "-I", programa, "medir", "--json"],
                           capture_output=True, text=True, timeout=15)
        doc = json.loads(r.stdout) if r.returncode == 0 else None
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None
    return doc if isinstance(doc, dict) else None


def obtener():
    """(instante, estado, parado). Falla con (None, None, True) si ni el servicio ni la medicion puntual sirven."""
    instante, estado = leer_json("instante.json"), leer_json("estado.json")
    if fresco(instante, EDAD_MAXIMA):
        return instante, (estado if fresco(estado, EDAD_MAXIMA) else None), False
    return medicion_puntual(), None, True


def duracion(segundos):
    if segundos is None:
        return "N/D"
    d, resto = divmod(int(segundos), 86400)
    h, resto = divmod(resto, 3600)
    m = resto // 60
    partes = ([f"{d} d"] if d else []) + ([f"{h} h"] if h or d else []) + [f"{m} min"]
    return " ".join(partes)


def resumen(instante, estado, parado=False):
    """Texto legible en espanol a partir de los documentos del servicio."""
    nombre_estado = instante.get("estado") or (estado or {}).get("estado") or "N/D"
    L = [f"Jaime0 · SYSTEM {nombre_estado}"]
    if parado:
        L.append("Servicio parado: medición puntual")
    L.append(f"Tiempo encendido: {duracion(instante.get('uptime'))}")
    cpu = instante.get("cpu") or {}
    total = cpu.get("total")
    temp = cpu.get("temp")
    L.append(f"CPU: {'N/D' if total is None else f'{total:.1f} %'}"
             f" · temperatura {'N/D' if temp is None else f'{temp:.0f} °C'}")
    ram = instante.get("ram")
    if ram and ram.get("total"):
        L.append(f"RAM: {ram['usada']} de {ram['total']} MiB ({100 * ram['usada'] / ram['total']:.0f} %)"
                 f" · swap {ram.get('swap', 0)} de {ram.get('swap_total', 0)} MiB")
    else:
        L.append("RAM: N/D")
    for d in instante.get("disco") or []:
        pct = f" ({100 * d['usado'] / d['total']:.0f} %)" if d.get("total") else ""
        L.append(f"Disco {d['punto']}: {d['usado']} de {d['total']} GiB{pct}")
    bat = instante.get("bateria")
    if bat:
        t = f"Batería: {'N/D' if bat.get('nivel') is None else str(bat['nivel']) + ' %'} · {bat.get('estado', 'desconocido')}"
        if bat.get("vatios") is not None:
            t += f" · {bat['vatios']:.1f} W"
        if bat.get("minutos_estimados") is not None:
            t += f" · autonomía {duracion(bat['minutos_estimados'] * 60)} (estimado)"
        L.append(t)
    else:
        L.append("Batería: N/D")
    L.append(f"Perfil: {texto_perfil((estado or {}).get('perfil'))}")
    priv = (estado or {}).get("privacidad")
    L.append(f"Privacidad: {priv['estado'] if priv else 'N/D'}")
    motivos = (estado or {}).get("motivos")
    n = instante.get("alertas", 0) or 0
    L.append(f"Alertas: {n}")
    for m in (motivos or [])[:6]:
        L.append(f"  · [{m['gravedad']}] {m['texto']}")
    return "\n".join(L)


def texto_perfil(perfil):
    """'FOCUS · energía balanced (retenido)' a partir de estado.json -> perfil."""
    perfil = perfil or {}
    nombre = perfil.get("nombre") or (perfil.get("activo") or "").upper() or "desconocido"
    texto = f"{nombre} · energía {perfil.get('energia') or 'N/D'}"
    return texto + (" (retenido)" if perfil.get("retencion") else "")


def perfil_actual_sin_servicio():
    try:
        r = subprocess.run(["powerprofilesctl", "get"], capture_output=True, text=True, timeout=3)
        valor = r.stdout.strip()
        return valor if r.returncode == 0 and valor else None
    except (OSError, subprocess.TimeoutExpired):
        return None


def barra():
    """Diccionario para Waybar: text, class, tooltip."""
    estado = leer_json("estado.json")
    if not fresco(estado, EDAD_MAXIMA_BARRA):
        perfil = perfil_actual_sin_servicio()
        icono = ICONOS_PERFIL.get(perfil, ICONO_DESCONOCIDO)
        return {"text": f"{icono} ", "class": "parado",
                "tooltip": "Servicio de Jaime0 parado" + (f"\nPerfil: {perfil}" if perfil else "")}
    nombre = estado.get("estado") if estado.get("estado") in ("ONLINE", "WARNING", "CRITICAL") else "ONLINE"
    perfil = estado.get("perfil") or {}
    icono = ICONOS_PERFIL.get(perfil.get("activo"), ICONO_DESCONOCIDO)
    alerta = f" {ICONO_ALERTA}" if nombre in ("WARNING", "CRITICAL") else ""
    if alerta and len(estado.get("motivos") or []) > 0:
        alerta += f" {len(estado['motivos'])}"
    lineas = [f"Jaime0 · SYSTEM {nombre}", f"Perfil: {texto_perfil(perfil)}"]
    for m in (estado.get("motivos") or [])[:4]:
        lineas.append(f"· {m.get('texto', '')}")
    lineas.append("Clic: Control Center")
    return {"text": f"{icono}{alerta} ", "class": nombre.lower(), "tooltip": "\n".join(lineas)}


def pedir_socket(peticion, timeout=5.0):
    """Una peticion al socket del servicio; devuelve el dict de la respuesta. Lanza OSError
    si el servicio no esta (o no hay sockets Unix) y ValueError si la respuesta esta rota."""
    import socket
    d = directorio_ejecucion()
    if not d or not hasattr(socket, "AF_UNIX"):
        raise OSError("sin socket del servicio")
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(timeout)
    try:
        s.connect(os.path.join(d, "control.sock"))
        s.sendall((json.dumps(peticion) + "\n").encode("utf-8"))
        buf = bytearray()
        while b"\n" not in buf:
            datos = s.recv(65536)
            if not datos:
                break
            buf.extend(datos)
    finally:
        s.close()
    doc = json.loads(buf.decode("utf-8"))
    if not isinstance(doc, dict):
        raise ValueError("respuesta no válida")
    return doc


def incidencias_de_archivo(n):
    """Las ultimas n incidencias de incidencias.jsonl, las mas recientes primero. Ignora
    las lineas rotas."""
    docs = []
    try:
        with open(os.path.join(directorio_estado(), "incidencias.jsonl"), encoding="utf-8", errors="replace") as f:
            for linea in f:
                try:
                    d = json.loads(linea)
                except ValueError:
                    continue
                if isinstance(d, dict) and "componente" in d:
                    docs.append(d)
    except OSError:
        pass
    return docs[-n:][::-1]


def obtener_incidencias(n):
    """(lista, de_servicio): del servicio si responde; si no, directamente del archivo."""
    try:
        r = pedir_socket({"orden": "incidencias", "limite": n})
        if r.get("ok") and isinstance(r.get("incidencias"), list):
            return r["incidencias"], True
    except (OSError, ValueError):
        pass
    return incidencias_de_archivo(n), False


def texto_incidencias(lista):
    if not lista:
        return "No hay incidencias registradas."
    L = []
    for d in lista:
        try:
            fecha = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(d["t"]))
        except (KeyError, TypeError, ValueError, OverflowError, OSError):
            fecha = "fecha desconocida"
        L.append(f"{fecha}  {d.get('gravedad', '?'):<8}  {d.get('componente', '?')}  {d.get('descripcion', '')}")
        if d.get("recomendacion"):
            L.append(f"    Recomendación: {d['recomendacion']}")
    return "\n".join(L)


ETIQUETAS_SERIE = {"cpu": ("CPU", "%"), "ram": ("RAM usada", "%"), "swap": ("Swap usada", "%"),
                   "presion": ("Presión de memoria", ""), "temp": ("Temperatura CPU", "°C"),
                   "gpu_temp": ("Temperatura GPU", "°C"), "bateria": ("Batería", "%"),
                   "vatios": ("Consumo", "W"), "lectura": ("Lectura de disco", "MB/s"),
                   "escritura": ("Escritura de disco", "MB/s"), "disco": ("Disco usado", "%")}


def texto_serie(s):
    """Resumen legible de una serie: por metrica, minimo, media y maximo del rango."""
    L = [f"Serie {s.get('rango')}: {len(s.get('t', []))} puntos, {s.get('resolucion')} s por punto"]
    for k, (nombre, unidad) in ETIQUETAS_SERIE.items():
        m = (s.get("metricas") or {}).get(k) or {}
        med = [v for v in m.get("med", []) if v is not None]
        if not med:
            L.append(f"  {nombre}: N/D")
            continue
        bajo = min([v for v in m.get("min", []) if v is not None] or med)
        alto = max([v for v in m.get("max", []) if v is not None] or med)
        L.append(f"  {nombre}: mín {bajo:g} · media {sum(med) / len(med):.1f} · máx {alto:g} {unidad}".rstrip())
    L.append(f"Huecos (sin datos): {len(s.get('huecos') or [])}")
    L.append(f"Eventos: {len(s.get('eventos') or [])}")
    return "\n".join(L)


def cmd_incidencias(argv):
    ap = argparse.ArgumentParser(prog=f"{PROGRAMA} incidencias", description="Últimas incidencias del sistema.")
    ap.add_argument("--json", action="store_true", help="imprime la lista en JSON")
    ap.add_argument("-n", type=int, default=20, help="cuántas (por defecto 20, máximo 500)")
    args = ap.parse_args(argv)
    lista, _servicio = obtener_incidencias(max(1, min(args.n, 500)))
    print(json.dumps(lista, ensure_ascii=False) if args.json else texto_incidencias(lista))
    return 0


def cmd_serie(argv):
    ap = argparse.ArgumentParser(prog=f"{PROGRAMA} serie", description="Serie histórica del servicio.")
    ap.add_argument("rango", choices=["5m", "1h", "24h", "historia"])
    ap.add_argument("--json", action="store_true", help="imprime la serie completa en JSON")
    args = ap.parse_args(argv)
    try:
        s = pedir_socket({"orden": "serie", "rango": args.rango})
    except (OSError, ValueError):
        print(f"{PROGRAMA}: el servicio de Jaime0 no está en marcha: no hay series sin él "
              "(systemctl --user status jaime0-servicio).", file=sys.stderr)
        return 1
    if not s.get("ok"):
        print(f"{PROGRAMA}: {s.get('error', 'error desconocido')} para el rango {args.rango}.", file=sys.stderr)
        return 1
    print(json.dumps(s, ensure_ascii=False) if args.json else texto_serie(s))
    return 0


def main(argv=None):
    try:
        sys.stdout.reconfigure(encoding="utf-8")
    except (AttributeError, OSError):
        pass
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv[:1] == ["incidencias"]:
        return cmd_incidencias(argv[1:])
    if argv[:1] == ["serie"]:
        return cmd_serie(argv[1:])
    ap = argparse.ArgumentParser(prog=PROGRAMA, description="Estado de salud del sistema de Jaime0. "
                                 "Otras órdenes: incidencias [--json] [-n N], serie RANGO [--json].")
    ap.add_argument("orden", nargs="?", default="ahora", choices=["ahora", "barra"],
                    help="ahora (resumen, por defecto) o barra (una línea JSON para Waybar)")
    ap.add_argument("--json", action="store_true", help="imprime instante y estado en JSON")
    args = ap.parse_args(argv)
    if args.orden == "barra":
        print(json.dumps(barra(), ensure_ascii=False))
        return 0
    instante, estado, parado = obtener()
    if instante is None:
        print(f"{PROGRAMA}: no hay datos: el servicio está parado y la medición puntual falló.", file=sys.stderr)
        return 1
    if args.json:
        print(json.dumps({"instante": instante, "estado": estado}, ensure_ascii=False))
    else:
        print(resumen(instante, estado, parado))
    return 0


if __name__ == "__main__":
    sys.exit(main())
