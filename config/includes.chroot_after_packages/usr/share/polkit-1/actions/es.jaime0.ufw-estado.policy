<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<!-- Control Center de ZYRON: ver las reglas del cortafuegos. Solo lectura. -->
<policyconfig>
  <vendor>ZYRON</vendor>
  <action id="es.jaime0.ufw-estado">
    <description>Ver las reglas del cortafuegos</description>
    <message>Para ver las reglas del cortafuegos hace falta tu contraseña. Solo se leen; no se cambia nada.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/jaime0-ufw-estado</annotate>
  </action>
</policyconfig>
