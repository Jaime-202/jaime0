# /usr/share/jaime0/ajustes.predeterminados
# Valores predeterminados de los ajustes de Jaime0 y temas de acento. Es un archivo del
# sistema: una ISO nueva lo sustituye. Tus cambios van en ~/.config/jaime0/ajustes, que
# solo guarda lo que cambias y ninguna reinstalacion de la configuracion toca. Usa: jaime0-ajustes

# Colores
acento = verde
fondo = /usr/share/backgrounds/jaime0/jaime0.png

# Ventanas (Hyprland)
separacion_interior = 4
separacion_exterior = 8
borde = 2
esquinas = 8
opacidad_inactiva = 1.0
desenfoque = si
# Animaciones: no = desactivadas; sutil = discretas y rapidas (predeterminado); suave = mas
# fluidas y visibles. (Los antiguos si/no siguen valiendo: si = sutil.)
animaciones = sutil

# Barra (Waybar)
barra_altura = 26
barra_posicion = arriba
# Aplicaciones ancladas en el centro de la barra (hasta 6), por su identificador: el
# nombre de su .desktop sin extension. Se gestionan con jaime0-anclar.
anclas = kitty thunar

# Widgets de escritorio (Quickshell). Cada uno en una posicion o "no": arriba-izquierda,
# arriba-centro, arriba-derecha, centro, abajo-izquierda, abajo-centro, abajo-derecha.
# Vienen apagados: el escritorio empieza vacio y sin ningun proceso de widgets.
widget_reloj = no
widget_musica = no
widget_tiempo = no
widget_sonido = no
widget_sistema = no
widget_calendario = no
widgets_tarjetas = si
reloj_formato = 24h
# Ciudad para el tiempo (Open-Meteo). Solo se envia el nombre que escribas aqui: nunca se
# usa tu IP ni tu ubicacion. Vacia: el widget del tiempo lo pide.
tiempo_ciudad =

# Control Center (jaime0-servicio): umbrales de aviso y critico del estado del sistema y de
# las incidencias. Temperatura de la CPU en °C (aviso 60-100, critico 70-105), disco ocupado
# en % (aviso 50-99, critico 60-100), bateria en % (aviso 5-50, critico 2-30; en la bateria
# el critico es el nivel mas bajo). El aviso debe ser menor que el critico (en la bateria,
# al reves). historial_dias: dias que se conserva el historial de 15 minutos (7-365).
umbral_temp_aviso = 85
umbral_temp_critico = 95
umbral_disco_aviso = 85
umbral_disco_critico = 95
umbral_bateria_aviso = 15
umbral_bateria_critico = 5
historial_dias = 90
# Frecuencia de medicion en segundo plano (5, 10 o 30 s) y con el Control Center abierto (1, 2
# o 5 s). cc_notificar: avisos de incidencias en el escritorio (todas, criticas o ninguna).
# control_atajo: atajo de teclado del Control Center (modificadores SUPER, SHIFT, CTRL, ALT).
cc_intervalo = 10
cc_intervalo_rapido = 2
cc_notificar = criticas
control_atajo = SUPER+I
# Energia: minutos de inactividad hasta bloquear, apagar la pantalla y suspender (0 = nunca;
# bloqueo y pantalla 0-120, suspension 0-240). suspender_con_cargador = no: con el cargador
# conectado no se suspende por inactividad.
inactividad_bloqueo = 10
inactividad_pantalla = 11
inactividad_suspender = 30
suspender_con_cargador = si

# Temas de acento: tema.NOMBRE = #rrggbb. "acento" acepta un nombre o un color #rrggbb.
tema.verde = #54e58a
tema.cian = #55cde0
tema.azul = #6aa6f0
tema.violeta = #b48ef0
tema.ambar = #e0b050
tema.rosa = #e88ab4
