# ZYRON: activacion del nucleo (Plymouth, plugin script).
#
# Sobre negro profundo aparece un marco de esquinas, una linea de escaneo verde recorre la
# zona central, se enciende un halo, se construye el hexagono, la Z se materializa y el
# nucleo cian se activa con una onda. Despues un anillo de segmentos gira despacio, la
# marca ZYRON aparece debajo y el nucleo late mientras una linea fina indica el progreso
# real del arranque. La entrada dura unos 2 s y nunca retrasa el arranque: Plymouth se
# cierra en cuanto el sistema esta listo.
#
# Todo se escala a la pantalla (diseno a 1920x1080) y se dibuja con capas PNG que el hook
# 0310-plymouth genera desde capas/*.svg al compilar. Los mensajes del sistema, la clave
# del disco cifrado y las preguntas se dibujan aqui; Esc sigue mostrando los mensajes de
# arranque (detalles) como en cualquier tema.

Window.SetBackgroundTopColor(0.031, 0.043, 0.051);
Window.SetBackgroundBottomColor(0.031, 0.043, 0.051);

ancho = Window.GetWidth();
alto = Window.GetHeight();
x0 = Window.GetX();
y0 = Window.GetY();
e = Math.Min(ancho / 1920, alto / 1080);
if (e < 0.45) e = 0.45;
cx = x0 + ancho / 2;
cy = y0 + alto * 0.44;

modo = Plymouth.GetMode();
# Al apagar o reiniciar no hay entrada: se ve ya todo activado.
if (modo == "boot" || modo == "resume")
    t = 0;
else
    t = 3;
cuadro = 0;
progreso = 0;

# -- utilidades ----------------------------------------------------------------------
fun escalada(nombre) {
    img = Image(nombre);
    return img.Scale(Math.Int(img.GetWidth() * global.e + 0.5), Math.Int(img.GetHeight() * global.e + 0.5));
}

fun colocar(sprite, img, x, y, z) {
    sprite.SetImage(img);
    sprite.SetX(Math.Int(x - img.GetWidth() / 2));
    sprite.SetY(Math.Int(y - img.GetHeight() / 2));
    sprite.SetZ(z);
}

# 0 antes de a, 1 despues de b, curva suave entre medias.
fun tramo(v, a, b) {
    if (v <= a) return 0;
    if (v >= b) return 1;
    u = (v - a) / (b - a);
    return u * u * (3 - 2 * u);
}

# -- capas -----------------------------------------------------------------------------
img_halo = escalada("halo.png");
img_hex = escalada("hexagono.png");
img_z = escalada("z.png");
img_nucleo = escalada("nucleo.png");
img_onda = Image("onda.png");
img_anillo = escalada("anillo.png");
img_escaneo = escalada("escaneo.png");
img_marca = escalada("marca.png");

halo = Sprite(); colocar(halo, img_halo, cx, cy, 1);
anillo = Sprite(); colocar(anillo, img_anillo, cx, cy, 2);
onda = Sprite(); onda.SetZ(3);
hexagono = Sprite(); colocar(hexagono, img_hex, cx, cy, 4);
zeta = Sprite(); colocar(zeta, img_z, cx, cy, 5);
nucleo = Sprite(); colocar(nucleo, img_nucleo, cx, cy, 6);
escaneo = Sprite(); colocar(escaneo, img_escaneo, cx, cy, 7);
marca = Sprite(); colocar(marca, img_marca, cx, cy + 228 * e, 4);

# Marco de esquinas alrededor de la composicion.
mx = 300 * e;
my = 250 * e;
esquinas[0] = Sprite(); colocar(esquinas[0], escalada("esquina-si.png"), cx - mx, cy - my, 3);
esquinas[1] = Sprite(); colocar(esquinas[1], escalada("esquina-sd.png"), cx + mx, cy - my, 3);
esquinas[2] = Sprite(); colocar(esquinas[2], escalada("esquina-ii.png"), cx - mx, cy + my + 40 * e, 3);
esquinas[3] = Sprite(); colocar(esquinas[3], escalada("esquina-id.png"), cx + mx, cy + my + 40 * e, 3);

# Progreso: linea fina bajo la marca, con una cabeza cian.
largo_barra = Math.Int(280 * e);
alto_barra = Math.Max(2, Math.Int(3 * e));
by = cy + 286 * e;
bx = cx - largo_barra / 2;
barra_fondo = Sprite(Image("barra-fondo.png").Scale(largo_barra, alto_barra));
barra_fondo.SetPosition(bx, by, 4);
img_barra = Image("barra.png");
barra = Sprite();
barra.SetPosition(bx, by, 5);
ancho_barra = -1;
img_cabeza = escalada("cabeza.png");
cabeza = Sprite(img_cabeza);
cabeza.SetZ(6);

for (i = 0; i < 4; i++) esquinas[i].SetOpacity(0);
halo.SetOpacity(0); anillo.SetOpacity(0); onda.SetOpacity(0); hexagono.SetOpacity(0);
zeta.SetOpacity(0); nucleo.SetOpacity(0); escaneo.SetOpacity(0); marca.SetOpacity(0);
barra_fondo.SetOpacity(0); barra.SetOpacity(0); cabeza.SetOpacity(0);

angulo = 0;
img_anillo_girado = img_anillo;

# -- animacion (50 veces por segundo) -------------------------------------------------
fun refrescar() {
    global.cuadro++;
    global.t += 0.02;
    v = global.t;

    # Marco del visor.
    for (i = 0; i < 4; i++) global.esquinas[i].SetOpacity(0.7 * tramo(v, 0.1, 0.6));

    # Escaneo: baja por la zona del simbolo y se apaga.
    if (v < 1.5) {
        p = tramo(v, 0.15, 1.35);
        global.escaneo.SetY(Math.Int(global.cy - 170 * global.e + 340 * global.e * p - global.img_escaneo.GetHeight() / 2));
        global.escaneo.SetOpacity(tramo(v, 0.15, 0.35) * (1 - tramo(v, 1.1, 1.4)));
    } else {
        global.escaneo.SetOpacity(0);
    }

    # Halo: se enciende y luego respira.
    respiro = 0.5 + 0.5 * Math.Sin(v * 1.6);
    global.halo.SetOpacity(tramo(v, 0.3, 1.2) * (0.75 + 0.25 * respiro * tramo(v, 1.6, 2.4)));

    # Hexagono y Z.
    global.hexagono.SetOpacity(tramo(v, 0.45, 1.05));
    global.zeta.SetOpacity(tramo(v, 0.85, 1.3));

    # Nucleo: se enciende a 1.3 s y late.
    global.nucleo.SetOpacity(tramo(v, 1.3, 1.45) * (0.8 + 0.2 * respiro));

    # Onda del nucleo: una al encenderse y despues cada 2.8 s.
    if (v >= 1.3) {
        u = (v - 1.3) - Math.Int((v - 1.3) / 2.8) * 2.8;
        if (u < 1.1 && global.cuadro % 2 == 0) {
            f = u / 1.1;
            lado = Math.Int(global.img_onda.GetWidth() * global.e * (0.3 + 0.95 * f));
            if (lado < 2) lado = 2;
            colocar(global.onda, global.img_onda.Scale(lado, lado), global.cx, global.cy, 3);
            global.onda.SetOpacity(0.75 * (1 - f) * (1 - f));
        } else if (u >= 1.1) {
            global.onda.SetOpacity(0);
        }
    }

    # Anillo de segmentos: aparece y gira despacio (se rota cada 3 cuadros: poca CPU).
    global.anillo.SetOpacity(0.85 * tramo(v, 1.1, 1.9));
    if (v > 1.1 && global.cuadro % 3 == 0) {
        global.angulo += 0.012;
        colocar(global.anillo, global.img_anillo.Rotate(global.angulo), global.cx, global.cy, 2);
    }

    # Marca y progreso.
    global.marca.SetOpacity(tramo(v, 1.5, 2.1));
    if (global.modo == "boot" || global.modo == "resume") {
        visible = tramo(v, 1.7, 2.2);
        global.barra_fondo.SetOpacity(visible);
        lleno = Math.Int(global.largo_barra * Math.Clamp(global.progreso, 0, 1));
        if (lleno != global.ancho_barra && lleno > 0) {
            global.ancho_barra = lleno;
            global.barra.SetImage(global.img_barra.Scale(lleno, global.alto_barra));
        }
        global.barra.SetOpacity(visible);
        global.cabeza.SetX(Math.Int(global.bx + Math.Max(lleno, 0) - global.img_cabeza.GetWidth() / 2));
        global.cabeza.SetY(Math.Int(global.by + global.alto_barra / 2 - global.img_cabeza.GetHeight() / 2));
        global.cabeza.SetOpacity(visible * (0.6 + 0.4 * respiro));
    }
}
Plymouth.SetRefreshFunction(refrescar);

fun al_progresar(duracion, avance) {
    global.progreso = avance;
}
Plymouth.SetBootProgressFunction(al_progresar);

# -- mensajes del sistema --------------------------------------------------------------
mensaje = Sprite();
mensaje.SetZ(10);
fun al_mensaje(texto) {
    img = Image.Text(texto, 0.53, 0.59, 0.63, 1);
    global.mensaje.SetImage(img);
    global.mensaje.SetX(Math.Int(global.cx - img.GetWidth() / 2));
    global.mensaje.SetY(Math.Int(global.y0 + global.alto * 0.93));
    global.mensaje.SetOpacity(1);
}
Plymouth.SetMessageFunction(al_mensaje);

# -- clave del disco cifrado y preguntas -----------------------------------------------
img_caja = escalada("caja.png");
caja = Sprite(img_caja);
caja.SetZ(20);
caja_y = by + 70 * e;
caja.SetX(Math.Int(cx - img_caja.GetWidth() / 2));
caja.SetY(Math.Int(caja_y));
pregunta = Sprite(); pregunta.SetZ(21);
contenido = Sprite(); contenido.SetZ(21);
caja.SetOpacity(0); pregunta.SetOpacity(0); contenido.SetOpacity(0);

fun mostrar_dialogo(texto_pregunta, texto_contenido) {
    ip = Image.Text(texto_pregunta, 0.85, 0.89, 0.91, 1);
    global.pregunta.SetImage(ip);
    global.pregunta.SetX(Math.Int(global.cx - ip.GetWidth() / 2));
    global.pregunta.SetY(Math.Int(global.caja_y - ip.GetHeight() - 10 * global.e));
    ic = Image.Text(texto_contenido, 0.33, 0.90, 0.54, 1);
    global.contenido.SetImage(ic);
    global.contenido.SetX(Math.Int(global.cx - ic.GetWidth() / 2));
    global.contenido.SetY(Math.Int(global.caja_y + global.img_caja.GetHeight() / 2 - ic.GetHeight() / 2));
    global.caja.SetOpacity(1);
    global.pregunta.SetOpacity(1);
    global.contenido.SetOpacity(1);
}

fun al_pedir_clave(texto, puntos) {
    marcas = "";
    for (i = 0; i < puntos && i < 32; i++) marcas = marcas + "●";
    if (texto == "") texto = "Clave";
    mostrar_dialogo(texto, marcas + " ");
}
Plymouth.SetDisplayPasswordFunction(al_pedir_clave);

fun al_preguntar(texto, respuesta) {
    mostrar_dialogo(texto, respuesta + " ");
}
Plymouth.SetDisplayQuestionFunction(al_preguntar);

fun al_volver() {
    global.caja.SetOpacity(0);
    global.pregunta.SetOpacity(0);
    global.contenido.SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(al_volver);
