#!/bin/sh
set -e

lb config noauto \
  --mode debian \
  --distribution forky \
  --architectures amd64 \
  --archive-areas "main contrib non-free non-free-firmware" \
  --mirror-bootstrap "https://deb.debian.org/debian/" \
  --mirror-binary "https://deb.debian.org/debian/" \
  --security false \
  --updates false \
  --apt-source-archives false \
  --debootstrap-options "--variant=minbase" \
  --apt-recommends false \
  --firmware-chroot false \
  --binary-images iso-hybrid \
  --bootloaders "grub-pc,grub-efi" \
  --chroot-squashfs-compression-type zstd \
  --debian-installer none \
  --memtest none \
  --image-name "zyron" \
  --iso-volume "ZYRON" \
  --iso-application "ZYRON" \
  --iso-publisher "ZYRON" \
  --bootappend-live "boot=live components hostname=zyron locales=es_ES.UTF-8 keyboard-layouts=es timezone=Europe/Madrid quiet splash loglevel=3 rd.udev.log_level=3 systemd.show_status=false vt.global_cursor_default=0 vt.default_red=0x08,0xd9,0x54,0xd9,0x6a,0xa6,0x55,0xa7,0x71,0xe8,0x86,0xe8,0x8f,0xc2,0x8a,0xee vt.default_grn=0x0b,0x62,0xe5,0xa5,0x9f,0x8a,0xcd,0xb4,0x81,0x90,0xef,0xc2,0xb9,0xaa,0xdc,0xf4 vt.default_blu=0x0d,0x5b,0x8a,0x4a,0xbf,0xb5,0xe0,0xbc,0x8c,0x8a,0xab,0x7a,0xd2,0xcd,0xea,0xf7" \
  --bootappend-live-failsafe "boot=live components hostname=zyron locales=es_ES.UTF-8 keyboard-layouts=es timezone=Europe/Madrid nomodeset" \
  "${@}"
